---
import '../styles/global.css';
import Toc from '../components/Toc.astro';
interface Props { title: string; description?: string; course?: { code: string; href: string }; toc?: boolean; }
const { title, description = "Ma'am Audrey's lessons for self-study: plain-English explanations with pictures you can play with.", course: given, toc = false } = Astro.props;
// From a lesson page, the course links end in #l-<lesson>, so the course page opens at the lesson the student just left.
const slug = Astro.url.pathname.split('/').filter(Boolean).pop();
const course = given && slug && !given.href.replace(/\/$/, '').endsWith('/' + slug) ? { ...given, href: given.href + '#l-' + slug } : given;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={`${base}/favicon.svg?v=7`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon-32.png?v=7`} type="image/png" sizes="32x32" />
  <link rel="icon" href={`${base}/favicon-192.png?v=7`} type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png?v=7`} />
  <meta name="theme-color" content="#f7f6ef" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=IBM+Plex+Mono:wght@500;600&family=Kalam:wght@400;700&family=Nunito:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&display=swap" />
</head>
<body>
  <header class="wrap wrap-wide topbar">
    <a class="brand" href={`${base}/`}>ma'am audrey's <span>lessons</span></a>
    <nav class="topnav" aria-label="Main">
      <a href={`${base}/`}>All courses</a>
      {course && <a href={course.href}>{course.code} lessons</a>}
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer class="wrap foot">
    <p>Prepared by Audrey Carmel Jay J. Nanual, Instructor, BSIT program, Davao Oriental State University.</p>
    <p>For self-study. The practice questions here are not graded: use them to check yourself, as many times as you want.</p>
  </footer>
  {toc && <Toc course={course} lesson={title.split(' · ')[0]} />}
  <script>
    import { growOnly } from '../lib/stable.js';
    document.querySelectorAll<HTMLElement>('[data-grow]').forEach(growOnly);
    // QA #148: step labs' color keys start folded on phones (the lab hint already names the colors).
    if (matchMedia('(max-width: 43.99rem)').matches) document.querySelectorAll<HTMLDetailsElement>('details.lab-key').forEach((d) => { d.open = false; });

    // Copy button on every code block (Oct 28). Copies the code only: no line numbers, one line per line.
    const codeText = (pre: HTMLElement) => {
      const code = pre.querySelector<HTMLElement>('code') || pre;
      const strip = (el: Element) => { const c = el.cloneNode(true) as HTMLElement; c.querySelectorAll('.ln, .code-bar').forEach((e) => e.remove()); return c.textContent || ''; };
      const lines = code.querySelectorAll('.cw-l');
      return (lines.length ? [...lines].map(strip).join('\n') : strip(code)).replace(/\s+$/, '') + '\n';
    };
    const copyText = async (text: string) => {
      try { await navigator.clipboard.writeText(text); return true; } catch {
        const t = document.createElement('textarea'); t.value = text; t.setAttribute('readonly', ''); t.style.position = 'fixed'; t.style.opacity = '0';
        document.body.appendChild(t); t.select(); let ok = false; try { ok = document.execCommand('copy'); } catch {} t.remove(); return ok;
      }
    };
    document.querySelectorAll<HTMLElement>('pre.code').forEach((pre) => {
      if (pre.classList.contains('cw-full') || pre.querySelector('.code-bar')) return;
      const bar = document.createElement('div'); bar.className = 'code-bar';
      const btn = document.createElement('button'); btn.type = 'button'; btn.className = 'code-copy'; btn.textContent = 'Copy'; btn.setAttribute('aria-label', 'Copy this code');
      bar.appendChild(btn); pre.prepend(bar);
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const ok = await copyText(codeText(pre));
        btn.textContent = ok ? 'Copied!' : 'Select and copy'; btn.classList.toggle('is-done', ok);
        setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('is-done'); }, 1600);
      });
    });

    // Chat 34: long code in coding-task boxes (#task) starts folded: a max height, the rest fades out, Show all / Show less.
    // Copy still copies everything (codeText reads the whole text, folded or not). Code inside a closed answer is folded when it opens.
    const foldCode = (pre: HTMLElement) => {
      if (pre.dataset.fold || !pre.offsetHeight) return;
      const max = parseFloat(getComputedStyle(document.documentElement).fontSize) * 20;
      if (pre.scrollHeight < max + 96) return; // short code: leave it open
      pre.dataset.fold = '1'; pre.classList.add('is-folded');
      const lines = (codeText(pre).match(/\n/g) || []).length;
      const more = document.createElement('button'); more.type = 'button'; more.className = 'btn code-more';
      const label = () => { const f = pre.classList.contains('is-folded'); more.textContent = f ? 'Show all ' + lines + ' lines ▾' : 'Show less ▴'; more.setAttribute('aria-expanded', String(!f)); };
      label(); pre.after(more);
      more.addEventListener('click', () => {
        const folding = !pre.classList.contains('is-folded');
        pre.classList.toggle('is-folded', folding); label();
        if (folding && pre.getBoundingClientRect().top < 0) pre.scrollIntoView({ block: 'start' });
      });
    };
    document.querySelectorAll<HTMLElement>('#task pre.code').forEach(foldCode);
    document.querySelectorAll<HTMLDetailsElement>('#task details').forEach((d) => d.addEventListener('toggle', () => { if (d.open) d.querySelectorAll<HTMLElement>('pre.code').forEach(foldCode); }));

    // QA #149 (chat 33): on phones, a still picture shrunk to tiny text gets "Tap to enlarge" and opens full screen (scrolls sideways).
    // Only still pictures: labs and walkthroughs are figures WITH an id, so they are skipped.
    if (matchMedia('(max-width: 40rem)').matches) {
      const zoom = document.createElement('div');
      zoom.className = 'fig-zoom'; zoom.hidden = true;
      zoom.innerHTML = '<button type="button" class="btn fig-zoom-x">Close ✕</button><div class="fig-zoom-in"></div>';
      document.body.appendChild(zoom);
      const inner = zoom.querySelector<HTMLElement>('.fig-zoom-in')!;
      const shut = () => { zoom.hidden = true; inner.innerHTML = ''; document.documentElement.classList.remove('zoom-open'); };
      zoom.querySelector('.fig-zoom-x')!.addEventListener('click', shut);
      document.querySelectorAll<HTMLElement>('figure.fig:not([id])').forEach((fig) => {
        if (fig.parentElement?.closest('figure') || fig.querySelector('button, input')) return;
        const svg = fig.querySelector<SVGSVGElement>('svg');
        const vb = svg?.viewBox?.baseVal;
        if (!svg || !vb || !vb.width) return;
        if (svg.getBoundingClientRect().width / vb.width > 0.75) return;   // already big enough
        fig.classList.add('can-zoom');
        fig.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a, .peek-btn')) return;
          const copy = svg.cloneNode(true) as SVGSVGElement;
          copy.removeAttribute('width'); copy.removeAttribute('height');
          copy.style.width = Math.max(vb.width, innerWidth) + 'px'; copy.style.maxWidth = 'none'; copy.style.height = 'auto';
          inner.innerHTML = ''; inner.appendChild(copy);
          zoom.hidden = false; document.documentElement.classList.add('zoom-open'); inner.scrollLeft = 0;
        });
      });
    }
  </script>
  <button type="button" class="to-top" id="to-top" aria-label="Back to the top" title="Back to the top">↑</button>
  <script is:inline>
    (function () {
      var b = document.getElementById('to-top'), t = false;
      function f() { t = false; b.classList.toggle('show', scrollY > innerHeight * 0.8); }
      addEventListener('scroll', function () { if (!t) { t = true; requestAnimationFrame(f); } }, { passive: true });
      b.addEventListener('click', function () { scrollTo({ top: 0, behavior: 'smooth' }); });
      f();
    })();
  </script>
</body>
</html>

import Base from '../../layouts/Base.astro';
import SQLab from '../../components/SQLab.astro';
import Quiz from '../../components/Quiz.astro';
import { course } from '../../data/itc120.js';
import { hi, hiN } from '../../lib/code.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stackFields = String.raw`class ArrayStack {
  int[] data;    // cells that hold the stack items
  int top;       // index of the top item; -1 means empty

  ArrayStack(int capacity) {
    data = new int[capacity];
    top = -1;
  }
  boolean isEmpty() {
    return top == -1;
  }
  boolean isFull() {
    return top == data.length - 1;
  }
  int size() {
    return top + 1;
  }
  // ... push, pop, and peek below
}`;
const stackOps = String.raw`void push(int value) {
  if (isFull()) {
    throw new IllegalStateException("Stack overflow: full.");
  }
  top++;                 // 1. move top up one cell
  data[top] = value;     // 2. store the value there
}

int pop() {
  if (isEmpty()) {
    throw new IllegalStateException("Stack underflow: empty.");
  }
  int value = data[top]; // 1. save the top value
  top--;                 // 2. move top down one cell
  return value;
}

int peek() {
  if (isEmpty()) {
    throw new IllegalStateException("Stack underflow: empty.");
  }
  return data[top];      // look only; top does not change
}`;
const queueFields = String.raw`class LinkedQueue {
  Node front;    // first node (leaves next); null means empty
  Node rear;     // last node (joined last); null means empty
  int count;     // number of items

  boolean isEmpty() {
    return front == null;
  }
  int size() {
    return count;
  }
  // ... enqueue, dequeue, and peek below
}`;
const queueOps = String.raw`void enqueue(int value) {
  Node newNode = new Node(value);
  if (isEmpty()) {
    front = newNode;       // the only node is both
    rear = newNode;        // the front and the rear
  } else {
    rear.next = newNode;   // 1. old rear refers to new node
    rear = newNode;        // 2. rear refers to the new node
  }
  count++;
}

int dequeue() {
  if (isEmpty()) {
    throw new IllegalStateException("Queue underflow: empty.");
  }
  int value = front.data;  // 1. save the front value
  front = front.next;      // 2. front moves to the next node
  if (front == null) {     // 3. the queue became empty,
    rear = null;           //    so rear must be cleared too
  }
  count--;
  return value;
}

int peek() {
  if (isEmpty()) {
    throw new IllegalStateException("Queue underflow: empty.");
  }
  return front.data;
}`;
const s1 = String.raw`ArrayStack s = new ArrayStack(3);
s.push(4);
s.push(9);
System.out.println(s.pop());
s.push(2);
System.out.println(s.peek());
System.out.println(s.size());
System.out.println(s.isFull());`;
const q1 = String.raw`LinkedQueue q = new LinkedQueue();
q.enqueue(3);
q.enqueue(5);
q.enqueue(8);
System.out.println(q.dequeue());
System.out.println(q.peek());
q.enqueue(1);
System.out.println(q.size());`;
const r1 = String.raw`Node current = head;
int count = 0;
while (current != null) {
  if (current.data > 3) {
    count++;
  }
  current = current.next;
}
System.out.println(count);`;

const quiz = [
  { q: 'A stack follows which rule?', opts: ['First in, first out', 'Last in, first out', 'Smallest first', 'Random order'], a: 1, why: 'A <b>stack</b> is LIFO: the item added most recently is removed first, like the top tray of a pile.' },
  { q: 'Push 1, push 2, push 3, then pop. What is returned?', opts: ['1', '2', '3', 'nothing'], a: 2, why: '3 was pushed last, so it is on top. <code>pop()</code> removes and returns <b>3</b>.' },
  { q: 'Enqueue 1, enqueue 2, enqueue 3, then dequeue. What is returned?', opts: ['1', '2', '3', 'nothing'], a: 0, why: '1 joined first, so it is at the front. <code>dequeue()</code> removes and returns <b>1</b>.' },
  { q: 'What is the difference between <code>pop()</code> and <code>peek()</code>?', opts: ['pop removes the top item; peek only looks at it', 'peek removes it; pop only looks', 'They are the same', 'peek works on queues only'], a: 0, why: 'Both return the top item, but only <code>pop()</code> moves <code>top</code> down (<code>top--;</code>). <code>peek()</code> leaves the stack unchanged.' },
  { q: 'In <code>ArrayStack</code>, a new stack has <code>top = -1</code>. What does <code>size()</code> return?', opts: ['-1', '0', '1', 'the capacity'], a: 1, why: '<code>size()</code> returns <code>top + 1</code>, which is <b>0</b>. The -1 is only an index meaning "no top item yet."' },
  { q: 'Why does <code>dequeue()</code> set <code>rear = null</code> when <code>front</code> becomes null?', opts: ['To save memory', 'So front and rear agree that the queue is empty', 'Java requires it', 'To move rear forward'], a: 1, why: 'Otherwise <code>rear</code> would still refer to the removed node, while <code>front</code> says the queue is empty. The next enqueue would go wrong.' },
  { q: 'Students waiting at the registrar\'s window, served in the order they arrived. Which structure fits?', opts: ['Stack', 'Queue', 'Array', 'Tree'], a: 1, why: 'First come, first served: a <b>queue</b>.' },
];
---
<Base title="Stacks and queues · ITC 120" description="Stacks (LIFO) and queues (FIFO) in plain English: traces, real-life uses, and Java code using an array and a linked list." course={{ code: course.code, href: base + course.href }} toc>
  <header class="wrap lesson-hero flow">
    <p class="crumbs"><a href={base + course.href}>ITC 120</a> › Prelim › Stacks and queues</p>
    <p class="kicker">Linear data structures · Lesson 3 of 3</p>
    <h1>Stacks and queues</h1>
    <p class="lede">Two rules about which item leaves next: the newest first, or the oldest first.</p>
    <div class="goals">
      <p class="note-label">In this lesson, you will:</p>
      <ol>
        <li>trace stacks (last in, first out) and queues (first in, first out), and name uses for each;</li>
        <li>explain what <code>push</code>, <code>pop</code>, <code>peek</code>, <code>enqueue</code>, and <code>dequeue</code> change in Java;</li>
        <li>choose an array, linked list, stack, or queue for a situation, and give a reason.</li>
      </ol>
    </div>
    <p class="muted small"><b>You need:</b> the <a href={base + '/itc120/arrays/'}>Arrays</a> and <a href={base + '/itc120/linked-lists/'}>Linked lists</a> lessons.</p>
  </header>

  <section class="chapter wrap" id="rules">
    <div class="chapter-head">
      <p class="chapter-num">Part 1 · The big idea</p>
      <h2>Two rules</h2>
    </div>
    <div class="flow">
      <p>A stack and a queue are not new ways of storing data. Each is a <b>rule</b> placed on storage, about which item leaves next:</p>
      <div class="ds-grid">
        <div class="ds-card"><p class="ds-k">Stack · LIFO</p>
          <div class="mini-stack"><span>C ← top</span><span>B</span><span>A</span></div>
          <p><b>Last in, first out.</b> Items enter and leave at one end, the <b>top</b>. <b>Like a pile of lunch trays</b> at the canteen: the last tray put on the pile is the first one taken.</p></div>
        <div class="ds-card"><p class="ds-k">Queue · FIFO</p>
          <div class="mini-q"><span>front</span><b>A</b><b>B</b><b>C</b><span>rear</span></div>
          <p><b>First in, first out.</b> Items join at the <b>rear</b> and leave from the <b>front</b>. <b>Like passengers at a pedicab terminal</b>: whoever came first rides first.</p></div>
      </div>
      <p>Each one has a few operations. The names are conventions: they are ordinary method names a programmer writes, not Java keywords.</p>
      <div class="scroll-x">
        <table class="tbl">
          <thead><tr><th></th><th>Stack</th><th>Queue</th></tr></thead>
          <tbody>
            <tr><td><b>Add</b></td><td><code>push(x)</code>: put x on top</td><td><code>enqueue(x)</code>: x joins at the rear</td></tr>
            <tr><td><b>Remove</b></td><td><code>pop()</code>: remove and return the top</td><td><code>dequeue()</code>: remove and return the front</td></tr>
            <tr><td><b>Look only</b></td><td><code>peek()</code>: return the top, keep it</td><td><code>peek()</code>: return the front, keep it</td></tr>
          </tbody>
        </table>
      </div>
      <div class="def">
        <p class="note-label">Underflow and overflow</p>
        <p><b>Underflow</b>: removing or peeking when the structure is empty. <b>Overflow</b>: adding to a fixed-size structure that is already full.</p>
      </div>
    </div>
  </section>

  <section class="chapter wrap" id="lab">
    <div class="chapter-head">
      <p class="chapter-num">Part 2 · Try it</p>
      <h2>Stack and queue lab</h2>
    </div>
    <div class="flow">
      <p>Push and enqueue a few values, then remove them. Which value comes out first from each? Then tap <b>Same inputs, both structures</b>.</p>
      <SQLab id="lab-sq" />
    </div>
  </section>

  <section class="chapter wrap" id="stack">
    <div class="chapter-head">
      <p class="chapter-num">Part 3 · Stacks</p>
      <h2>Stacks: newest first</h2>
    </div>
    <div class="flow">
      <div class="sub">
        <h3>Where you see LIFO</h3>
        <p>Here are some places where the newest item should come out first:</p>
        <table class="tbl">
          <thead><tr><th>Use</th><th>How LIFO fits</th></tr></thead>
          <tbody>
            <tr><td>Undo</td><td>Each change could be pushed. Undo pops the most recent change first.</td></tr>
            <tr><td>The Back button</td><td>Each page you visit could be pushed. Back pops the most recent page.</td></tr>
            <tr><td>Reversing a word</td><td>Push the letters, then pop them all: they come out in reverse.</td></tr>
            <tr><td>Method calls in Java</td><td>Java keeps a stack of calls. A call is pushed when a method starts and popped when it finishes. (You saw this in recursion.)</td></tr>
          </tbody>
        </table>
        <p class="small muted">Undo and Back are illustrations of the rule, not a description of how any particular app is programmed.</p>
      </div>
      <div class="sub">
        <h3>A trace</h3>
        <p>The stack starts empty. Each row acts on the result of the row before it:</p>
        <div class="scroll-x">
          <table class="tbl">
            <thead><tr><th>Operation</th><th>Stack after (bottom → top)</th><th>Returned</th><th>size</th></tr></thead>
            <tbody>
              <tr><td><code>push(10)</code></td><td>10</td><td>—</td><td>1</td></tr>
              <tr><td><code>push(20)</code></td><td>10, 20</td><td>—</td><td>2</td></tr>
              <tr><td><code>peek()</code></td><td>10, 20</td><td><b>20</b></td><td>2</td></tr>
              <tr><td><code>push(30)</code></td><td>10, 20, 30</td><td>—</td><td>3</td></tr>
              <tr><td><code>pop()</code></td><td>10, 20</td><td><b>30</b></td><td>2</td></tr>
              <tr><td><code>pop()</code></td><td>10</td><td><b>20</b></td><td>1</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="sub">
        <h3>A stack in Java, using an array</h3>
        <p>The array <code>data</code> holds the items, and <code>top</code> is the <b>index</b> of the top item. A new stack starts with <code>top = -1</code>, meaning "no top item yet." The -1 is only an index; it is never returned as data.</p>
        <pre class="code"><code set:html={hiN(stackFields)} /></pre>
        <p>From the meaning of <code>top</code>: the stack is empty when <code>top == -1</code>, full when <code>top</code> is the last index, and its size is <code>top + 1</code>.</p>
        <pre class="code"><code set:html={hiN(stackOps)} /></pre>
        <table class="tbl">
          <thead><tr><th>Method</th><th>What it changes</th></tr></thead>
          <tbody>
            <tr><td><code>push</code></td><td>Moves <code>top</code> up one cell, then stores the value there.</td></tr>
            <tr><td><code>pop</code></td><td>Saves the value at <code>top</code>, moves <code>top</code> down, returns the saved value.</td></tr>
            <tr><td><code>peek</code></td><td>Nothing. It returns <code>data[top]</code> and leaves <code>top</code> alone.</td></tr>
          </tbody>
        </table>
        <p>After <code>pop()</code>, the old value stays in its cell, but it is above <code>top</code>, so it is not part of the stack. The next <code>push</code> writes over it. (Just like the old copy beyond <code>size</code> in the Arrays lesson.)</p>
      </div>
      <div class="plain">
        <p class="note-label">Why throw an exception?</p>
        <p>Instead of returning a fake value like -1 (which could be real data), each guard uses <code>throw</code> to stop the method with an <b>IllegalStateException</b>: Java's standard exception for "you asked at the wrong time." The <code>!</code> operator means "not," so <code>!isEmpty()</code> reads "the stack is not empty." Rule: check <code>isEmpty()</code> before removing or peeking, and <code>isFull()</code> before adding to a fixed-size array.</p>
      </div>
      <p class="small muted">A stack can also be built from a linked list whose first node is the top: <code>push</code> is "insert at the beginning," and <code>pop</code> is "delete the first node," exactly as in the Linked lists lesson.</p>
    </div>
  </section>

  <section class="chapter wrap" id="queue">
    <div class="chapter-head">
      <p class="chapter-num">Part 4 · Queues</p>
      <h2>Queues: oldest first</h2>
    </div>
    <div class="flow">
      <div class="sub">
        <h3>Where you see FIFO</h3>
        <p>Queues fit any waiting line served in arrival order:</p>
        <ul>
          <li>print jobs sent to one shared printer;</li>
          <li>students at the registrar's window;</li>
          <li>passengers at a pedicab terminal.</li>
        </ul>
      </div>
      <div class="sub">
        <h3>A trace</h3>
        <div class="scroll-x">
          <table class="tbl">
            <thead><tr><th>Operation</th><th>Queue after (front → rear)</th><th>Returned</th><th>size</th></tr></thead>
            <tbody>
              <tr><td><code>enqueue(10)</code></td><td>10</td><td>—</td><td>1</td></tr>
              <tr><td><code>enqueue(20)</code></td><td>10, 20</td><td>—</td><td>2</td></tr>
              <tr><td><code>enqueue(30)</code></td><td>10, 20, 30</td><td>—</td><td>3</td></tr>
              <tr><td><code>dequeue()</code></td><td>20, 30</td><td><b>10</b></td><td>2</td></tr>
              <tr><td><code>peek()</code></td><td>20, 30</td><td><b>20</b></td><td>2</td></tr>
              <tr><td><code>enqueue(40)</code></td><td>20, 30, 40</td><td>—</td><td>3</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="sub">
        <h3>A queue in Java, using a linked list</h3>
        <p>A linked list can insert and delete anywhere. A queue narrows that down to two places: <code>front</code> is the node that leaves next, and <code>rear</code> is where new nodes attach. It uses the same <code>Node</code> class as the Linked lists lesson.</p>
        <pre class="code"><code set:html={hiN(queueFields)} /></pre>
        <p>The fields have no starting values in the code, so Java gives them defaults: <code>null</code> for references and <code>0</code> for <code>int</code>. A new queue starts with <code>front == null</code>, <code>rear == null</code>, and <code>count == 0</code>.</p>
        <pre class="code"><code set:html={hiN(queueOps)} /></pre>
        <table class="tbl">
          <thead><tr><th>Method</th><th>Which linked-list operation it is</th></tr></thead>
          <tbody>
            <tr><td><code>enqueue</code></td><td>Insert at the end: the old rear points to the new node, then <code>rear</code> moves to it.</td></tr>
            <tr><td><code>dequeue</code></td><td>Delete the first node: save <code>front.data</code>, then move <code>front</code> forward.</td></tr>
            <tr><td><code>peek</code></td><td>Only reads <code>front.data</code>.</td></tr>
          </tbody>
        </table>
      </div>
      <div class="trap">
        <p class="note-label">Do not forget lines 19–21</p>
        <p>When the last node leaves, <code>front</code> becomes <code>null</code>, but <code>rear</code> would still refer to the removed node. The two would disagree about whether the queue is empty, so <code>dequeue</code> clears <code>rear</code> too.</p>
      </div>
      <p class="small muted">A queue can also be stored in an array that wraps around to reuse freed cells (a circular array, using the <code>%</code> operator). That version is in the Java Implementation Companion.</p>
    </div>
  </section>

  <section class="chapter wrap" id="together">
    <div class="chapter-head">
      <p class="chapter-num">Part 5 · Bringing it together</p>
      <h2>Choosing a structure</h2>
    </div>
    <div class="flow">
      <div class="sub">
        <h3>Stacks vs. queues</h3>
        <p>The same inputs leave in opposite orders. Add 1, 2, 3, then remove all three: a stack gives 3, 2, 1; a queue gives 1, 2, 3.</p>
        <div class="scroll-x">
          <table class="tbl">
            <thead><tr><th></th><th>Stack</th><th>Queue</th></tr></thead>
            <tbody>
              <tr><td><b>Rule</b></td><td>LIFO: last in, first out</td><td>FIFO: first in, first out</td></tr>
              <tr><td><b>Add / remove</b></td><td>push and pop at the top (same end)</td><td>enqueue at the rear, dequeue at the front</td></tr>
              <tr><td><b>Look only</b></td><td>peek at the top</td><td>peek at the front</td></tr>
              <tr><td><b>Fits tasks like</b></td><td>undo, going back, reversing</td><td>serving in arrival order</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="sub">
        <h3>Arrays vs. linked lists</h3>
        <div class="scroll-x">
          <table class="tbl">
            <thead><tr><th>Task</th><th>Array</th><th>Singly linked list</th></tr></thead>
            <tbody>
              <tr><td>Reach the value at position k</td><td>one step, by index</td><td>follow k links from head</td></tr>
              <tr><td>Insert or delete near the front</td><td>shift the later values</td><td>change one or two links</td></tr>
              <tr><td>Insert after a node you already have</td><td>shift the later values</td><td>change two links</td></tr>
              <tr><td>Delete the last value</td><td>just reduce the size</td><td>walk to the node before it</td></tr>
              <tr><td>Memory per item</td><td>the value (plus unused cells)</td><td>the value plus a reference</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="remember">
        <p class="note-label">Rule vs. storage</p>
        <p><b>LIFO and FIFO describe behavior</b>: which item leaves next. <b>An array or a linked list is storage</b>: where the items are kept. Any rule can use either storage. This lesson showed an array-based stack and a linked queue, but a linked stack and an array queue work too.</p>
      </div>
    </div>
  </section>

  <section class="chapter wrap" id="practice">
    <div class="chapter-head">
      <p class="chapter-num">Part 6 · Your turn</p>
      <h2>Practice on paper</h2>
    </div>
    <div class="flow">
      <div class="paper flow">
        <p class="note-label">Trace the code</p>
        <ol>
          <li>Write exactly what this prints.<pre class="code"><code set:html={hi(s1)} /></pre></li>
          <li>In your own words, what is the difference between <code>pop()</code> and <code>peek()</code>? Which line of code shows it?</li>
          <li>Write exactly what this prints.<pre class="code"><code set:html={hi(q1)} /></pre></li>
          <li>A <code>LinkedQueue</code> holds one node. After <code>dequeue()</code>, what are <code>front</code> and <code>rear</code>, and why must both change?</li>
        </ol>
        <details class="reveal"><summary>Show the answers</summary><div class="flow">
          <ol>
            <li><code>9</code>, <code>2</code>, <code>2</code>, <code>false</code> (one per line). <code>pop()</code> removes 9. After <code>push(2)</code> the stack is 4, 2, so <code>peek()</code> shows 2 and <code>size()</code> is 2. With capacity 3, it is not full.</li>
            <li><code>pop()</code> removes the top item and returns it; <code>peek()</code> returns it and leaves the stack unchanged. The line <code>top--;</code> in <code>pop()</code> is the difference.</li>
            <li><code>3</code>, <code>5</code>, <code>3</code>. <code>dequeue()</code> removes 3; <code>peek()</code> shows 5; after <code>enqueue(1)</code> the queue is 5, 8, 1, so <code>size()</code> is 3.</li>
            <li>Both become <code>null</code>. The queue is empty, so there is no front or rear. If <code>rear</code> still referred to the removed node, front and rear would disagree.</li>
          </ol>
        </div></details>
      </div>
      <div class="paper flow">
        <p class="note-label">Readiness check (all prelim topics)</p>
        <ol>
          <li>The list is head → 4 → 9 → 2 → 7 → null. What does this print?<pre class="code"><code set:html={hi(r1)} /></pre></li>
          <li>Starting empty: add 1, add 2, remove, add 3, add 4, remove, remove. Which values are removed, in order, (a) if it is a stack, (b) if it is a queue? (Check it with the lab's "Same inputs" button.)</li>
          <li>Choose a stack, queue, array, or linked list, and give a reason: (a) passengers riding in the order they arrived; (b) undoing the most recent drawing stroke first; (c) looking up the score in seat 25 many times a day, in a class that never changes size.</li>
          <li>True or false, with a reason: "Linked lists always insert and delete faster than arrays."</li>
        </ol>
        <details class="reveal"><summary>Show the answers</summary><div class="flow">
          <ol>
            <li><code>3</code>. Three values (4, 9, and 7) are greater than 3.</li>
            <li>(a) Stack: <b>2, 4, 3</b> (1 is left). (b) Queue: <b>1, 2, 3</b> (4 is left).</li>
            <li>(a) Queue: first come, first served. (b) Stack: the most recent stroke is undone first. (c) Array: the size is fixed, and the seat number works as an index for direct access. Seat 25 is at index 24, since seats count from 1 but indexes count from 0.</li>
            <li><b>False.</b> Changing links is quick, but reaching the right node can mean walking through the list. Deleting the last value is quicker in an array, and reading by position is direct only in an array.</li>
          </ol>
        </div></details>
      </div>
    </div>
  </section>

  <section class="chapter wrap" id="check">
    <div class="chapter-head">
      <p class="chapter-num">Part 7 · Check yourself</p>
      <h2>Self-check</h2>
    </div>
    <div class="flow">
      <p>Not graded. Tap an answer to see if you got it, and read why.</p>
      <Quiz id="quiz-sq" questions={quiz} />
      <div class="remember">
        <p class="note-label">Key takeaways</p>
        <ol>
          <li>Stack: last in, first out. push, pop, and peek all happen at the top.</li>
          <li>Queue: first in, first out. Enqueue at the rear, dequeue at the front.</li>
          <li><code>pop</code> and <code>dequeue</code> remove; <code>peek</code> only looks.</li>
          <li>Guard against underflow (empty) and overflow (full) before acting.</li>
          <li>LIFO and FIFO are rules. Arrays and linked lists are storage. Any rule can use either.</li>
        </ol>
      </div>
      <p><b>You've finished the prelim topics.</b> Next: <a href={base + '/itc120/trees/'}>Trees and binary trees</a>, the start of the midterm.</p>
      <div class="refs small muted">

const bugTask = String.raw`public class Main {
  static int m = 5;
  static int[] table = {-1, -1, -1, -1, -1};

  static void insert(int key) {
    int home = key % m;
    for (int i = 0; i < m; i++) {
      int slot = home + i;
      if (table[slot] == -1) {
        table[slot] = key;
        return;
      }
    }
  }

  public static void main(String[] args) {
    insert(12);
    insert(27);

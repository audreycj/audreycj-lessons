import Base from '../../layouts/Base.astro';
import KindChips from '../../components/KindChips.astro';
import CodeWalk from '../../components/CodeWalk.astro';
import StepShow from '../../components/StepShow.astro';
import HashLab from '../../components/HashLab.astro';
import Quiz from '../../components/Quiz.astro';
import TryIt from '../../components/TryIt.astro';
import Peek from '../../components/Peek.astro';
import { course } from '../../data/itc120.js';
import { hi, hiN } from '../../lib/code.js';
import { trayHook, parkProbe, hashFlow } from '../../lib/illus.js';
import { KEYS, M, mod, rFor, stepOf, htPic, chainSteps, openSteps, toShow, deleteShow, chainInsertCode, chainInsertWalk, probeFindCode, probeFindWalk, badHashPic, threeTablesPic, rehashPic } from '../../lib/hashtab.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Worked examples (lesson keys, m = 7) and practice (m = 5): all tables come from the same engine the Java was checked against.
const chainRun = chainSteps(KEYS, M), linRun = openSteps(KEYS, M, 'linear'), quadRun = openSteps(KEYS, M, 'quadratic'), dblRun = openSteps(KEYS, M, 'double');
const rows = (run, k = M, meth = '') => run.steps.slice(1, -1).map((s) => ({ k: s.k, h: mod(s.k, k), step: meth === 'double' ? stepOf(s.k, rFor(k)) : null, tried: s.tries.map((t) => t.slot).join(', '), at: s.placed }));
const linRows = rows(linRun), quadRows = rows(quadRun), dblRows = rows(dblRun, M, 'double');
const chainLines = chainRun.slots.map((c, i) => `${i}: ${c.join(' → ')}`).join('\n');
const finalPic = (run) => htPic(M, run.steps[run.steps.length - 1].o);
const P5 = [12, 27, 33, 17, 40], P5m = 5;
const pc = chainSteps(P5, P5m), pl = openSteps(P5, P5m, 'linear'), pq = openSteps(P5, P5m, 'quadratic'), pd = openSteps(P5, P5m, 'double');
const plRows = rows(pl, P5m), pqRows = rows(pq, P5m), pdRows = rows(pd, P5m, 'double');
const p11 = openSteps(P5, 11, 'linear');
const slotLine = (slots) => slots.map((v, i) => `${i}: ${v ?? '-'}`).join('\n');

const defBox = (t, b) => `<div class="def"><p class="note-label">${t}</p><p>${b}</p></div>`;
const searchPeek = defBox('Linear and binary search (from the Searching lesson)', 'Linear search checks the values one by one, so it may need <b>n</b> checks for n values. Binary search keeps halving a <b>sorted</b> array: about 20 checks for 1,000,000 values.');
const mapsPeek = `<div class="illus">${hashFlow()}</div><p class="small">From the Maps lesson: a <code>HashMap</code> turns the key "CAT" into a number with <code>hashCode()</code>, turns that into a bucket number, and goes straight to that bucket.</p>`;
const modPeek = defBox('The % operator (from the Programming refresher)', '<code>a % b</code> gives the <b>remainder</b> when a is divided by b. <code>17 % 5</code> is 2, because 17 = 3 × 5 + 2.');
const llPeek = defBox('Linked list (from the Linked lists lesson)', 'A chain of <b>nodes</b>. Each node holds its data and <code>next</code>, a link to the next node. The last node\'s <code>next</code> is <code>null</code>. To reach a node, start at the first one and follow the links.');
const chainPeek = `${finalPic(chainRun)}<p class="small">Separate chaining, keys ${KEYS.join(', ')}, m = 7.</p>`;
const linPeek = `${finalPic(linRun)}<p class="small">Linear probing, keys ${KEYS.join(', ')}, m = 7.</p>`;
const pricesPeek = `${badHashPic()}<p class="small">From Part 2: with m = 10, every price that ends in 0 lands in slot 0.</p>`;
const wrongStop = htPic(M, { mode: 'chain', slots: chainRun.slots, kinds: { 1: 'home' }, nodeKinds: { '1:0': 'busy' }, head: ['Search for 92', 'h(92) = 92 mod 7 = 1'], note: 'stopped after 50: "not found" is wrong', noteFill: '#b23a33', alt: 'Bucket 1 holds 50, 85, 92. The search looks only at 50 and says not found, but 92 is further down the chain.' });

const full = String.raw`class Node {
  int key;
  Node next;

  Node(int key) {
    this.key = key;
  }
}

class ChainTable {
  Node[] table;
  int m;

  ChainTable(int m) {
    this.m = m;
    table = new Node[m];           // every bucket starts as null
  }

  void insert(int key) {
    int i = key % m;               // which bucket?
    Node newNode = new Node(key);
    if (table[i] == null) {        // empty bucket
      table[i] = newNode;
      return;
    }
    Node current = table[i];
    while (current.next != null) { // walk to the last node
      current = current.next;
    }
    current.next = newNode;        // add at the end of the chain
  }

  boolean contains(int key) {
    Node current = table[key % m]; // only this bucket's chain
    while (current != null) {
      if (current.key == key) {
        return true;
      }
      current = current.next;
    }
    return false;
  }

  void print() {
    for (int i = 0; i < m; i++) {
      System.out.print(i + ":");
      Node current = table[i];
      while (current != null) {
        System.out.print(" " + current.key);
        current = current.next;
      }
      System.out.println();
    }
  }
}

class ProbeTable {
  static final int EMPTY = -1;     // never used
  static final int DELETED = -2;   // a key was removed here
  int[] table;
  int m;

  ProbeTable(int m) {
    this.m = m;
    table = new int[m];
    for (int i = 0; i < m; i++) {
      table[i] = EMPTY;
    }
  }

  boolean insert(int key) {
    int home = key % m;
    for (int i = 0; i < m; i++) {
      int slot = (home + i) % m;   // linear probing
      if (table[slot] == EMPTY || table[slot] == DELETED) {
        table[slot] = key;
        return true;
      }
    }
    return false;                  // no free slot
  }

  int find(int key) {
    int home = key % m;
    for (int i = 0; i < m; i++) {
      int slot = (home + i) % m;          // linear probing
      if (table[slot] == EMPTY) {
        return -1;                        // a never-used slot: stop
      }
      if (table[slot] == key) {
        return slot;                      // found it
      }
    }
    return -1;                            // tried every slot
  }

  void remove(int key) {
    int slot = find(key);
    if (slot != -1) {
      table[slot] = DELETED;       // a mark, not EMPTY
    }
  }

  void print() {
    for (int i = 0; i < m; i++) {
      if (table[i] == EMPTY) {
        System.out.println(i + ": -");
      } else if (table[i] == DELETED) {
        System.out.println(i + ": deleted");
      } else {
        System.out.println(i + ": " + table[i]);
      }
    }
  }
}

public class Main {
  public static void main(String[] args) {
    int[] keys = {50, 700, 76, 85, 92, 73};

    ChainTable chain = new ChainTable(7);
    for (int i = 0; i < keys.length; i++) {
      chain.insert(keys[i]);
    }
    chain.print();
    System.out.println(chain.contains(92));   // true
    System.out.println(chain.contains(15));   // false

    ProbeTable probe = new ProbeTable(7);
    for (int i = 0; i < keys.length; i++) {
      probe.insert(keys[i]);
    }
    probe.print();
    System.out.println(probe.find(92));       // 3
    probe.remove(85);
    System.out.println(probe.find(92));       // still 3
    System.out.println(probe.find(85));       // -1
  }
}`;
const fullOut = ['0: 700', '1: 50 85 92', '2:', '3: 73', '4:', '5:', '6: 76', 'true', 'false', '0: 700', '1: 50', '2: 85', '3: 92', '4: 73', '5: -', '6: 76', '3', '3', '-1'].join('\n');

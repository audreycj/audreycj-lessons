---
import Base from '../../layouts/Base.astro';
import TreeFig from '../../components/TreeFig.astro';
import AvlLab from '../../components/AvlLab.astro';
import RbRules from '../../components/RbRules.astro';
import Quiz from '../../components/Quiz.astro';
import { course } from '../../data/itc120.js';
import { traverse } from '../../lib/tree.js';
import { rbInsertSteps, buildRb } from '../../lib/rb.js';
import { schoolLines } from '../../lib/illus.js';
import { code1, code2, code3, code4, starterFile } from '../../lib/rbjava.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Java snippets: escape, then grey out // comments.
const hi = (src) => src.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .split('\n').map((l) => l.replace(/(\/\/.*)$/, '<span class="c">$1</span>')).join('\n');

// Paper practice: answers and the list of fixes come from the same code the labs use.
function summarize(values) {
  let root = null;
  const notes = [];
  values.forEach((v, i) => {
    const out = rbInsertSteps(root, v);
    root = out.root;
    const tags = out.steps.map((s) => s.tag);
    if (i === 0) { notes.push(`<b>${v}</b>: becomes the root, colored black.`); return; }
    const acts = [];
    tags.forEach((t) => {
      if (t === 'Recolor') acts.push('uncle is red → <b>recolor</b>');
      else if (t === 'LL shape' || t === 'RR shape') acts.push(`uncle is black, <b>line (${t.slice(0, 2)})</b> → 1 rotation + swap colors`);
      else if (t === 'LR shape' || t === 'RL shape') acts.push(`uncle is black, <b>triangle (${t.slice(0, 2)})</b> → 2 rotations + swap colors`);
      else if (t === 'Recolor root') acts.push('root turned red, so color it <b>black</b>');
    });
    if (acts.length) notes.push(`<b>${v}</b>: ${acts.join('; then ')}.`);
  });
  return notes;
}
const practice = [
  { values: [21, 9, 15, 5, 30, 26, 23], extra: 'These are the same numbers as Problem 1 in the AVL lesson. Compare the two final trees: same shape here, but now with colors.' },
  { values: [40, 30, 50, 20, 25, 10, 5], extra: '' },
  { values: [1, 2, 3, 4, 5, 6, 7, 8], extra: 'Sorted input again. In a plain BST this would be a chain of height 7. Here the height is only 3.' },
].map((p) => {
  const r = buildRb(p.values);
  return { ...p, notes: summarize(p.values), pre: traverse(r, 'pre'), ino: traverse(r, 'in'), post: traverse(r, 'post') };
});

const starter = starterFile();

const quiz = [
  { q: 'What color is every newly inserted node (before any fixing)?', opts: ['Black', 'Red', 'The same color as its parent', 'The opposite color of its parent'], a: 1, why: 'New nodes are always <b>red</b>. Adding a red node never changes the black counts (rule 5), so the only possible problem is red-red (rule 4), or a red root if the tree was empty.' },
  { q: 'Which of these is <b>not</b> a red-black tree rule?', opts: ['The root is black', 'A red node cannot have a red child', 'Every path from a node down to a NIL leaf has the same number of black nodes', 'Red and black nodes must alternate on every level'], a: 3, why: 'Colors do not have to alternate. Two black nodes in a row are fine; even an all-black tree is valid if its black counts match. Only <b>two reds in a row</b> are forbidden.' },
  { q: 'You insert a node. Its parent is red and its <b>uncle is red</b>. What do you do?', opts: ['Rotate at the grandparent', 'Recolor: parent and uncle become black, grandparent becomes red', 'Delete the new node', 'Nothing; this is allowed'], a: 1, why: 'Red uncle → <b>recolor only</b>, no rotation. Then check the grandparent, because it just turned red and may now clash with its own parent.' },
  { q: 'Parent is red, uncle is black (or NIL), and the new node forms a <b>straight line</b> with its parent and grandparent (left-left). What is the fix?', opts: ['Recolor only', 'Rotate left at the parent', 'Rotate right at the grandparent, then swap the colors of parent and grandparent', 'Two rotations'], a: 2, why: 'A line (LL) gets one <b>right</b> rotation at the grandparent, just like AVL. Then the parent (now on top) becomes black and the old grandparent becomes red.' },
  { q: 'Insert 10, 30, 20 into an empty red-black tree. Which shape appears when 20 is inserted?', opts: ['Line (RR)', 'Triangle (RL)', 'Triangle (LR)', 'No problem appears'], a: 1, why: 'From 10 the path goes right (30), then left (20): a <b>triangle</b>, RL. The uncle is NIL (black), so: right rotation at 30, then left rotation at 10, then swap colors. Result: 20 black on top, 10 and 30 red.' },
  { q: 'An empty child (NIL) counts as what color?', opts: ['Red', 'Black', 'No color; it is ignored', 'The same color as its sibling'], a: 1, why: 'Every NIL leaf is <b>black</b> (rule 3). That is why an empty uncle means "uncle is black → rotate".' },
  { q: 'After recoloring, the root has become red. What do you do?', opts: ['Rotate at the root', 'Color the root black', 'Leave it red', 'Start over'], a: 1, why: 'Rule 2: the root is always black. Turning the root black never breaks any other rule (it adds one black to every path equally).' },
  { q: 'Compared with an AVL tree, a red-black tree is:', opts: ['More strictly balanced', 'Less strictly balanced, but usually needs fewer rotations', 'Not a binary search tree', 'Always taller than a plain BST'], a: 1, why: 'AVL keeps heights within 1, so it is usually shorter. Red-black only promises the longest path is at most twice the shortest, so it rotates less often. Both are BSTs.' },
];
---
<Base title="Red-Black Trees · ITC 120" description="Red-black trees in plain English: the five rules, recoloring, rotations, and step-by-step insertion you can play with." course={{ code: course.code, href: base + course.href }} toc>
  <header class="wrap lesson-hero flow">
    <p class="crumbs"><a href={base + course.href}>ITC 120</a> › Midterm › Balanced trees</p>
    <p class="kicker">Balanced trees · Lesson 2 of 2</p>
    <h1>Red-Black Trees</h1>
    <p class="lede">Another self-balancing BST. Instead of measuring heights, it paints each node red or black and follows a few color rules.</p>
    <div class="goals">
      <p class="note-label">By the end, you can:</p>
      <ol>
        <li>state the <b>five rules</b>, and say whether a colored tree follows them (and which rule it breaks);</li>
        <li>explain why the rules keep the longest path at most twice as long as the shortest;</li>
        <li>fix a red-red problem after an insertion: check the <b>uncle</b>, then recolor or rotate (line or triangle);</li>
        <li>insert a list of values into a red-black tree <b>by hand</b>, showing every fix;</li>
        <li>match each part of the Java insertion code to a step of the procedure;</li>
        <li>write the <code>rotateRight</code> method for the given code and check it with the built-in tests.</li>
      </ol>
    </div>
    <p class="small"><b>Scope:</b> this lesson covers <b>insertion</b> only. Deleting from a red-black tree uses a different, longer fix with more cases, and it is not covered here.</p>
    <p class="muted small"><b>You need:</b> the <a href={base + '/itc120/avl-trees/'}>AVL trees lesson</a> (especially rotations and the LL, RR, LR, RL shapes), scratch paper, and a pen (a red and a black pen help a lot). For Part 8: a phone or computer with internet.</p>
  </header>

  <!-- 1 -->
  <section class="chapter wrap" id="idea">
    <div class="chapter-head">
      <p class="chapter-num">Part 1 · The idea</p>
      <h2>Balancing with colors</h2>
    </div>
    <div class="flow">
      <p>In the AVL lesson, the tree stayed balanced by checking <b>heights</b> after every insert. A red-black tree solves the same problem in a different way: each node stores just one extra piece of information, its <b>color</b> (red or black).</p>

      <div class="def">
        <p class="note-label">Red-black tree</p>
        <p>A <b>red-black tree</b> is a binary search tree in which every node is colored red or black, and the colors follow five rules. When an insertion breaks a rule, the tree fixes it by <b>recoloring</b> nodes and, if needed, <b>rotating</b>.</p>
      </div>

      <TreeFig values={[12, 8, 24, 4, 16, 28, 20]} mode="bst" colors={{ 12: 'B', 8: 'B', 4: 'R', 24: 'R', 16: 'B', 28: 'B', 20: 'R' }} label="A red-black tree: 12 black at the root, 8 black, 4 red, 24 red, 16 black, 28 black, 20 red" />
      <p class="small muted" style="text-align:center">A red-black tree. Still a BST: in-order gives 4, 8, 12, 16, 20, 24, 28.</p>

      <div class="sticky">
        <p class="note-label">Think of lining up</p>
        <p>Imagine a school rule for lining up: <b>the first student in every line wears black</b>, <b>no two "red-shirt" students may stand next to each other</b>, and <b>every line must have the same number of "black-shirt" students</b>. With those rules, no line can get much longer than the others. The shortest a line can be is all black. The longest goes black, red, black, red..., with at most one red after each black, so it is at most <b>twice</b> as long.</p>
      </div>

      <figure class="fig illus-fig illus"><Fragment set:html={schoolLines()} /><figcaption>Both allowed lines have 3 black shirts. The longest line can add only one red after each black, so it has at most 6 students: twice the shortest. In a red-black tree, each line is a path from the root down, and the shirts are the node colors (the black first student is the black root).</figcaption></figure>

      <div class="remember">
        <p class="note-label">Where you see this in IT</p>
        <p>Java's built-in <code>TreeMap</code> class is a red-black tree, and <code>TreeSet</code> is built on a <code>TreeMap</code>. You will use them in the Sets and Maps lessons. Every time you add a key, Java does the recoloring and rotations from this lesson for you.</p>
      </div>
    </div>
  </section>

  <!-- 2 -->
  <section class="chapter wrap" id="rules">
    <div class="chapter-head">
      <p class="chapter-num">Part 2 · The rules</p>
      <h2>The five rules</h2>
    </div>
    <div class="flow">
      <p>Every red-black tree follows these five rules at all times. Rules 4 and 5 are the important ones; the others set things up.</p>
      <ol class="rules">
        <li><b>Color rule.</b> Every node is either red or black.</li>
        <li><b>Root rule.</b> The root is black.</li>
        <li><b>NIL rule.</b> Every empty spot (a <code>null</code> child, called a <b>NIL leaf</b>) counts as black. See "What is NIL?" below.</li>
        <li><b>Red rule.</b> A red node cannot have a red child. <span class="hl">No two reds in a row.</span></li>
        <li><b>Black rule.</b> From any node, every path down to a NIL leaf passes through the <span class="hl">same number of black nodes</span>.</li>
      </ol>

      <div class="def">
        <p class="note-label">What is NIL?</p>
        <p><b>NIL</b> means "nothing here." It is an <b>empty child spot</b>: a place where a child could be, but there is none. In Java, it is a <code>null</code> link, like <code>node.left == null</code>.</p>
        <p>Every node has two child spots, so the Part 1 tree, with 7 nodes, has 14 spots. Real nodes fill 6 of them, so 8 are NIL. You will see all 8 drawn as small black boxes in the picture below.</p>
        <p>Rule 3 treats every NIL spot as a tiny <b>black</b> leaf for two reasons. First, every path down then ends at the same kind of thing, so we can count black nodes the same way on every path (rule 5). Second, when a node's uncle is missing, the uncle counts as black (you will need this in Part 3).</p>
        <p class="small"><b>Careful with the word "leaf":</b> in earlier lessons, a leaf is a real node with no children, like 4, 20, and 28 here. A <b>NIL leaf</b> is one of the empty spots below a node. In the red-black rules, "leaf" always means NIL leaf.</p>
      </div>

      <div class="sub">
        <h3>Seeing rule 5</h3>
        <p>Here is the same tree with its NIL leaves drawn as small black boxes. Start at the root, 12, and walk down to <b>any</b> box. Count the black circles you pass (do not count the box):</p>
        <TreeFig values={[12, 8, 24, 4, 16, 28, 20]} mode="bst" colors={{ 12: 'B', 8: 'B', 4: 'R', 24: 'R', 16: 'B', 28: 'B', 20: 'R' }} showNil label="The same red-black tree with NIL leaves shown as small black boxes" />
        <table class="tbl">
          <thead><tr><th>Path from 12</th><th>Black nodes passed</th></tr></thead>
          <tbody>
            <tr><td>12 → 8 → 4 → NIL</td><td>12, 8 = <b>2</b></td></tr>
            <tr><td>12 → 8 → NIL</td><td>12, 8 = <b>2</b></td></tr>
            <tr><td>12 → 24 → 16 → 20 → NIL</td><td>12, 16 = <b>2</b></td></tr>
            <tr><td>12 → 24 → 28 → NIL</td><td>12, 28 = <b>2</b></td></tr>
          </tbody>
        </table>
        <p>Every path has 2 black nodes. Red nodes are "free": they do not count. This shared number is called the <b>black-height</b>.</p>
      </div>

      <div class="plain">
        <p class="note-label">Why the rules keep it balanced</p>
        <p>The shortest possible path is <b>all black</b>. The longest possible path <b>alternates</b> black, red, black, red (rule 4 stops two reds in a row). Both have the same number of blacks (rule 5). So the longest path is <b>at most twice</b> as long as the shortest. The tree can lean a little, but it can never become a chain.</p>
      </div>

      <div class="sub">
        <h3>Your turn: valid or not?</h3>
        <p>Check each tree against the rules. Tap your answer to see the reason.</p>
        <RbRules id="rbr" items={[
          { values: [20, 10, 30], colors: { 20: 'B', 10: 'R', 30: 'R' } },
          { values: [20, 10, 30], colors: { 20: 'R', 10: 'B', 30: 'B' } },
          { values: [20, 10, 30, 25], colors: { 20: 'B', 10: 'R', 30: 'R', 25: 'R' } },
          { values: [20, 10, 30], colors: { 20: 'B', 10: 'B', 30: 'B' } },
          { values: [20, 10, 30], colors: { 20: 'B', 10: 'B', 30: 'R' } },
          { values: [20, 10, 30, 5], colors: { 20: 'B', 10: 'B', 30: 'B', 5: 'B' } },
        ]} />
      </div>

      <div class="trap">
        <p class="note-label">Exam traps</p>
        <ul>
          <li>Colors do <b>not</b> have to alternate. Black under black is fine (see Tree 4).</li>
          <li>When counting black nodes for rule 5, count the same way on every path: either always include the starting node or never.</li>
          <li>A missing child is a black NIL leaf. This matters when you look at the uncle.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 3 -->
  <section class="chapter wrap" id="fix">
    <div class="chapter-head">
      <p class="chapter-num">Part 3 · The fix</p>
      <h2>Inserting: recolor or rotate</h2>
    </div>
    <div class="flow">
      <p>Every insertion starts the same way: insert the value like a normal BST, and <b>color it red</b>.</p>
      <p>Why red? A red node does not change any black count, so rule 5 stays safe. The only rule that can break is <b>rule 4</b>: if the new node's parent is also red, we have a <b>red-red problem</b>. (One exception: in an empty tree, the new node is the root, so just color it black for rule 2.)</p>

      <div class="sub">
        <h3>Meet the family</h3>
        <p>To fix a red-red problem, we look at the new node's relatives. These are the names we will use:</p>
        <table class="tbl">
          <thead><tr><th>Name</th><th>Who it is</th></tr></thead>
          <tbody>
            <tr><td><b>x</b></td><td>the node we are fixing (at first, the new node)</td></tr>
            <tr><td><b>parent</b></td><td>x's parent</td></tr>
            <tr><td><b>grandparent</b></td><td>the parent's parent</td></tr>
            <tr><td><b>uncle</b></td><td>the parent's sibling (the grandparent's other child)</td></tr>
          </tbody>
        </table>
        <TreeFig values={[30, 20, 40, 10]} mode="bst" colors={{ 30: 'B', 20: 'R', 40: 'R', 10: 'R' }} marks={{ 10: 'new', 20: 'problem', 40: 'uncle' }} label="10 is new and red, its parent 20 is red, its uncle 40 is red, and the grandparent 30 is black" />
        <p class="small muted" style="text-align:center">New node 10 (x), parent 20, grandparent 30, uncle 40.</p>
      </div>

      <div class="sub">
        <h3>The decision</h3>
        <p>The fix depends on two questions. There are three types of situations:</p>
        <table class="tbl decide">
          <thead><tr><th>Situation</th><th>What to do</th></tr></thead>
          <tbody>
            <tr><td><b>Parent is black</b></td><td>Nothing. No rule is broken.</td></tr>
            <tr><td><b>Parent red, uncle red</b></td><td><b>Recolor:</b> parent and uncle → black, grandparent → red. Then check the grandparent (it is red now, so its parent might also be red). If the grandparent is the root, just make it black.</td></tr>
            <tr><td><b>Parent red, uncle black</b> (or NIL)</td><td><b>Rotate</b>, using the same shapes as AVL:<br/>
              <b>Line</b> (LL or RR): 1 rotation at the grandparent, then swap the colors of parent and grandparent.<br/>
              <b>Triangle</b> (LR or RL): first rotate at the parent to make a line, then do the line fix.</td></tr>
          </tbody>
        </table>
        <div class="remember">
          <p class="note-label">How to remember</p>
          <p><b>Red uncle → recolor. Black uncle → rotate.</b></p>
          <p>After rotating, the node on top becomes <b>black</b> and its two children are <b>red</b>. In insertion, after a rotation, you are done.</p>
        </div>
      </div>

      <AvlLab id="lab-rb-cases" kind="rb" cap="Watch each situation" hint="Pick one, then tap Next step. Watch the uncle (dashed ring) to decide: recolor or rotate?" presets={[
        { label: 'Uncle red', values: [20, 10, 30, 5] },
        { label: 'Line LL', values: [30, 20, 10] },
        { label: 'Line RR', values: [10, 20, 30] },
        { label: 'Triangle LR', values: [30, 10, 20] },
        { label: 'Triangle RL', values: [10, 30, 20] },
      ]} />

      <div class="trap">
        <p class="note-label">Exam traps</p>
        <ul>
          <li>Look at the <b>uncle</b>, not the sibling of the new node.</li>
          <li>Recoloring can move the problem <b>up</b> the tree. Keep checking until the parent is black or you reach the root.</li>
          <li>Don't forget the last step: the root must end up black.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 4 -->
  <section class="chapter wrap" id="insert">
    <div class="chapter-head">
      <p class="chapter-num">Part 4 · Putting it together</p>
      <h2>Inserting, step by step</h2>
    </div>
    <div class="flow">
      <p>This is the full procedure. Use it for every value, in order:</p>
      <ol class="procedure">
        <li><b>Insert</b> the value like a normal BST and color it <b>red</b>. (If the tree was empty, it is the root: color it black.)</li>
        <li><b>Check the parent.</b> If it is black, you are done.</li>
        <li>If the parent is red, <b>check the uncle</b>.
          <ul>
            <li><b>Red uncle:</b> recolor, then repeat step 2 from the grandparent.</li>
            <li><b>Black uncle:</b> name the shape (line or triangle), rotate, swap colors. Done.</li>
          </ul>
        </li>
        <li>Finally, make sure the <b>root is black</b>.</li>
      </ol>

      <AvlLab id="lab-rb-full" kind="rb" cap="Worked example" hint="This list shows all three situations from the table, with both shapes (a triangle at 25 and a line at 60), including a recolor that moves the problem up the tree (watch 60). Turn on NIL leaves to see why an empty uncle counts as black. Then try your own numbers." custom presets={[
        { label: 'Worked example', values: [5, 45, 25, 10, 35, 75, 70, 90, 60] },
      ]} />

      <div class="remember">
        <p class="note-label">Doing it on paper</p>
        <ul>
          <li>Use two pens, or write <b>R</b> or <b>B</b> beside each node. Circle the red ones.</li>
          <li>Redraw the tree after every rotation. Recolors can be done by crossing out the letter.</li>
          <li>Before fixing, write what you see: for example, "<b>60: parent 70 red, uncle 90 red → recolor</b>".</li>
          <li>At the end, check rules 2, 4, and 5 on your final tree.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5 -->
  <section class="chapter wrap" id="paper">
    <div class="chapter-head">
      <p class="chapter-num">Part 5 · Your turn</p>
      <h2>Try it on paper</h2>
    </div>
    <div class="flow">
      <p>Do each problem on paper <b>before</b> opening the answer. Afterwards, type the same numbers into the lab in Part 4 to replay it step by step.</p>
      {practice.map((p, i) => (
        <div class="paper flow">
          <p class="note-label">Problem {i + 1}</p>
          <p>Insert these values, in order, into an empty red-black tree:</p>
          <p class="mono seq">{p.values.join(', ')}</p>
          <p>Show the colors in your final tree. Then write its <b>pre-order</b> traversal.</p>
          <details class="reveal">
            <summary>Show the answer</summary>
            <div class="flow">
              <TreeFig values={p.values} mode="rb" label={`Final red-black tree for problem ${i + 1}`} />
              <p><b>What happened at each insert</b> (values not listed needed no fix):</p>
              <ul class="small">{p.notes.map((n) => <li set:html={n} />)}</ul>
              {p.extra && <p>{p.extra}</p>}
              <table class="tbl">
                <tbody>
                  <tr><th>Pre-order</th><td class="mono">{p.pre.join(', ')}</td></tr>
                  <tr><th>In-order</th><td class="mono">{p.ino.join(', ')}</td></tr>
                </tbody>
              </table>
            </div>
          </details>
        </div>
      ))}
    </div>
  </section>

  <!-- 6 -->
  <section class="chapter wrap" id="compare">
    <div class="chapter-head">
      <p class="chapter-num">Part 6 · Side by side</p>
      <h2>AVL vs. red-black</h2>
    </div>
    <div class="flow">
      <p>Both are self-balancing binary search trees, and both use the same rotations. They differ in how strict they are. Here are the main differences:</p>
      <table class="tbl">
        <thead><tr><th></th><th>AVL tree</th><th>Red-black tree</th></tr></thead>
        <tbody>
          <tr><td><b>Extra info per node</b></td><td>height (or balance factor)</td><td>one color: red or black</td></tr>
          <tr><td><b>Balance promise</b></td><td>left and right heights differ by at most 1</td><td>longest path is at most 2× the shortest</td></tr>
          <tr><td><b>Shape</b></td><td>more tightly balanced (shorter)</td><td>a little looser (can be a bit taller)</td></tr>
          <tr><td><b>How it fixes</b></td><td>rotations</td><td>recoloring first; rotations only when the uncle is black</td></tr>
          <tr><td><b>Good for</b></td><td>lots of searching, fewer changes</td><td>lots of inserts and deletes</td></tr>
        </tbody>
      </table>
      <div class="two-col">
        <figure class="fig">
          <p class="fig-cap">AVL: 1 to 8</p>
          <TreeFig values={[1, 2, 3, 4, 5, 6, 7, 8]} mode="avl" label="AVL tree after inserting 1 to 8" />
        </figure>
        <figure class="fig">
          <p class="fig-cap">Red-black: 1 to 8</p>
          <TreeFig values={[1, 2, 3, 4, 5, 6, 7, 8]} mode="rb" label="Red-black tree after inserting 1 to 8" />
        </figure>
      </div>
      <p>Same input, both balanced. They happen to have the same shape here, but that is not always true: for other inputs the red-black tree can be a little taller.</p>
    </div>
  </section>

  <!-- 7 -->
  <section class="chapter wrap" id="java">
    <div class="chapter-head">
      <p class="chapter-num">Part 7 · In code</p>
      <h2>Red-black insertion in Java</h2>
    </div>
    <div class="flow">
      <p>The red-black code is longer than AVL's, because each node needs a link back to its <b>parent</b> (to find the grandparent and uncle). Read it alongside the procedure in Part 4; you will see each step.</p>

      <div class="sub">
        <h3>1. The node and a color helper</h3>
        <pre class="code"><code set:html={hi(code1)} /></pre>
        <p>All the pieces in this part go inside one class (in Part 8 it is called <code>Main</code>). <code>RBNode</code> is a <code>static</code> class so that the <code>static</code> methods can make nodes with <code>new RBNode(value)</code>. Without <code>static</code>, Java stops with "non-static variable this cannot be referenced from a static context".</p>
      </div>
      <div class="sub">
        <h3>2. Insert like a BST, then fix</h3>
        <pre class="code"><code set:html={hi(code2)} /></pre>
      </div>
      <div class="sub">
        <h3>3. The fix: recolor or rotate</h3>
        <pre class="code"><code set:html={hi(code3)} /></pre>
        <p>Compare with the decision table in Part 3: <code>while (isRed(x.parent))</code> is "red-red problem", <code>isRed(u)</code> is "uncle red", and the <code>else</code> part is "uncle black: rotate". The last line is rule 2.</p>
      </div>
      <div class="sub">
        <h3>4. Rotation, with parent links</h3>
        <pre class="code"><code set:html={hi(code4)} /></pre>
        <p>This is the same left rotation as in the AVL lesson. The extra lines keep every <code>parent</code> link correct, and update <code>root</code> if the rotation happens at the top.</p>
      </div>
    </div>
  </section>

  <!-- 8 -->
  <section class="chapter wrap" id="task">
    <div class="chapter-head">
      <p class="chapter-num">Part 8 · Your coding task</p>
      <h2>Write rotateRight and test it</h2>
    </div>
    <div class="flow">
      <p>Part 7 showed the whole insertion code except one method: <code>rotateRight</code>. Your task is to write it. Everything else, including the tests, is given to you in one file.</p>
      <p>Why this method? Every line fix (LL) and both triangle fixes (LR and RL) use it, so the tests can only pass when it is right. It is also the part that is new compared with AVL: a rotation must keep every <code>parent</code> link correct, and the tests check every link.</p>

      <div class="sub">
        <h3>1. Prepare on paper</h3>
        <p>Do these three things on paper first. They make the code much easier to write.</p>
        <ol class="procedure">
          <li>Insert 30, 20, 10. Before any fix, the tree is a line: 30, then 20 as its left child, then 10 as 20's left child. Draw it, then draw it again after <b>rotate right at 30</b>.</li>
          <li>Go through <code>rotateLeft</code> in Part 7 line by line, and write the mirror of each line: swap every <code>left</code> and <code>right</code>.</li>
          <li>Trace your lines on your drawing. At the end, check every node: does its <code>parent</code> point to the node just above it? Does <code>root</code> point to the top node?</li>
        </ol>
      </div>

      <div class="sub">
        <h3>2. Run the starter file</h3>
        <p>Next, run the file once without changing it:</p>
        <ol class="procedure">
          <li>Open any free online Java compiler, for example Programiz or OneCompiler. It works in a phone browser.</li>
          <li>Tap <b>Copy the whole file</b>, paste it into the compiler (replace the code already there), and tap <b>Run</b>. The class is called <code>Main</code>, as these sites expect.</li>
          <li>You should see <b>2 of 8 tests passed</b>. The other tests fail with "rotateRight is not written yet". That is expected.</li>
        </ol>
        <div class="btn-row">
          <button type="button" class="btn primary" id="rb-copy">Copy the whole file</button>
          <span class="copy-out small" id="rb-copy-out" aria-live="polite"></span>
        </div>
        <details class="reveal">
          <summary>Show the starter file ({starter.split('\n').length} lines)</summary>
          <pre class="code"><code id="rb-starter" set:html={hi(starter)} /></pre>
        </details>
      </div>

      <div class="sub">
        <h3>3. Write rotateRight and test it</h3>
        <p>Now write the method:</p>
        <ol class="procedure">
          <li>Find <code>YOUR TASK</code> in the file. Delete the <code>throw</code> statement (both of its lines), then type your method.</li>
          <li>Tap Run. Fix and run again until you see <b>8 of 8 tests passed</b>.</li>
          <li>Then change the numbers in the last line of <code>main</code> to one of the Part 5 problems, and compare the printed tree with your paper answer.</li>
        </ol>
        <p>The tests print a tree as text: <code>20B(10R,30R)</code> means 20 is black, with 10 (red) on its left and 30 (red) on its right; a <code>-</code> is an empty spot. This table explains each kind of message:</p>
        <table class="tbl">
          <thead><tr><th>Message</th><th>What it means</th></tr></thead>
          <tbody>
            <tr><td><code>PASS</code></td><td>The tree is exactly right, and every rule and every <code>parent</code> link was correct after each insert.</td></tr>
            <tr><td><code>wrong tree</code></td><td>The shape or the colors are wrong. Compare the <code>expected</code> and <code>got</code> lines.</td></tr>
            <tr><td><code>wrong parent link at N</code></td><td>N's <code>parent</code> points to the wrong node. Check every line that sets a <code>.parent</code>.</td></tr>
            <tr><td><code>NullPointerException</code></td><td>The code followed an empty (null) link. Often <code>root</code> or a parent's child link was not updated.</td></tr>
            <tr><td><code>links form a loop</code> or <code>still running</code></td><td>Some node points back up to a node above it. Check which child (left or right) each line sets.</td></tr>
          </tbody>
        </table>
        <div class="trap">
          <p class="note-label">Don't stop at 7 of 8</p>
          <p>The first seven tests use small trees. Some mistakes only show up in bigger trees, when the node that moves up has a child that changes parent. That is what the 300 random lists are for.</p>
        </div>
      </div>

      <div class="plain">
        <p class="note-label">No phone or data right now?</p>
        <p>Do step 1, write your method on paper, and trace it on this tree: rotate right at 50. Here 30 moves up, and 40 changes parent.</p>
        <TreeFig spec="50(30(20,40),60)" label="Practice tree for tracing rotate right at 50: 50 on top, 30 and 60 below it, 20 and 40 under 30" />
        <p>This is good preparation, but it is only a <b>temporary fallback</b>: a paper trace shows you understand the steps; it does not show that your code compiles and passes the tests. Run it as soon as you can, for example in a campus computer lab. Your teacher will tell you how to submit this task.</p>
      </div>

      <div class="remember">
        <p class="note-label">What this task covers, and what it doesn't</p>
        <p>You write one important method and test it inside a full, working insertion. You do <b>not</b> write the whole insertion (<code>insert</code> and <code>fixUp</code>) from scratch, and deletion is not part of this lesson.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var b = document.getElementById('rb-copy'), out = document.getElementById('rb-copy-out');
      var code = document.getElementById('rb-starter');
      if (!b || !code) return;
      function said(t) { out.textContent = t; }
      function fallback(text) {
        var ta = document.createElement('textarea');
        ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        var ok = false; try { ok = document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
        said(ok ? 'Copied! Now paste it into the compiler.' : 'Could not copy. Open "Show the starter file" and copy it by hand.');
      }
      b.addEventListener('click', function () {
        var text = code.textContent;
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(function () { said('Copied! Now paste it into the compiler.'); }, function () { fallback(text); });
        } else fallback(text);
      });
    })();
  </script>


import Base from '../../layouts/Base.astro';
import KindChips from '../../components/KindChips.astro';
import LinkedLab from '../../components/LinkedLab.astro';
import Quiz from '../../components/Quiz.astro';
import { course } from '../../data/itc120.js';
import { hi, hiN } from '../../lib/code.js';
import { llDefPic, llHuntPic, llTrainPic, llWeakPic, llNewPic, llNamesPic, llAccessPic, llTravPic, llCircPic, llNullPic, llBarsPic, llTrainSkipPic, llStreetPic, llRoadsPic, llKindsPic, llFrontCode, llFrontSteps, llSwapCode, llSwapSteps, llAfterCode, llAfterSteps, llBypassCode, llBypassSteps, llStuckCode, llStuckSteps } from '../../lib/illus.js';
import CodeWalk from '../../components/CodeWalk.astro';
import TryIt from '../../components/TryIt.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const node = String.raw`class Node {
  int data;          // the value stored in this node
  Node next;         // reference to the next node (null if none)

  Node(int value) {  // constructor: runs once for each new Node(...)
    data = value;
    next = null;     // a new node has no next node yet
  }
}`;
const same = String.raw`Node a = new Node(5);
Node b = a;                  // b refers to the SAME node as a
b.data = 9;                  // changes that one node
System.out.println(a.data);  // prints 9`;
const link = String.raw`Node ten = new Node(10);
Node twenty = new Node(20);
ten.next = twenty;           // connects node 10 to node 20`;
const build = String.raw`Node head = new Node(10);    // head refers to node 10
Node twenty = new Node(20);
head.next = twenty;          // 10 -> 20
twenty.next = new Node(30);  // 20 -> 30
printList(head);             // 10 -> 20 -> 30 -> null`;
const print = String.raw`static void printList(Node start) {
  Node current = start;              // start at the first node
  while (current != null) {          // while there is a node here
    System.out.print(current.data + " -> ");
    current = current.next;          // move to the next node
  }
  System.out.println("null");        // mark the end
}`;
const front = String.raw`Node newNode = new Node(5);
newNode.next = head;     // step 1: new node refers to the old first node
head = newNode;          // step 2: head refers to the new node`;
const after = String.raw`// current refers to node 20 (newNode was declared above)
newNode = new Node(25);
newNode.next = current.next;   // step 1: 25 refers to 30
current.next = newNode;        // step 2: 20 refers to 25`;
const bypass = String.raw`// previous refers to node 20
previous.next = previous.next.next;   // 20 now refers to 30`;
const first = String.raw`head = head.next;    // head refers to the second node`;
const full = String.raw`class Node {
  int data;
  Node next;
  Node(int value) {
    data = value;
    next = null;
  }
}

public class Main {
  static void printList(Node start) {
    Node current = start;
    while (current != null) {
      System.out.print(current.data + " -> ");
      current = current.next;
    }
    System.out.println("null");
  }

  public static void main(String[] args) {
    Node head = new Node(10);
    Node twenty = new Node(20);
    head.next = twenty;
    twenty.next = new Node(30);
    printList(head);

    // 1. insert 5 at the beginning
    Node newNode = new Node(5);
    newNode.next = head;
    head = newNode;
    printList(head);

    // 2. insert 25 after node 20
    Node current = twenty;
    newNode = new Node(25);
    newNode.next = current.next;
    current.next = newNode;
    printList(head);

    // 3. delete the node after 20 (bypass it)
    Node previous = twenty;
    previous.next = previous.next.next;
    printList(head);

    // 4. delete the first node
    head = head.next;
    printList(head);
  }
}`;
const q1 = String.raw`Node p = new Node(3);
Node q = new Node(3);
q.data = 8;
System.out.println(p.data);`;
const q2 = String.raw`Node first = new Node(1);
Node second = new Node(2);
first.next = second;
Node third = first.next;`;
const q4 = String.raw`Node n = new Node(15);
n.next = head.next;
head.next = n;`;
const n1 = String.raw`Node current = head.next;
current = current.next;
System.out.println(current.data);
System.out.println(current.next.data);
System.out.println(head.next.data);`;
const n2 = String.raw`Node a = new Node(3);
a.next = head;
head = a;
Node b = new Node(10);
b.next = head.next.next;
head.next.next = b;`;
const n3 = String.raw`head = head.next;
Node prev = head.next;
prev.next = prev.next.next;`;
const bug = String.raw`current.next = newNode;
newNode.next = current.next;`;

const quiz = [
  { q: 'What does each node in a singly linked list store?', opts: ['Only its value', 'Its value and its index', 'Its value and a reference to the next node', 'A copy of the whole list'], a: 2, why: 'A node holds <b>data</b> and <b>next</b>. It has no index: it only knows which node comes next.' },
  { q: 'To reach the 4th node, a linked list must…', opts: ['jump straight to index 3', 'start at head and follow 3 links', 'start at the last node', 'shift the other nodes'], a: 1, why: 'There are no indexes. Start at <code>head</code> and follow <code>next</code> three times.' },
  { q: 'To insert X between B and C, which line must run <b>first</b>?', opts: ['B points to X', 'X points to C', 'head points to X', 'C points to X'], a: 1, why: 'Connect the new node first (X → C). If B changes first, nothing points to C anymore, and the rest of the list is lost.' },
  { q: 'What does <code>previous.next = previous.next.next;</code> do?', opts: ['Deletes previous', 'Deletes the node after previous by linking around it', 'Moves previous forward', 'Inserts a node'], a: 1, why: '<code>previous.next.next</code> is the node two steps ahead. Pointing to it skips the node in between, so it is no longer in the list.' },
  { q: 'After <code>Node b = a; b.data = 9;</code>, what is <code>a.data</code>?', opts: ['Its old value', '9', '0', 'an error'], a: 1, why: '<code>b = a</code> copies the <b>reference</b>, not the node. Both names refer to the same node, so the change shows through <code>a</code> too.' },
  { q: 'A photo viewer with Next and Previous buttons fits which kind of linked list?', opts: ['Singly', 'Doubly', 'Circular singly', 'None'], a: 1, why: 'Going back needs a <b>prev</b> link in each node: a <b>doubly</b> linked list.' },
  { q: 'A traversal loop <code>while (current != null)</code> on a circular list will…', opts: ['stop at the last node', 'never stop', 'throw an error right away', 'skip the head'], a: 1, why: 'A circular list has no <code>null</code> at the end, so the condition never becomes false. It must stop when it gets back to the starting node.' },
];

import Base from '../../layouts/Base.astro';
import TryIt from '../../components/TryIt.astro';
import { hiN } from '../../lib/code.js';
import KindChips from '../../components/KindChips.astro';
import GraphFig from '../../components/GraphFig.astro';
import TraverseLab from '../../components/TraverseLab.astro';
import Quiz from '../../components/Quiz.astro';
import Peek from '../../components/Peek.astro';
import { course } from '../../data/itc120.js';
import { city, oneWay, islands } from '../../data/graphs.js';
import { dfsSteps, bfsSteps, svgGraph } from '../../lib/graph.js';
import { dfsDive, folderDive, stackIsPath, bfsVsDfs, dfsTwoWays, dfsInIT } from '../../lib/illus.js';
const labPeek = svgGraph(city, { label: 'The main example graph: A-B, A-D, B-C, B-E, C-F, D-E, E-F, E-G, F-G' }) + '<p class="small">The <b>Main example</b> in the Part 3 lab: the same vertices and edges. There, tap <b>Next step</b> to watch DFS move one step at a time.</p>';
const stackSvg = stackIsPath(), folderSvg = folderDive();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hi = (src) => src.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .split('\n').map((l) => l.replace(/(\/\/.*)$/, '<span class="c">$1</span>')).join('\n');

const dfsCity = dfsSteps(city, 'A');
const bfsCity = bfsSteps(city, 'A');
// The stack at the moment DFS first reaches G = a path from A to G.
const atG = dfsCity.steps.find((s) => s.ds[s.ds.length - 1] === 'G');
const dfsPath = atG.ds;
const pm = (path) => { const m = {}; for (let i = 0; i + 1 < path.length; i++) m[`${path[i]}-${path[i + 1]}`] = 'path'; return m; };
const pn = (path) => Object.fromEntries(path.map((x) => [x, 'hl']));
const bfsPath = (() => { const p = ['G']; while (bfsCity.parent[p[0]]) p.unshift(bfsCity.parent[p[0]]); return p; })();

const fromF = dfsSteps(oneWay, 'F');
const fromA = dfsSteps(oneWay, 'A');

// Paper practice (same graphs as the BFS lesson, so you can compare)
const p1 = {
  directed: false, weighted: false,
  nodes: [{ id: 'A', x: 40, y: 125 }, { id: 'B', x: 130, y: 50 }, { id: 'C', x: 130, y: 205 }, { id: 'D', x: 220, y: 100 }, { id: 'E', x: 220, y: 225 }, { id: 'F', x: 305, y: 160 }, { id: 'G', x: 305, y: 40 }],
  edges: [['A', 'B'], ['A', 'C'], ['B', 'D'], ['C', 'D'], ['C', 'E'], ['D', 'F'], ['E', 'F'], ['D', 'G']].map(([a, b]) => ({ a, b })),
};
const p2 = {
  directed: true, weighted: false,
  nodes: [{ id: 'A', x: 60, y: 60 }, { id: 'B', x: 190, y: 45 }, { id: 'C', x: 120, y: 170 }, { id: 'D', x: 300, y: 110 }, { id: 'E', x: 250, y: 225 }, { id: 'F', x: 40, y: 230 }],
  edges: [['A', 'B'], ['A', 'C'], ['B', 'D'], ['C', 'B'], ['D', 'E'], ['E', 'C'], ['F', 'A']].map(([a, b]) => ({ a, b })),
};
const r1 = dfsSteps(p1, 'D'), r1b = bfsSteps(p1, 'D');
const r2 = dfsSteps(p2, 'C');
// stack snapshots for problem 1 (only the steps that change it), to show on paper
// exam-style trace rows for problem 1 (one row per push or pop, like the prelim stack items)
const r1Rows = r1.steps.map((s, i) => {
  const prev = i ? r1.steps[i - 1].ds : [];
  const push = s.ds.length > prev.length;
  return { act: (push ? 'push ' : 'pop ') + (push ? s.ds[s.ds.length - 1] : prev[prev.length - 1]), stack: s.ds.join(', ') || '(empty)', order: s.order.join(', ') };
});

const code = String.raw`public class DFS {
  static char[] names = {'A', 'B', 'C', 'D', 'E', 'F', 'G'};
  static int n = names.length;
  static int[][] adj = new int[n][n];
  static boolean[] visited = new boolean[n];

  static void addEdge(int a, int b) {   // undirected
    adj[a][b] = 1;
    adj[b][a] = 1;
  }

  static void dfs(int u) {
    visited[u] = true;
    System.out.print(names[u] + " ");   // visit

    for (int v = 0; v < n; v++) {       // A to Z order
      if (adj[u][v] == 1 && !visited[v]) {
        dfs(v);                         // go deeper
      }
    }
    // loop ended: no unvisited neighbors left,
    // so this call returns (= backtrack / pop)
  }

  public static void main(String[] args) {
    addEdge(0, 1); addEdge(0, 3);   // A-B, A-D
    addEdge(1, 2); addEdge(1, 4);   // B-C, B-E
    addEdge(2, 5); addEdge(3, 4);   // C-F, D-E
    addEdge(4, 5); addEdge(4, 6);   // E-F, E-G
    addEdge(5, 6);                  // F-G
    dfs(0);   // prints: A B C F E D G
  }
}`;

const taskCode = String.raw`public class Main {
  static char[] names = {'A', 'B', 'C', 'D', 'E', 'F'};
  static int n = names.length;
  static int[][] adj = new int[n][n];
  static boolean[] visited = new boolean[n];

  static void addArrow(int from, int to) {   // directed
    adj[from][to] = 1;
  }

  // DFS from u. Returns how many vertices it reaches,
  // counting u itself.
  static int countReach(int u) {
    // YOUR CODE:
    // 1. Mark u as visited.
    // 2. Start a count at 1 (for u itself).
    // 3. Check every v from 0 to n - 1. If v is a neighbor
    //    of u and v is not visited yet, go deeper with
    //    countReach(v), and add what it returns to the count.
    // 4. Return the count.

    return 0;
  }

  public static void main(String[] args) {
    // the one-way graph from Part 4
    addArrow(0, 1); addArrow(1, 2);   // A->B, B->C
    addArrow(2, 0); addArrow(0, 3);   // C->A, A->D
    addArrow(3, 4); addArrow(5, 3);   // D->E, F->D

    System.out.println(countReach(0));   // expected: 5 (A B C D E)

    visited = new boolean[n];            // clear for the next test
    System.out.println(countReach(5));   // expected: 3 (F D E)

    visited = new boolean[n];
    System.out.println(countReach(4));   // expected: 1 (only E)

    visited = new boolean[n];
    System.out.println(countReach(1));   // expected: 5 (B C A D E)
  }
}`;
const taskAns = String.raw`static int countReach(int u) {
  visited[u] = true;
  int count = 1;                      // u itself
  for (int v = 0; v < n; v++) {       // A to Z order
    if (adj[u][v] == 1 && !visited[v]) {
      count = count + countReach(v);  // go deeper
    }
  }
  return count;
}`;
const reachPeek = svgGraph(oneWay, { label: 'One-way graph: A to B, B to C, C to A, A to D, D to E, F to D' }) + '<p class="small">From A, DFS reaches A, B, C, D, E (5 vertices). From F, it reaches only F, D, E (3 vertices).</p>';

const quiz = [
  { q: 'Which data structure does DFS use to remember where to go back to?', opts: ['Queue', 'Stack', 'Hash table', 'Sorted array'], a: 1, why: 'DFS uses a <b>stack</b> (last in, first out). The top of the stack is where you are; popping takes you back to the vertex you came from. In recursive code, Java\'s call stack does this for you.' },
  { q: 'In DFS, when the vertex on top of the stack has no unvisited neighbors, you:', opts: ['Stop the whole search', 'Pop it and go back to the vertex below it (backtrack)', 'Push it again', 'Start over from the first vertex'], a: 1, why: 'A dead end means <b>backtrack</b>: pop the top vertex. The new top is the vertex you came from, and you check it for other unvisited neighbors.' },
  { q: 'Main example, starting at A (alphabetical order). What is the DFS order?', opts: ['A, B, D, C, E, F, G', 'A, B, C, F, E, D, G', 'A, D, E, G, F, C, B', 'A, B, C, D, E, F, G'], a: 1, why: `A → B → C → F → E → D. D is a dead end (A and E visited), so go back to E, then E → G. Order: <b>${dfsCity.order.join(', ')}</b>. The first choice is BFS's answer.` },
  { q: 'In the directed example, which vertices are <b>not</b> visited by DFS starting at F?', opts: ['None', `${fromF.missed.join(', ')}`, 'D and E', 'Only F'], a: 1, why: `From F the only arrow goes to D, and D only goes to E. A, B, and C cannot be reached by following arrows from F. DFS order from F: <b>${fromF.order.join(', ')}</b>.` },
  { q: 'DFS reaches vertex G. What do the vertices on the stack (bottom to top) form?', opts: ['The BFS order', 'A path from the start to G', 'All the vertices in the graph', 'The shortest path, always'], a: 1, why: 'The stack holds exactly the vertices you walked through to reach G, so it is a path from the start to G. But it is not always the <b>shortest</b> path; BFS guarantees that, DFS does not.' },
  { q: 'You need the route with the <b>fewest hops</b> between two computers in a network. Which is the better choice?', opts: ['DFS', 'BFS', 'Either one always gives the same path', 'Neither can find routes'], a: 1, why: 'BFS explores level by level, so the first time it reaches a vertex is through the fewest edges. DFS may wander far away before finding it.' },
];
---
<Base title="Depth-First Search · ITC 120" description="Depth-first search (DFS) in plain English: going deep with a stack, backtracking, reachability, finding paths, and how it compares with BFS." course={{ code: course.code, href: base + course.href }} toc>
  <header class="wrap lesson-hero flow">
    <p class="crumbs"><a href={base + course.href}>ITC 120</a> › Midterm › Graphs</p>
    <p class="kicker">Graphs · Lesson 3 of 3</p>
    <h1>Depth-First Search (DFS)</h1>
    <KindChips />
    <p class="lede">Go as far as you can down one path. At a dead end, back up and try the next way.</p>
    <div class="goals">
      <p class="note-label">By the end, you can:</p>
      <ol>
        <li>run DFS by hand with a <b>stack</b> (neighbors in alphabetical order), showing each push and each <b>backtrack</b> (pop), and write the DFS order;</li>
        <li>explain why a recursive DFS needs no stack of its own (each call is a push, each return is a pop);</li>
        <li>use DFS to list what a vertex can <b>reach</b>, and read a <b>path</b> to a vertex off the stack;</li>
        <li>say why that path may not be the shortest, and choose BFS or DFS for a task;</li>
        <li>match each line of a Java DFS to the steps of the procedure.</li>
      </ol>
    </div>
    <p class="muted small"><b>You need:</b> the <a href={base + '/itc120/bfs/'}>BFS lesson</a>, the <a href={base + '/itc120/stacks/'}>Stacks lesson</a>, the <a href={base + '/itc120/recursion/'}>recursion lesson</a>, and scratch paper.</p>
  </header>

  <!-- 1 -->
  <section class="chapter wrap" id="idea">
    <div class="chapter-head">
      <p class="chapter-num">Part 1 · The idea</p>
      <h2>Deep first, then back up</h2>
    </div>
    <div class="flow">
      <div class="def">
        <p class="note-label">Depth-first search (DFS)</p>
        <p><b>Depth-first search (DFS)</b> is a <b>graph traversal algorithm</b> that visits every vertex reachable from a starting vertex. It starts at one vertex and keeps moving to an unvisited neighbor, going as <b>deep</b> as possible. When it reaches a vertex with no unvisited neighbors (a dead end), it <b>backtracks</b>: it goes back to the previous vertex and tries another neighbor. It uses a <b>stack</b>.</p>
      </div>
      <figure class="fig illus-fig"><Fragment set:html={dfsDive()} /><figcaption>DFS from A on the main example (<Peek label="the same graph as the lab in Part 3" title="Part 3 lab: main example" html={labPeek} />). It goes A → B → C → F → E → D. D has no unvisited neighbors (a dead end), so DFS backs up to E and goes deeper to G. G is a dead end too, so it backs up to E again. Now E, F, C, B, and A have no unvisited neighbors left, so DFS backs up through each of them to A, and the stack is empty.</figcaption></figure>
      <div class="sticky">
        <p class="note-label">Think of opening folders</p>
        <p>You are looking for a file on a computer. You open the first folder, then the first folder inside it, then the first folder inside <i>that</i>... until a folder has no more folders inside. Then you click <b>Back</b> once and open the next folder there. The Back button is the stack: it remembers the way you came.</p>
      </div>
      <figure class="fig illus-fig illus"><Fragment set:html={folderSvg} /><figcaption>Open folders deep first: Documents, ITC120, Week 9. Week 9 is empty, so click <b>Back</b>: you return to ITC120, the folder you came from, and open Week 10. Two more Backs bring you to Documents, which still has Photos. Photos is empty too, so one last Back, and you have seen every folder.</figcaption></figure>
      <p>Compare with BFS: BFS spreads out in waves (wide first). DFS dives down one path (deep first). Same graph, same start, different order:</p>
      <table class="tbl">
        <tbody>
          <tr><th>BFS from A</th><td class="mono">{bfsCity.order.join(', ')}</td></tr>
          <tr><th>DFS from A</th><td class="mono">{dfsCity.order.join(', ')}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 2 -->
  <section class="chapter wrap" id="stack">
    <div class="chapter-head">
      <p class="chapter-num">Part 2 · The tool</p>
      <h2>Why a stack?</h2>
    </div>
    <div class="flow">
      <p>Recall the stack: you <b>push</b> onto the top and <b>pop</b> from the top. Last in, first out, like a stack of plates.</p>
      <p>In DFS, the stack holds the <b>path you are currently on</b>. The top is where you are now. Pushing = taking one step deeper. Popping = taking one step back. Because the most recent vertex comes off first, you always back up to <span class="hl">the place you just came from</span>.</p>
      <figure class="fig illus-fig"><Fragment set:html={stackSvg} /><figcaption>One moment of DFS from A: it has just reached D. <b>Before:</b> the stack, bottom to top, is A, B, C, F, E, D, exactly the path it walked. D is a dead end, so pop it. <b>After the pop:</b> the new top is E, the vertex DFS came from, so that is where it goes back to.</figcaption></figure>
      <div class="sub">
        <h3>The DFS procedure</h3>
        <p>Every DFS follows these steps:</p>
        <ol class="procedure">
          <li><b>Visit</b> the start vertex and <b>push</b> it onto the stack.</li>
          <li>While the stack is not empty, look at the vertex on <b>top</b>:
            <ol type="a">
              <li>If it has an unvisited neighbor, take the first one in alphabetical order (or smallest number first, if the vertices are numbers). <b>Visit</b> it and <b>push</b> it. (Go deeper.)</li>
              <li>If all its neighbors are visited, <b>pop</b> it. (Backtrack.)</li>
            </ol>
          </li>
          <li>When the stack is empty, DFS is done.</li>
        </ol>
      </div>
      <div class="trap">
        <p class="note-label">Exam traps</p>
        <ol class="flow">
          <li><b>Popping is not the end.</b> After you pop, look at the <b>new top</b>: it may still have an unvisited neighbor. In <Peek label="the stack picture" title="From the start of Part 2" html={stackSvg} />, after popping D the new top is E, and E still has G. So push G. DFS stops only when the stack is <b>empty</b>.</li>
          <li><b>Write a vertex when you push it, not when you pop it.</b> Pushing is the first visit. If you write the vertices as they are popped, you get a different list. Main example from A:
            <div class="mk-ans mk-solo">
              <p class="mk-wrong"><b>✗ Pop order (not the DFS order)</b><span class="mono">D, G, E, F, C, B, A</span></p>
              <p class="mk-right"><b>✓ DFS order (push order)</b><span class="mono">{dfsCity.order.join(', ')}</span></p>
            </div>
          </li>
          <li><b>The neighbor order changes the answer.</b> At A, both B and D are unvisited. Taking B first (alphabetical) gives one order; taking the last neighbor first (Z to A) gives another. <b>Both are correct DFS orders</b>, because DFS itself does not say which neighbor comes first:
            <div class="mk-ans mk-solo">
              <p class="mk-right"><b>✓ Alphabetical</b><span class="mono">{dfsCity.order.join(', ')}</span></p>
              <p class="mk-right"><b>✓ Z to A (also a correct DFS)</b><span class="mono">A, D, E, G, F, C, B</span></p>
            </div>
            Many books, courses, and exams still add a rule, usually alphabetical order, <b>so everyone gets the same answer</b> and answers are easy to check. If the question gives a rule, follow it. If it gives none, any correct order is fine, but alphabetical is the safe habit: it matches most answer keys. For numbered vertices, the usual rule is smallest number first, comparing them as numbers (2 before 10).</li>
        </ol>
      </div>
      <div class="plain">
        <p class="note-label">Good to know: the "push-all" way in some books</p>
        <p>Some books and websites use a different stack routine: pop a vertex; if it is not visited yet, visit it and push <b>all</b> its unvisited neighbors. Its stack is a <b>to-do list</b>, not the path you are on:</p>
        <figure class="fig illus-fig"><Fragment set:html={dfsTwoWays()} /><figcaption>Right after DFS from A visits D. Our stack is the path from A to D. The push-all stack holds D and E, which are already visited (they get skipped when popped), and G twice.</figcaption></figure>
        <p class="after-fig">Does the push-all way visit the vertices in the same order as ours? It depends on <b>which neighbor it pushes last</b>, because a stack gives back the last thing pushed first. Look at the start, A, whose unvisited neighbors are B and D:</p>
        <ul>
          <li><b>Push D, then B</b> (Z to A): B is on top, so B is visited next, just like ours. The whole order comes out the same: <span class="mono">A, B, C, F, E, D, G</span>.</li>
          <li><b>Push B, then D</b> (A to Z): D is on top, so D is visited next. The order changes: <span class="mono">A, D, E, G, F, C, B</span>.</li>
        </ul>
        <p>One warning: some versions tick a vertex as visited when it is <b>pushed</b>, instead of when it is popped. That shortcut can give an order that is not a real DFS. In this course, use the procedure above.</p>
      </div>
    </div>
  </section>

  <!-- 3 -->
  <section class="chapter wrap" id="lab">
    <div class="chapter-head">
      <p class="chapter-num">Part 3 · Watch it</p>
      <h2>DFS, step by step</h2>
    </div>
    <div class="flow">
      <p>Tap <b>Next step</b> and watch the stack grow and shrink. Before each tap, guess: go deeper or backtrack?</p>
      <TraverseLab id="dfs-lab" mode="dfs" cap="DFS lab" hint="Orange = where you are now (top of the stack). Light teal = on the stack. Dark teal = visited and finished. Thick teal edges = the steps DFS took." presets={[
        { label: 'Main example', g: city, start: 'A' },
        { label: 'Directed', g: oneWay, start: 'F' },
        { label: 'Separate pieces', g: islands, start: 'A' },
      ]} />
      <p>The three buttons are three different <b>graphs</b>, not three kinds of DFS. <b>Directed</b> starts at F: follow the arrows and see how few vertices DFS can reach. <b>Separate pieces</b> starts at A: DFS stops after A, B, C, because nothing connects them to the rest.</p>
      <div class="plain">
        <p class="note-label">DFS and recursion</p>
        <p>"Go deeper, and when stuck, go back to where you came from" is exactly how <b>recursion</b> works. Each recursive call is a push; each return is a pop. That is why DFS is usually written as a short recursive method (Part 7), and Java's call stack does the stack work for you.</p>
      </div>
    </div>
  </section>

  <!-- 4 -->
  <section class="chapter wrap" id="uses">
    <div class="chapter-head">
      <p class="chapter-num">Part 4 · What DFS is good for</p>
      <h2>Reaching and path-finding</h2>
    </div>
    <div class="flow">
      <div class="sub">
        <h3>1. What can be reached?</h3>
        <p>Like BFS, DFS visits <b>everything reachable</b> from the start, and nothing else. In a directed graph, this answers "where can I get to from here?"</p>
        <figure class="fig">
          <GraphFig g={oneWay} label="Directed example: A to B to C and back to A; A to D, D to E, F to D" />
          <table class="tbl small">
            <thead><tr><th>Start</th><th>DFS order</th><th>Never visited</th></tr></thead>
            <tbody>
              <tr><td>A</td><td class="mono">{fromA.order.join(', ')}</td><td>{fromA.missed.join(', ') || 'none'}</td></tr>
              <tr><td>F</td><td class="mono">{fromF.order.join(', ')}</td><td>{fromF.missed.join(', ') || 'none'}</td></tr>
            </tbody>
          </table>
          <p class="small">From F you can only go to D, then E. The arrows never lead back to A, B, or C. From A, everything except F is reachable, because no arrow points <i>into</i> F.</p>
        </figure>
      </div>

      <div class="sub">
        <h3>2. Finding a path</h3>
        <p>The stack is the path you are on. So the moment DFS reaches a target, the stack (bottom to top) <b>is a path</b> from the start to the target.</p>
        <div class="two-col">
          <figure class="fig">
            <p class="fig-cap">DFS path A → G</p>
            <GraphFig g={city} edgeMarks={pm(dfsPath)} nodeMarks={pn(dfsPath)} label="Path found by DFS" />
            <p class="small mono">{dfsPath.join(' → ')}</p>
            <p class="small">{dfsPath.length - 1} edges</p>
          </figure>
          <figure class="fig">
            <p class="fig-cap">BFS path A → G</p>
            <GraphFig g={city} edgeMarks={pm(bfsPath)} nodeMarks={pn(bfsPath)} label="Shortest path found by BFS" />
            <p class="small mono">{bfsPath.join(' → ')}</p>
            <p class="small">{bfsPath.length - 1} edges (shortest)</p>
          </figure>
        </div>
        <p>DFS found <i>a</i> path, but a long one. It wandered deep before reaching G. If you need the <b>fewest edges</b>, use BFS.</p>
      </div>

      <div class="remember">
        <p class="note-label">Where you see DFS in IT</p>
        <p>Searching all folders on a drive, solving mazes and puzzles, and checking for <b>cycles</b>. For example, a project tool can check if tasks wait on each other in a circle (task A waits for B, B waits for C, C waits for A), which would mean nothing can ever start.</p>
      </div>
      <figure class="fig illus-fig illus"><Fragment set:html={dfsInIT()} /><figcaption>A maze is a graph: each fork or corner is a vertex, and each hallway is an edge. Like DFS, the cat follows one way to its end (1). At a dead end (2), it backs up to the last fork (3) and tries the next way (4). In a project plan, if DFS reaches a task that is still on its stack, it has gone around a circle: those tasks wait for each other forever. (Searching folders works like <Peek label="the folder picture in Part 1" title="From Part 1" html={folderSvg} />.)</figcaption></figure>
    </div>
  </section>

  <!-- 5 -->
  <section class="chapter wrap" id="compare">
    <div class="chapter-head">
      <p class="chapter-num">Part 5 · Side by side</p>
      <h2>BFS vs. DFS</h2>
    </div>
    <div class="flow">
      <p>Here is the same graph searched both ways from A. The small numbers show the visit order, and the arrows show how each vertex was first reached.</p>
      <figure class="fig illus-fig"><Fragment set:html={bfsVsDfs()} /><figcaption>BFS reaches D third, straight from A, because D is one edge away. DFS reaches D sixth, at the end of a long path. Both visit all seven vertices, just in a different order.</figcaption></figure>
      <p>Both are graph traversal algorithms: they visit every reachable vertex once. They differ in these ways:</p>
      <table class="tbl">
        <thead><tr><th></th><th>BFS</th><th>DFS</th></tr></thead>
        <tbody>
          <tr><td><b>Explores</b></td><td>wide first, level by level</td><td>deep first, then backtracks</td></tr>
          <tr><td><b>Uses a</b></td><td>queue (first in, first out)</td><td>stack (last in, first out), or recursion</td></tr>
          <tr><td><b>Shortest path (fewest edges)?</b></td><td>yes, in unweighted graphs</td><td>no, not guaranteed</td></tr>
          <tr><td><b>Finds what is reachable?</b></td><td>yes</td><td>yes</td></tr>
          <tr><td><b>Good for</b></td><td>fewest hops, levels, "friends of friends"</td><td>exploring every path, mazes, folders, finding cycles</td></tr>
        </tbody>
      </table>
      <div class="remember">
        <p class="note-label">How to remember</p>
        <p><b>B</b>FS = <b>B</b>road (queue, waves). <b>D</b>FS = <b>D</b>eep (stack, backtrack).</p>
      </div>
    </div>
  </section>

  <!-- 6 -->
  <section class="chapter wrap" id="paper">
    <div class="chapter-head">
      <p class="chapter-num">Part 6 · Your turn</p>
      <h2>Try it on paper</h2>

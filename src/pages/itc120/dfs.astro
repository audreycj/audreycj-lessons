---
import Base from '../../layouts/Base.astro';
import TryIt from '../../components/TryIt.astro';
import { hiN } from '../../lib/code.js';
import KindChips from '../../components/KindChips.astro';
import GraphFig from '../../components/GraphFig.astro';
import Quiz from '../../components/Quiz.astro';
import StepShow from '../../components/StepShow.astro';
import Peek from '../../components/Peek.astro';
import { course } from '../../data/itc120.js';
import { city, oneWay } from '../../data/graphs.js';
import * as W from '../../data/graphs-w16.js';
import { dfsSteps, bfsSteps, svgGraph } from '../../lib/graph.js';
import { dfsRow, bfsRow, rowShow, rowSvg, and } from '../../lib/onerow.js';
import { folderDive, bfsVsDfs, dfsTwoWays, dfsInIT } from '../../lib/illus.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hi = (src) => src.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .split('\n').map((l) => l.replace(/(\/\/.*)$/, '<span class="c">$1</span>')).join('\n');
const folderSvg = folderDive();

// Part 1: the stack standing up, and the same stack lying down as a row.
const stackUp = (() => {
  const items = ['A', 'B', 'E'];
  const T = (x, y, t, c, sz = 13, w = 800) => `<text x="${x}" y="${y}" font-family="Nunito, sans-serif" font-weight="${w}" font-size="${sz}" fill="${c}">${t}</text>`;
  let s = '<svg class="row-svg stack-up" viewBox="0 0 360 212" style="max-width:24rem" role="img" aria-label="A stack standing up with A at the bottom, then B, then E on top. Push puts a letter on top and pop takes the top letter off. The same stack written as one row is A, B, E, with E as the top.">';
  s += '<path d="M26 44 V200 H114 V44" fill="none" stroke="var(--ink)" stroke-width="2.2"/>';
  items.forEach((x, i) => {
    const y = 156 - i * 46;
    s += `<g class="rw-cell ${i === 2 ? 'is-now' : 'is-wait'}"><rect x="36" y="${y}" width="68" height="38" rx="6"/><text class="rw-l" x="70" y="${y + 19}">${x}</text></g>`;
  });
  s += '<path d="M52 6 V54" stroke="var(--teal)" stroke-width="3" fill="none"/><path d="M45 46 L52 56 L59 46" fill="none" stroke="var(--teal)" stroke-width="3"/>';
  s += '<path d="M88 56 V8" stroke="var(--orange)" stroke-width="3" fill="none"/><path d="M81 16 L88 6 L95 16" fill="none" stroke="var(--orange)" stroke-width="3"/>';
  s += T(132, 22, 'push puts a letter on top', 'var(--teal-ink)') + T(132, 44, 'pop takes the top letter off', 'var(--orange-ink)');
  s += T(156, 124, 'The same stack as one row', 'var(--ink-soft)', 12.5, 700);
  items.forEach((x, i) => {
    const cx = 190 + i * 46;
    s += `<g class="rw-cell ${i === 2 ? 'is-now' : 'is-wait'}"><rect x="${cx - 19}" y="134" width="38" height="34" rx="6"/><text class="rw-l" x="${cx}" y="151">${x}</text></g>`;
  });
  s += '<text class="rw-top" x="282" y="186">top</text>';
  return s + '</svg>';
})();

// Part 2: walkthrough (deck slides 65-71), same graph as the BFS walkthrough
const walk = dfsRow(W.bfsWalk, 'A');
const walkShow = rowShow(W.bfsWalk, walk, 'dfs');
const bfsWalkOrder = bfsRow(W.bfsWalk, 'A').order;

// Part 5: examples (graphs and answers from the Week 16 deck; the engine re-checks every answer)
const mk = (id, title, g, start, extra = {}) => { const run = dfsRow(g, start); return { id, title, g, start, run, show: rowShow(g, run, 'dfs'), ...extra }; };
const ex = [
  mk('dfs-ex1', 'DFS Example 1', W.dfsEx1, 'A', {
    note: `After D gets its ✓, E still has G, so write G. The check order (${dfsRow(W.dfsEx1, 'A').checkOrder.join(', ')}) is <b>not</b> the answer.`,
  }),
  mk('dfs-ex2', 'DFS Example 2', W.dfsEx2, 'C', {
    missedQ: 'Which vertices are never visited?',
    note: 'The answer starts with C, the start. F and G are a separate component (<a href="#pieces">Part 4</a>), so they are never visited.',
  }),
  mk('dfs-ex3', 'DFS Example 3', W.dfsEx3, 'B', {
    note: 'A long backtrack: after F, check C, then A, one at a time. Write D only when you are back on B.',
  }),
  mk('dfs-ex4', 'DFS Example 4 (directed)', W.dfsEx4, 'A', {
    missedQ: 'Which vertex is never visited?',
    note: 'E → B leads back to a written letter, so DFS does not loop. No arrow comes INTO G, so G is never visited.',
  }),
  mk('dfs-ex5', 'DFS Example 5', W.dfsEx5, 'F', {
    note: 'H was skipped early (B comes before H). After getting stuck at E, step back one letter at a time until C, which still has H.',
  }),
  mk('dfs-ex6', 'DFS Example 6 (directed)', W.dfsEx6, 'C', {
    missedQ: 'Which vertex is never visited?',
    note: 'Watch the two cycles (A, B, D and C, E, G). No arrow comes INTO H, so H is never visited.',
  }),
  mk('dfs-ex7', 'DFS Example 7', W.dfsEx7, 'D', {
    missedQ: 'Which vertices are never visited?',
    note: 'C, F, and G are a separate component. Also, E is written from A, not from D: DFS went deep through B and A first.',
  }),
  mk('dfs-ex8', 'DFS Example 8', W.dfsEx8, 'E', {
    note: 'DFS finishes the whole left side, gets stuck at H, and steps back to B before it writes C.',
  }),
];
const flood = mk('real-ex2', 'Real-life Example 2', W.townFlood, 'F');
const townNames = { H: 'Home', M: 'Market', F: 'Fire station', P: 'Plaza', T: 'Terminal', C: 'Church', S: 'School', L: 'Library' };
const cutNames = flood.run.missed.map((x) => townNames[x]);
const realPeek = `<div class="town-fig">${svgGraph(W.town, { labels: townNames, w: 380, label: 'The sample town from the BFS lesson' })}</div><p class="small">The town before the flood.</p>`;

// Part 3 comparison and Part 6 Java use the 7-vertex graph of DFS Example 1 (same as the old main example).
const dfsCity = dfsSteps(city, 'A');
const bfsCity = bfsSteps(city, 'A');
const code = String.raw`public class DFS {
  static char[] names = {'A', 'B', 'C', 'D', 'E', 'F', 'G'};
  static int n = names.length;
  static int[][] adj = new int[n][n];
  static boolean[] visited = new boolean[n];

  static void addEdge(int a, int b) {   // undirected
    adj[a][b] = 1;
    adj[b][a] = 1;
  }

  static void dfs(int u) {
    visited[u] = true;
    System.out.print(names[u] + " ");   // visit

    for (int v = 0; v < n; v++) {       // A to Z order
      if (adj[u][v] == 1 && !visited[v]) {
        dfs(v);                         // go deeper
      }
    }
    // loop ended: no unvisited neighbors left,
    // so this call returns (= backtrack / pop)
  }

  public static void main(String[] args) {
    addEdge(0, 1); addEdge(0, 3);   // A-B, A-D
    addEdge(1, 2); addEdge(1, 4);   // B-C, B-E
    addEdge(2, 5); addEdge(3, 4);   // C-F, D-E
    addEdge(4, 5); addEdge(4, 6);   // E-F, E-G
    addEdge(5, 6);                  // F-G
    dfs(0);   // prints: A B C F E D G
  }
}`;

const taskCode = String.raw`public class Main {
  static char[] names = {'A', 'B', 'C', 'D', 'E', 'F'};
  static int n = names.length;
  static int[][] adj = new int[n][n];
  static boolean[] visited = new boolean[n];

  static void addArrow(int from, int to) {   // directed
    adj[from][to] = 1;
  }

  // DFS from u. Returns how many vertices it reaches,
  // counting u itself.
  static int countReach(int u) {
    // YOUR CODE:
    // 1. Mark u as visited.
    // 2. Start a count at 1 (for u itself).
    // 3. Check every v from 0 to n - 1. If v is a neighbor
    //    of u and v is not visited yet, go deeper with
    //    countReach(v), and add what it returns to the count.
    // 4. Return the count.

    return 0;
  }

  public static void main(String[] args) {
    // the one-way graph in the picture above
    addArrow(0, 1); addArrow(1, 2);   // A->B, B->C
    addArrow(2, 0); addArrow(0, 3);   // C->A, A->D
    addArrow(3, 4); addArrow(5, 3);   // D->E, F->D

    System.out.println(countReach(0));   // expected: 5 (A B C D E)

    visited = new boolean[n];            // clear for the next test
    System.out.println(countReach(5));   // expected: 3 (F D E)

    visited = new boolean[n];
    System.out.println(countReach(4));   // expected: 1 (only E)

    visited = new boolean[n];
    System.out.println(countReach(1));   // expected: 5 (B C A D E)
  }
}`;
const taskAns = String.raw`static int countReach(int u) {
  visited[u] = true;
  int count = 1;                      // u itself
  for (int v = 0; v < n; v++) {       // A to Z order
    if (adj[u][v] == 1 && !visited[v]) {
      count = count + countReach(v);  // go deeper
    }
  }
  return count;
}`;
const reachPeek = svgGraph(oneWay, { label: 'One-way graph: A to B, B to C, C to A, A to D, D to E, F to D' }) + '<p class="small">From A, DFS reaches A, B, C, D, E (5 vertices). From F, it reaches only F, D, E (3 vertices).</p>';

const quiz = [
  { q: 'Which data structure does DFS use to remember where to go back to?', opts: ['Queue', 'Stack', 'Linked list', 'Sorted array'], a: 1, why: 'DFS uses a <b>stack</b> (last in, first out). The top of the stack is where you are, and stepping back takes you to the vertex you came from. In recursive code, Java\'s call stack does this for you.' },
  { q: 'On paper, which letter are you standing on in DFS?', opts: ['The first letter without a ✓', 'The last letter without a ✓', 'The letter that comes first in the alphabet', 'The last letter in the row, even if it has a ✓'], a: 1, why: 'The letters without a ✓ are the stack, and the top is the <b>last</b> one. (The first letter without a ✓ is the BFS rule.)' },
  { q: 'You are on E. E\'s neighbors B, C, and D: B is written, C and D are not. What do you write?', opts: ['C and D', 'Only C', 'Only D', 'Nothing; check E'], a: 1, why: 'DFS writes only <b>one</b> new neighbor at a time, the first in alphabetical order: C. D waits until you come back to E.' },
  { q: 'You are on D, and every neighbor of D is already written. What do you do?', opts: ['Stop. DFS is done', 'Write a ✓ above D and step back to the last letter without a ✓', 'Write D again', 'Start over from the first letter'], a: 1, why: 'D is a dead end, so you <b>backtrack</b>: check D and step back. The new last letter without a ✓ may still have a new neighbor, so DFS goes on until every letter has a ✓.' },
  { q: 'What is the DFS traversal order?', opts: ['The order the letters got their ✓', 'The order the letters were written, left to right', 'Alphabetical order', 'The reverse of the BFS order'], a: 1, why: 'The answer is the row itself: the order the letters were <b>written</b>. The check order is different, and writing it is a classic mistake.' },
  { q: `DFS Example 1, starting at A (alphabetical order). What is the DFS order?`, opts: ['A, B, D, C, E, F, G', 'A, B, C, F, E, D, G', 'A, D, E, G, F, C, B', 'A, B, C, D, E, F, G'], a: 1, why: `A → B → C → F → E → D. D is a dead end, so step back to E, which still has G. Order: <b>${dfsCity.order.join(', ')}</b>. The first choice is BFS's answer.` },
  { q: 'DFS from C visits only C, A, B, D, and E. F and G are joined to each other but to nothing else. What are F and G?', opts: ['Vertices with a mistake in the graph', 'A separate component of the same graph', 'A different graph', 'Leaves'], a: 1, why: 'One graph can have separate pieces, called <b>components</b>. DFS and BFS only visit the component where they start.' },
  { q: 'You need the route with the <b>fewest hops</b> between two computers in a network. Which is the better choice?', opts: ['DFS', 'BFS', 'Either one always gives the same path', 'Neither can find routes'], a: 1, why: 'BFS explores level by level, so the first time it reaches a vertex is through the fewest edges. DFS may wander far away before finding it.' },
];
---
<Base title="Depth-First Search · ITC 120" description="Depth-first search (DFS): going deep with a stack written as one row, backtracking, directed and disconnected graphs, and how it compares with BFS." course={{ code: course.code, href: base + course.href }} theme="tocall" toc>
  <header class="wrap lesson-hero flow">
    <p class="crumbs"><a href={base + course.href}>ITC 120</a> › Final › Graphs</p>
    <p class="kicker">Graphs · Lesson 3 of 3</p>
    <h1>Depth-First Search (DFS)</h1>
    <KindChips />
    <p class="lede">Go as far as you can down one path. At a dead end, step back and try another way.</p>
    <div class="goals">
      <p class="note-label">By the end, you can:</p>
      <ol>
        <li>do DFS by hand with the <b>one-row method</b>, including every <b>backtrack</b>;</li>
        <li>give the DFS order (the <b>written</b> order) on directed and <b>disconnected</b> graphs, and the vertices never visited;</li>
        <li>compare BFS and DFS;</li>
        <li>match a Java DFS to the method.</li>
      </ol>
    </div>
    <p class="muted small"><b>You need:</b> the <a href={base + '/itc120/bfs/'}>BFS lesson</a>, the <a href={base + '/itc120/stacks/'}>Stacks lesson</a>, the <a href={base + '/itc120/recursion/'}>Recursion lesson</a>, and scratch paper.</p>
  </header>

  <!-- 1 -->
  <section class="chapter wrap" id="idea">
    <div class="chapter-head">
      <p class="chapter-num">Part 1 · The idea</p>
      <h2>Deep first, then back up</h2>
    </div>
    <div class="flow">
      <div class="def">
        <p class="note-label">Depth-first search (DFS)</p>
        <p><b>DFS</b> is a graph traversal that keeps moving to an unvisited neighbor, as deep as it can. At a <b>dead end</b>, it <b>backtracks</b>: it goes back one step and tries another neighbor. DFS uses a <b>stack</b>.</p>
      </div>
      <div class="sticky">
        <p class="note-label">Think of looking for a lost file</p>
        <p>You open Documents, then ITC120, then Week 9. The file is not there, and there is nowhere deeper to go. You click <b>Back</b> to ITC120, open Week 10, and find it. Go deeper while you can; go back only when stuck.</p>
      </div>
      <figure class="fig illus-fig illus"><Fragment set:html={folderSvg} /><figcaption>The Back button remembers the way you came, like a stack.</figcaption></figure>
      <div class="sub">
        <h3>Why a stack?</h3>
        <p>Recall the <b>stack</b>: push onto the top, pop from the top. Last in, first out (<b>LIFO</b>). Like a queue, it is a behavior, built with an array or a linked list.</p>
        <p>In DFS, the stack is the <b>path you are on</b>, and the top is where you are. Going deeper is a push. Going back is a pop, so you always return to <span class="hl">where you just came from</span>.</p>
        <figure class="fig illus-fig"><Fragment set:html={stackUp} /><figcaption>If a row is hard to picture, draw the stack standing up. The row is the same stack lying on its side, top at the right.</figcaption></figure>
      </div>
      <div class="remember">
        <p class="note-label">Where DFS is used</p>
        <ul>
          <li><b>Searching folders</b> inside folders on a drive.</li>
          <li><b>Solving mazes</b> (see the picture below).</li>
          <li><b>Finding cycles</b>, such as tasks that wait on each other in a circle, so none can start.</li>
        </ul>
      </div>
      <figure class="fig illus-fig illus"><Fragment set:html={dfsInIT()} /><figcaption>A maze is a graph. The cat follows one way (1) to a dead end (2), backs up to the last fork (3), and tries the next way (4).</figcaption></figure>
    </div>
  </section>

  <!-- 2 -->
  <section class="chapter wrap" id="stack">
    <div class="chapter-head">
      <p class="chapter-num">Part 2 · The method</p>
      <h2>The stack, written as one row</h2>
    </div>
    <div class="flow">
      <p>DFS uses the same one row, but now it is a <b>stack</b>. You are always on the <b>last</b> (rightmost) letter without a ✓.</p>
      <ol class="procedure">
        <li>Write the start vertex. (Read the problem: it is not always A.)</li>
        <li>Look at the <b>last</b> (rightmost) letter without a ✓. You are on it.</li>
        <li><b>Not stuck</b> (it has a neighbor not written yet)? Write <b>one</b> new neighbor, the first alphabetically, and move to it.</li>
        <li><b>Stuck</b>? Write a ✓ above it and step back. Repeat until every letter has a ✓.</li>
      </ol>
      <p>The finished row is the <b>DFS order</b>.</p>
      <div class="plain">
        <p class="note-label">The whole difference from BFS</p>
        <p>BFS checks the <b>first</b> letter without a ✓ and writes <b>all</b> its new neighbors. DFS stands on the <b>last</b> letter without a ✓ and writes only <b>one</b>.</p>
      </div>
      <StepShow id="dfs-walk" cap="DFS from A, one row" hint="Orange = where you are (the top). Light teal = on the stack. Dark teal = checked. Orange outline = just written." steps={walkShow} />
      <p>DFS order: <b>{walk.order.join(', ')}</b>. BFS on the same graph gives {bfsWalkOrder.join(', ')}: BFS took C right after B, but DFS went deep through E first.</p>
      <div class="trap">
        <p class="note-label">Two traps</p>
        <ol class="flow">
          <li><b>A ✓ is not the end.</b> After checking C, you are back on E, and E still has D. Stop only when every letter has a ✓.</li>
          <li><b>The answer is the written order, not the check order.</b>
            <div class="mk-ans mk-solo">
              <p class="mk-wrong"><b>✗ Check order</b><span class="mono">{walk.checkOrder.join(', ')}</span></p>
              <p class="mk-right"><b>✓ DFS order</b><span class="mono">{walk.order.join(', ')}</span></p>
            </div>
          </li>
        </ol>
      </div>
      <p class="small">DFS and <b>recursion</b> work the same way: each call is a push, and each return is a pop. That is why DFS is usually written recursively (<a href="#java">Part 6</a>).</p>
      <details class="reveal"><summary>Extra: the "push-all" way in some books</summary><div class="flow">
        <p class="xtra-note"><b>Extra topic.</b> In this course, use the one-row method.</p>
        <p>Some books pop a vertex and, if it is not visited yet, visit it and push <b>all</b> its unvisited neighbors. That stack is a <b>to-do list</b>, not your path. The picture uses the DFS Example 1 graph, right after DFS from A visits D:</p>
        <figure class="fig illus-fig"><Fragment set:html={dfsTwoWays()} /><figcaption>Our stack is the path from A to D. The push-all stack holds D and E (already visited, skipped when popped) and G twice.</figcaption></figure>
        <p class="after-fig">The order depends on which neighbor is pushed <b>last</b>, since it comes off first. At A (neighbors B and D):</p>
        <ul>
          <li><b>Push D, then B:</b> same order as ours, <span class="mono">A, B, C, F, E, D, G</span>.</li>
          <li><b>Push B, then D:</b> a different order, <span class="mono">A, D, E, G, F, C, B</span>.</li>
        </ul>
        <p>Some versions mark a vertex visited when it is pushed. That can give an order that is not a real DFS.</p>
      </div></details>
    </div>
  </section>

  <!-- 3 -->
  <section class="chapter wrap" id="compare">
    <div class="chapter-head">
      <p class="chapter-num">Part 3 · Side by side</p>
      <h2>BFS vs. DFS</h2>
    </div>
    <div class="flow">
      <p>Both visit every reachable vertex once, in a different order. Here is the DFS Example 1 graph searched both ways from A.</p>
      <figure class="fig illus-fig"><Fragment set:html={bfsVsDfs()} /><figcaption>D is one edge from A, so BFS reaches it third. DFS reaches it sixth, at the end of a long path.</figcaption></figure>
      <table class="tbl">
        <thead><tr><th></th><th>BFS</th><th>DFS</th></tr></thead>
        <tbody>
          <tr><td><b>Explores</b></td><td>wide first, level by level</td><td>deep first, then backs up</td></tr>
          <tr><td><b>Uses a</b></td><td>queue (FIFO)</td><td>stack (LIFO), or recursion</td></tr>
          <tr><td><b>On paper</b></td><td>first letter without a ✓; write all new neighbors</td><td>last letter without a ✓; write one new neighbor</td></tr>
          <tr><td><b>Fewest edges?</b></td><td>yes (unweighted graph)</td><td>not guaranteed</td></tr>
          <tr><td><b>Good for</b></td><td>levels, fewest hops, friends of friends</td><td>every path, mazes, folders, cycles</td></tr>
        </tbody>
      </table>
      <div class="remember">
        <p class="note-label">How to remember</p>
        <p><b>B</b>FS = <b>B</b>road (queue, waves). <b>D</b>FS = <b>D</b>eep (stack, backtrack).</p>
      </div>
    </div>
  </section>

  <!-- 4 -->
  <section class="chapter wrap" id="pieces">
    <div class="chapter-head">
      <p class="chapter-num">Part 4 · Directed and disconnected graphs</p>
      <h2>Arrows, and separate pieces</h2>
    </div>
    <div class="flow">
      <p>In a <b>directed</b> graph, follow the arrows only, as in BFS. A vertex's neighbors are the vertices its arrows point <b>to</b>.</p>
      <div class="def">
        <p class="note-label">Disconnected graph and component</p>
        <p>A graph is still one graph even if some vertices cannot reach each other. It is called a <b>disconnected graph</b>, and each separate piece is a <b>(connected) component</b>.</p>
      </div>
      <figure class="fig">
        <GraphFig g={W.dfsEx2} nodeMarks={{ F: 'hl', G: 'hl' }} label="One graph with two components: A, B, C, D, E in one, and F, G in the other" />
        <p class="small">One graph, two components: A to E, and F with G (the DFS Example 2 graph).</p>
      </figure>
      <div class="sticky">
        <p class="note-label">Think of roads in the Philippines</p>
        <p>All roads form one network, but no road crosses the sea from Mindanao to Luzon. A car from Davao can reach Mindanao towns, but no town in Luzon.</p>
      </div>
      <p>BFS and DFS only visit the <b>component where they start</b>. So "never visited" means every vertex outside that component. (To visit everything, a program starts again from an unvisited vertex.)</p>
    </div>
  </section>

  <!-- 5 -->
  <section class="chapter wrap" id="examples">
    <div class="chapter-head">
      <p class="chapter-num">Part 5 · Your turn</p>
      <h2>Practice problems</h2>
    </div>
    <div class="flow">
      <div class="remember">
        <p class="note-label">How your answers are checked</p>
        <p>The row with ✓ is scratch work and is not graded. You hand in <b>a.</b> the DFS order and, if asked, <b>b.</b> another answer, such as the vertices never visited.</p>
      </div>
      <p>At each step ask: what is the last letter without a ✓, and does it have a neighbor not written yet? Do each example on paper first.</p>
      {ex.map((e) => (
        <div class="paper flow ex-q" id={e.id} data-toc={e.title.split(':')[0]}>
          <p class="ex-title"><span class="ex-tag">{e.title.split(': ')[0]}</span>{e.title.includes(': ') && <span class="ex-sub">{e.title.split(': ')[1].replace(/^./, (c) => c.toUpperCase())}</span>}</p>
          <p class="ex-task">Perform a DFS traversal with <b>{e.start}</b> as the starting point (neighbors in alphabetical order).</p>
          <GraphFig g={e.g} label={`${e.title} graph`} />
          <ol class="ex-parts">
            <li><b>a.</b> What is the DFS traversal order?</li>
            {e.missedQ && <li><b>b.</b> {e.missedQ}</li>}
          </ol>
          <details class="reveal">
            <summary>Show the solution, step by step</summary>
            <div class="flow">
              <StepShow id={`${e.id}-steps`} cap={`DFS from ${e.start}`} hint="Same colors as in Part 2." steps={e.show} />
              <div class="ex-ans">
                <p class="ex-a-line"><b class="lbl">a.</b> <span class="ans">{e.run.order.join(', ')}</span></p>
                {e.missedQ && <p class="ex-a-line"><b class="lbl">b.</b> <span class="ans">{and(e.run.missed)}</span></p>}
              </div>
              <p set:html={e.note} />
            </div>
          </details>
        </div>
      ))}

      <div class="paper flow ex-q" id={flood.id} data-toc="Real-life Example 2">
        <p class="ex-title"><span class="ex-tag">Real-life Example 2</span><span class="ex-sub">Rescue after a typhoon</span></p>
        <p>The same <Peek label="sample town" title="Real-life Example 1" html={realPeek} /> as in the BFS lesson. Two roads are flooded (✗), so treat them as gone. A rescue truck leaves the Fire station. Which places are cut off?</p>
        <p class="ex-task">Do DFS from the Fire station (<b>F</b>), neighbors in alphabetical order. Ignore the flooded roads.</p>
        <div class="town-fig"><GraphFig g={W.townFlood} labels={townNames} w={380} label="Sample town with two flooded roads: Market to Plaza, and School to Library" /></div>
        <ol class="ex-parts">
          <li><b>a.</b> What is the DFS traversal order?</li>
          <li><b>b.</b> Which places are cut off?</li>
        </ol>
        <details class="reveal">
          <summary>Show the solution, step by step</summary>
          <div class="flow">
            <StepShow id="real-ex2-steps" cap="DFS from F (Fire station)" hint="Same colors as in Part 2. Red ✗ = flooded road." steps={flood.show} />
            <div class="ex-ans">
              <p class="ex-a-line"><b class="lbl">a.</b> <span class="ans">{flood.run.order.join(', ')}</span></p>
              <p class="ex-a-line"><b class="lbl">b.</b> <span class="ans">{and(cutNames)}</span></p>
            </div>
            <p>The floods split the town into two components. The truck can only reach its own. The other needs a boat. (BFS would reach the same places, in a different order.)</p>
            <p class="small">Network tools use this to see what is still connected after a failure, such as a broken cable or a downed power line.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- 6 -->
  <section class="chapter wrap" id="java">
    <div class="chapter-head">
      <p class="chapter-num">Part 6 · In code</p>
      <h2>DFS in Java</h2>
    </div>
    <div class="flow">
      <p>DFS is short when written with recursion. This program builds the graph of <a href="#dfs-ex1">DFS Example 1</a> and runs DFS from A.</p>
      <pre class="code"><code set:html={hi(code)} /></pre>
      <TryIt cls="DFS" />
      <p>Most lines match the BFS program (see its <a href={base + '/itc120/bfs/#java'}>read-aloud table</a>). Here are three lines to read aloud:</p>
      <div class="tbl-wrap"><table class="tbl ra">
        <thead><tr><th>Code</th><th>Read it as</th></tr></thead>
        <tbody>
          <tr><td><code>static boolean[] visited = new boolean[n];</code></td><td>"make n true/false slots named visited, all <code>false</code> at first." It is <code>static</code> (outside the method) so every recursive call of <code>dfs</code> shares the same array.</td></tr>
          <tr><td><code>adj[u][v] == 1 &amp;&amp; !visited[v]</code></td><td>"v is a neighbor of u <b>and</b> v is <b>not</b> visited yet."</td></tr>
          <tr><td class="nowrap"><code>dfs(v);</code></td><td>"go deeper: run dfs on v all the way, then come back and continue this loop."</td></tr>
        </tbody>
      </table></div>
      <div class="plain">
        <p class="note-label">Match the code to the one-row method</p>
        <p><code>visited[u] = true</code> means "u is now written in the row". Calling <code>dfs(v)</code> is step 3, writing one new neighbor and moving to it (a push). When the <code>for</code> loop ends, no neighbor is left that is not written, so the method returns. That is step 4, writing the ✓ and stepping back (a pop). There is no stack variable here, because Java's call stack is the stack.</p>
      </div>
      <div class="paper flow" id="task">
        <p class="note-label">Your coding task: count what DFS can reach</p>
        <p>In <Peek label="this one-way graph" title="A one-way (directed) graph" html={reachPeek} />, DFS from A reaches 5 vertices, but DFS from F reaches only 3. Now write a DFS that counts them.</p>
        <p>Finish <code>countReach</code> in about 8 lines where it says YOUR CODE. It is the <code>dfs</code> method from this part with a count added. Each call counts its own vertex (1), plus everything its deeper calls reach. Like <a href={base + '/itc120/recursion/#task'}>height in the Recursion lesson</a>, a recursive call gives back a number, and you add it. The graph is the one-way graph, built with <code>addArrow</code> (one direction only). <code>main</code> clears <code>visited</code> before each new test. Run it: each printed line must match its expected comment.</p>
        <pre class="code"><code set:html={hiN(taskCode)} /></pre>
        <TryIt />
        <details class="reveal"><summary>Show one possible answer</summary><div class="flow">
          <pre class="code"><code set:html={hiN(taskAns)} /></pre>
          <p>Output, one per line: <code>5</code>, <code>3</code>, <code>1</code>, <code>5</code>.</p>
          <p>Here is the first test, from A. The deepest calls finish first:</p>
          <div class="tbl-wrap"><table class="tbl">
            <thead><tr><th>Call</th><th>Why</th><th>Returns</th></tr></thead>
            <tbody>
              <tr><td class="nowrap"><code>countReach(C)</code></td><td>C's only neighbor, A, is already visited</td><td>1</td></tr>
              <tr><td class="nowrap"><code>countReach(B)</code></td><td>B itself + C</td><td>1 + 1 = 2</td></tr>
              <tr><td class="nowrap"><code>countReach(E)</code></td><td>no arrows go out of E</td><td>1</td></tr>
              <tr><td class="nowrap"><code>countReach(D)</code></td><td>D itself + E</td><td>1 + 1 = 2</td></tr>
              <tr><td class="nowrap"><code>countReach(A)</code></td><td>A itself + B's 2 + D's 2</td><td>1 + 2 + 2 = 5</td></tr>
            </tbody>
          </table></div>
          <p>The last test starts at B and also reaches 5: B → C → A, then A → D → E. The arrow C → A leads back to A. Only F is missed, because no arrow points into F.</p>
          <p>Here are two common mistakes:</p>
          <ul>
            <li>Writing only <code>countReach(v);</code>. The call still runs, but the number it gives back is thrown away. Every call returns 1, so every test prints <code>1</code>.</li>
            <li>Forgetting <code>visited[u] = true</code>. Then DFS goes A → B → C → A → B → … around the cycle forever. Each call waits for the next one, and Java's call stack fills up: the program stops with <code>StackOverflowError</code>.</li>
          </ul>
        </div></details>
      </div>
    </div>
  </section>

  <!-- 7 -->
  <section class="chapter wrap" id="check">
    <div class="chapter-head">
      <p class="chapter-num">Part 7 · Check yourself</p>
      <h2>Self-check</h2>
    </div>
    <div class="flow">
      <p>Not graded. Tap an answer to see if you got it, and read why.</p>
      <Quiz id="quiz-dfs" questions={quiz} />
      <div class="remember">
        <p class="note-label">Key takeaways</p>
        <ol>
          <li>DFS goes as deep as possible, then backtracks at dead ends. It uses a stack (or recursion).</li>
          <li>On paper, write the stack as one row. You are always on the <b>last</b> letter without a ✓.</li>
          <li>Not stuck: write <b>one</b> new neighbor (the first alphabetically) and move to it. Stuck: write a ✓ and step back. Repeat until every letter has a ✓.</li>
          <li>The DFS order is the order the letters were <b>written</b>, not the order they were checked.</li>
          <li>In a directed graph, follow the arrows only. BFS and DFS only visit the component where they start.</li>
          <li>BFS = broad, queue, fewest edges. DFS = deep, stack, follows one path to its end before trying another.</li>
        </ol>
      </div>
      <p><b>Next unit:</b> <a href={base + '/itc120/sets/'}>Sets in Java</a>.</p>
      <div class="refs small muted">
        <p class="note-label">References</p>
        <ol>
          <li>T. H. Cormen, C. E. Leiserson, R. L. Rivest, and C. Stein, <i>Introduction to Algorithms</i>, 4th ed. MIT Press, 2022, Section 20.3 (Depth-first search).</li>
          <li>Programiz, "Depth First Search (DFS) Algorithm." <a href="https://www.programiz.com/dsa/graph-dfs">programiz.com/dsa/graph-dfs</a></li>
          <li>A. Bhargava, <i>Grokking Algorithms</i>. Manning, 2016, Chapter 6 (graphs and BFS, for comparison).</li>
        </ol>
      </div>

---
import Base from '../../layouts/Base.astro';
import TryIt from '../../components/TryIt.astro';
import { hiN } from '../../lib/code.js';
import KindChips from '../../components/KindChips.astro';
import GraphFig from '../../components/GraphFig.astro';
import Quiz from '../../components/Quiz.astro';
import StepShow from '../../components/StepShow.astro';
import Peek from '../../components/Peek.astro';
import { course } from '../../data/itc120.js';
import { city, oneWay } from '../../data/graphs.js';
import * as W from '../../data/graphs-w16.js';
import { dfsSteps, svgGraph } from '../../lib/graph.js';
import { dfsRow, bfsRow, rowShow, rowSvg, stepPic, rowNbrs, and } from '../../lib/onerow.js';
import { knownTraversals, bfsVsDfs, dfsTwoWays } from '../../lib/illus.js';
import { folderSearch, canteenStack, stackToRow, dfsUsesIT, rememberBfsDfs, islandRoads } from '../../lib/dfs-pics.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hi = (src) => src.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .split('\n').map((l) => l.replace(/(\/\/.*)$/, '<span class="c">$1</span>')).join('\n');
const folderSvg = folderSearch();

// Stepper text (chat 66): numbered sub-steps with chips in the colors of the legend, like the BFS steppers.
const V = (v, k) => '<span class="vchip ' + k + '">' + v + '</span>';
const CK = '<span class="ck">✓</span>';
const ol = (xs) => '<ol class="say-steps">' + xs.map((x) => '<li>' + x + '</li>').join('') + '</ol>';
const chips = (xs, cls) => and(xs.map((x) => V(x, cls(x))));
const finalSay = (order) => '<p>Double-check these three things.</p>' + ol(['Every letter in the stack has a check mark ' + CK + ', meaning every vertex has been checked for neighbors.', 'Only <b>one</b> new neighbor was written at a time, the first in alphabetical order.', 'After every check mark, you looked at the new top for a neighbor that is not written yet.']) + '<p>The row is the <b>DFS traversal order</b>: <span class="bfs-ans">' + order.join(', ') + '</span></p>';
const SO = { title: 'The stack' };
// chat 66 round 7 (her request): every move is TWO steps. Step A = "we are on X" (X orange, its neighbor edges looked at,
// nothing written yet). Step B = the action (write the new neighbor and move to it, or check X and step back).
function dfsShow(g, run, endNote = '') {
  const out = [];
  let firstStuck = true, firstDir = true;
  const pic = (st, label) => stepPic(g, st, 'dfs', { ...SO, label });
  const isStuck = (k) => k > 0 && k < run.steps.length && run.steps[k].checked.length > run.steps[k - 1].checked.length;
  let skipTo = -1;
  run.steps.forEach((st, i) => {
    if (i <= skipTo) return;
    // round 8: after the first dead end, two or more dead ends in a row become ONE step (like deck slide 71)
    if (!firstStuck && isStuck(i) && isStuck(i + 1)) {
      let j = i; while (isStuck(j + 1)) j++;
      const names = run.steps.slice(i - 1, j).map((q) => q.now);
      const prevStep = out[out.length - 1];
      prevStep.say = prevStep.say.replace(/<\/ol>$/, '<li>Now look at ' + and(names.map((x) => V(x, 'vc-wait'))) + '. They don\'t have check marks yet, so let\'s double check if all their neighbors have been accounted for. Let\'s go backward one at a time.</li></ol>');
      const items = [];
      for (let k = i; k <= j; k++) {
        const pv = run.steps[k - 1], cur = run.steps[k], x = pv.now, nbx = rowNbrs(g, x);
        const next = cur.now ? ' and step back to ' + V(cur.now, 'vc-now') + '.' : '. Every letter now has a check mark ' + CK + '.';
        const why = g.directed
          ? (nbx.length ? (nbx.length === 1 ? x + '\'s only arrow points to ' + nbx[0] + ', which is' : x + '\'s arrows point to ' + and(nbx) + (nbx.length === 2 ? ', which are both' : ', which are all')) + ' already written' : 'No arrows go out of ' + x)
          : (nbx.length === 1 ? x + '\'s only neighbor, ' + nbx[0] + ', is' : x + '\'s neighbors, ' + and(nbx) + (nbx.length === 2 ? ', are both' : ', are all')) + ' already written';
        items.push([k, [k === i ? 'We go backward one at a time, starting with ' + V(x, 'vc-done') + ', the top of the stack.' : 'Next is ' + V(x, 'vc-done') + '.', why + '.', 'So we <b class="act">put a check mark ' + CK + ' above ' + x + '</b>' + next]]);
      }
      for (const [k, txt] of items) out.push({ pic: pic(run.steps[k], 'DFS step: check ' + run.steps[k - 1].now), say: ol(txt) });
      skipTo = j;
      return;
    }
    if (i === 0) {
      out.push({ pic: pic(st, 'DFS step: write the start'), say: ol(['The problem says we start at ' + V(st.row[0], 'vc-now') + '.', 'We <b class="act">write ' + V(st.row[0], 'vc-new') + '</b> as the first letter of our stack. It is the <b>top</b> of the stack, which is where we are now.', 'The top of the stack is always the <b>last letter without a check mark</b> ' + CK + '.']) });
      return;
    }
    const prev = run.steps[i - 1], u = prev.now;
    const nb = rowNbrs(g, u), old = nb.filter((x) => prev.row.includes(x)), fresh = nb.filter((x) => !prev.row.includes(x));
    const cls = (x) => (prev.checked.includes(x) ? 'vc-done' : 'vc-wait');
    const stuck = st.checked.length > prev.checked.length;
    const back = i > 1 && prev.checked.length > run.steps[i - 2].checked.length;
    const A = [];
    if (back && !stuck) A.push('We are back on ' + V(u, 'vc-now') + '. ' + u + ' may still have a neighbor that is not written yet, so we look at its neighbors again.');
    else if (back) A.push('We are back on ' + V(u, 'vc-now') + '.');
    else A.push('We are on ' + V(u, 'vc-now') + ', the top of the stack.');
    let n = '';
    if (g.directed) {
      if (firstDir) { A.push('In a directed graph, the neighbors are only the vertices that the arrows <b>point to</b>.'); firstDir = false; }
      n = nb.length > 1 ? u + '\'s arrows point to ' + and(nb) + '.' : nb.length ? u + '\'s only arrow points to ' + nb[0] + '.' : 'No arrows go out of ' + u + '.';
    } else n = nb.length === 1 ? 'Its only <b>neighbor</b> is ' + nb[0] + '.' : 'Its <b>neighbors</b> are ' + and(nb) + '.';
    A.push(n);
    if (!stuck) {
      const v = st.fresh[0];
      const pick = 'DFS writes only <b>one</b>, so choose the first in alphabetical order, which is ' + V(v, 'vc-plain') + '.';
      if (old.length) A.push(chips(old, cls) + (old.length === 1 ? ' is' : ' are') + ' already written, <span class="skip">so there is no need to write ' + (old.length === 1 ? 'it' : 'them') + ' again</span>.');
      if (fresh.length > 1 && !old.length) A[A.length - 1] += ' ' + pick;
      else if (fresh.length > 1) A.push(chips(fresh, () => 'vc-plain') + ' are not written yet. ' + pick);
      else A.push(V(v, 'vc-plain') + ' is not written yet.');
    } else {
      if (old.length) A.push((old.length === 1 ? chips(old, cls) + ' is' : old.length === 2 ? 'Both ' + chips(old, cls) + ' are' : chips(old, cls) + ' are all') + ' already written, <span class="skip">so there is nothing new to write</span>.');
      A.push('So ' + V(u, 'vc-now') + ' is a <b>dead end</b>.');
    }
    out.push({ pic: pic({ ...prev, now: u, fresh: [], look: [], nbLook: nb }, 'DFS step: on ' + u), say: ol(A) });
    const B = [];
    if (!stuck) {
      const v = st.fresh[0];
      B.push('We <b class="act">write ' + V(v, 'vc-new') + '</b> at the end of the row and move to it.');
      B.push('Now ' + V(v, 'vc-now') + ' is the top of the stack.');
    } else {
      B.push('We <b class="act">put a check mark ' + CK + ' above ' + V(u, 'vc-done') + '</b>.' + (firstStuck ? ' This step back is called <b>backtracking</b>. It is a pop from the stack.' : ''));
      firstStuck = false;
      B.push(st.now ? 'Then we step back to the last letter without a check mark, which is ' + V(st.now, 'vc-now') + '. That is the vertex we came from.' : 'Every letter now has a check mark ' + CK + '.');
    }
    out.push({ pic: pic(st, 'DFS step: ' + (stuck ? 'check ' + u : 'write ' + st.fresh[0])), say: ol(B) });
  });
  const last = run.steps[run.steps.length - 1];
  out.push({ pic: pic(last, 'DFS finished'), say: finalSay(run.order) + endNote });
  return out;
}
// A finished BFS row (every letter checked), for Peeks.
const doneRow = (order, label) => '<div class="row-fig">' + rowSvg({ row: order, checked: order, level: {}, now: null, fresh: [] }, 'bfs', { label, noRowLevels: true }) + '</div>';

// Part 2: walkthrough (deck slides 65-71), same graph as the BFS walkthrough
const walk = dfsRow(W.bfsWalk, 'A');
const walkShow = dfsShow(W.bfsWalk, walk);
const bfsWalkOrder = bfsRow(W.bfsWalk, 'A').order;
const bfsRowPeek = doneRow(bfsWalkOrder, 'BFS from A, finished: A, B, C, E, D') + '<p class="small">In the BFS lesson, BFS from A on this same graph gave ' + bfsWalkOrder.join(', ') + '.</p>';
const backPeek = '<div class="illus">' + folderSvg + '</div><p class="small">From Part 1. Back returns you to the folder you came from.</p>';
const traversalPeek = '<p>A <b>graph traversal</b> visits every vertex that can be reached from a starting vertex, each one <b>exactly once</b>. BFS and DFS are two algorithms that do it.</p>';
const treePeek = '<div class="illus">' + knownTraversals() + '</div><p class="small">Pre-order, in-order, and post-order go down one branch before coming back, so they are depth-first.</p>';

// Part 4: directed walkthrough, on the directed graph of the BFS lesson
const dirRun = dfsRow(W.bfsDirWalk, 'A');
const dirShow = dfsShow(W.bfsDirWalk, dirRun, '<p>F was never written, because no arrow leads to F.</p>');
const bfsDirOrder = bfsRow(W.bfsDirWalk, 'A').order;
const bfsDirPeek = doneRow(bfsDirOrder, 'BFS from A on the directed graph, finished') + '<p class="small">In the BFS lesson, BFS from A on this directed graph gave ' + bfsDirOrder.join(', ') + '.</p>';
const pieceFig = svgGraph(W.dfsEx2, { nodeMarks: { F: 'hl', G: 'hl' }, label: 'One graph with two components: A, B, C, D, E in one, and F, G in the other' });
const disconnPeek = '<div class="illus">' + islandRoads() + '</div><p class="small">From the Graphs lesson. A disconnected graph has separate pieces called components, like the road networks of Luzon and Mindanao.</p>';
const piecePeek = pieceFig + '<p class="small">From Part 4. One graph with two components. F and G are not joined to A, B, C, D, or E.</p>';

// Part 5: examples (graphs and answers from the Week 16 deck; the engine re-checks every answer)
const mk = (id, title, g, start, extra = {}) => { const run = dfsRow(g, start); return { id, title, g, start, run, show: rowShow(g, run, 'dfs', SO), ...extra }; };
const ex = [
  mk('dfs-ex1', 'DFS Example 1', W.dfsEx1, 'A', {
    note: `After D gets its ✓, E still has G, so write G. The check order (${dfsRow(W.dfsEx1, 'A').checkOrder.join(', ')}) is <b>not</b> the answer.`,
  }),
  mk('dfs-ex2', 'DFS Example 2', W.dfsEx2, 'C', {
    missedQ: 'Which vertices are never visited?',
    peekNote: true,
  }),
  mk('dfs-ex3', 'DFS Example 3', W.dfsEx3, 'B', {
    note: 'This example has a long backtrack. After F, check C, then A, one at a time. Write D only when you are back on B.',
  }),
  mk('dfs-ex4', 'DFS Example 4 (directed)', W.dfsEx4, 'A', {
    missedQ: 'Which vertex is never visited?',
    note: 'E → B leads back to a written letter, so DFS does not loop. No arrow comes INTO G, so G is never visited.',
  }),
  mk('dfs-ex5', 'DFS Example 5', W.dfsEx5, 'F', {
    note: 'H was skipped early (B comes before H). After getting stuck at E, step back one letter at a time until C, which still has H.',
  }),
  mk('dfs-ex6', 'DFS Example 6 (directed)', W.dfsEx6, 'C', {
    missedQ: 'Which vertex is never visited?',
    note: 'Watch the two cycles (A, B, D and C, E, G). No arrow comes INTO H, so H is never visited.',
  }),
  mk('dfs-ex7', 'DFS Example 7', W.dfsEx7, 'D', {
    missedQ: 'Which vertices are never visited?',
    note: 'C, F, and G are a separate component. Also, E is written from A, not from D, because DFS went deep through B and A first.',
  }),
  mk('dfs-ex8', 'DFS Example 8', W.dfsEx8, 'E', {
    note: 'DFS finishes the whole left side, gets stuck at H, and steps back to B before it writes C.',
  }),
];
const flood = mk('real-ex2', 'Real-life Example 2', W.townFlood, 'F');
const townNames = { H: 'Home', M: 'Market', F: 'Fire station', P: 'Plaza', T: 'Terminal', C: 'Church', S: 'School', L: 'Library' };
const cutNames = flood.run.missed.map((x) => townNames[x]);
const realPeek = `<div class="town-fig">${svgGraph(W.town, { labels: townNames, w: 380, label: 'The sample town from the BFS lesson' })}</div><p class="small">The town before the flood.</p>`;

// Part 3 comparison and Part 6 Java use the 7-vertex graph of DFS Example 1 (same as the old main example).
const dfsCity = dfsSteps(city, 'A');
const ex1Peek = svgGraph(city, { label: 'The DFS Example 1 graph' }) + '<p class="small">The DFS Example 1 graph. DFS from A gives ' + dfsCity.order.join(', ') + '.</p>';
const matrixPeek = '<p class="small">From the Graphs lesson, Part 8.</p><table class="tbl ra"><thead><tr><th>Code</th><th>Read it as</th></tr></thead><tbody>'
  + '<tr><td><code>names</code></td><td>"the vertex letters, in order." Index 0 is A, index 1 is B, and so on.</td></tr>'
  + '<tr><td><code>new int[n][n]</code></td><td>"an n by n 2D array of 0s," which is the adjacency matrix.</td></tr>'
  + '<tr><td><code>addEdge(0, 1);</code></td><td>"put 1 in row 0, column 1 and in row 1, column 0," which stores the edge A–B.</td></tr></tbody></table>';
const heightPeek = '<p class="small">From the Recursion lesson, Your coding task.</p><pre class="code"><code>static int height(TreeNode node) {\n  if (node == null) {\n    return -1;\n  }\n  int leftH = height(node.left);\n  int rightH = height(node.right);\n  return 1 + Math.max(leftH, rightH);\n}</code></pre><p class="small">Each recursive call gives back a number, and the caller uses it.</p>';
const code = String.raw`public class DFS {
  static char[] names = {'A', 'B', 'C', 'D', 'E', 'F', 'G'};
  static int n = names.length;
  static int[][] adj = new int[n][n];
  static boolean[] visited = new boolean[n];

  static void addEdge(int a, int b) {   // undirected
    adj[a][b] = 1;
    adj[b][a] = 1;
  }

  static void dfs(int u) {
    visited[u] = true;
    System.out.print(names[u] + " ");   // visit

    for (int v = 0; v < n; v++) {       // A to Z order
      if (adj[u][v] == 1 && !visited[v]) {
        dfs(v);                         // go deeper
      }
    }
    // loop ended: no unvisited neighbors left,
    // so this call returns (= backtrack / pop)
  }

  public static void main(String[] args) {
    addEdge(0, 1); addEdge(0, 3);   // A-B, A-D
    addEdge(1, 2); addEdge(1, 4);   // B-C, B-E
    addEdge(2, 5); addEdge(3, 4);   // C-F, D-E
    addEdge(4, 5); addEdge(4, 6);   // E-F, E-G
    addEdge(5, 6);                  // F-G
    dfs(0);   // prints: A B C F E D G
  }
}`;

const taskCode = String.raw`public class Main {
  static char[] names = {'A', 'B', 'C', 'D', 'E', 'F'};
  static int n = names.length;
  static int[][] adj = new int[n][n];
  static boolean[] visited = new boolean[n];

  static void addArrow(int from, int to) {   // directed
    adj[from][to] = 1;
  }

  // DFS from u. Returns how many vertices it reaches,
  // counting u itself.
  static int countReach(int u) {
    // YOUR CODE:
    // 1. Mark u as visited.
    // 2. Start a count at 1 (for u itself).
    // 3. Check every v from 0 to n - 1. If v is a neighbor
    //    of u and v is not visited yet, go deeper with
    //    countReach(v), and add what it returns to the count.
    // 4. Return the count.

    return 0;
  }

  public static void main(String[] args) {
    // the one-way graph in the picture above
    addArrow(0, 1); addArrow(1, 2);   // A->B, B->C
    addArrow(2, 0); addArrow(0, 3);   // C->A, A->D
    addArrow(3, 4); addArrow(5, 3);   // D->E, F->D

    System.out.println(countReach(0));   // expected: 5 (A B C D E)

    visited = new boolean[n];            // clear for the next test
    System.out.println(countReach(5));   // expected: 3 (F D E)

    visited = new boolean[n];
    System.out.println(countReach(4));   // expected: 1 (only E)

    visited = new boolean[n];
    System.out.println(countReach(1));   // expected: 5 (B C A D E)
  }
}`;
const taskAns = String.raw`static int countReach(int u) {
  visited[u] = true;
  int count = 1;                      // u itself
  for (int v = 0; v < n; v++) {       // A to Z order
    if (adj[u][v] == 1 && !visited[v]) {
      count = count + countReach(v);  // go deeper
    }
  }
  return count;
}`;
const reachPeek = svgGraph(oneWay, { label: 'One-way graph: A to B, B to C, C to A, A to D, D to E, F to D' }) + '<p class="small">From A, DFS reaches A, B, C, D, E (5 vertices). From F, it reaches only F, D, E (3 vertices).</p>';

const quiz = [
  { q: 'Which data structure does DFS use to remember where to go back to?', opts: ['Queue', 'Stack', 'Linked list', 'Sorted array'], a: 1, why: 'DFS uses a <b>stack</b> (last in, first out). The top of the stack is where you are, and stepping back takes you to the vertex you came from. In recursive code, Java\'s call stack does this for you.' },
  { q: 'On paper, which letter are you standing on in DFS?', opts: ['The first letter without a ✓', 'The last letter without a ✓', 'The letter that comes first in the alphabet', 'The last letter in the row, even if it has a ✓'], a: 1, why: 'The letters without a ✓ are the stack, and the top is the <b>last</b> one. (The first letter without a ✓ is the BFS rule.)' },
  { q: 'You are on E. E\'s neighbors are B, C, and D. B is written, but C and D are not. What do you write?', opts: ['C and D', 'Only C', 'Only D', 'Nothing, so check E'], a: 1, why: 'DFS writes only <b>one</b> new neighbor at a time, the first in alphabetical order, which is C. D waits until you come back to E.' },
  { q: 'You are on D, and every neighbor of D is already written. What do you do?', opts: ['Stop, because DFS is done', 'Write a ✓ above D and step back to the last letter without a ✓', 'Write D again', 'Start over from the first letter'], a: 1, why: 'D is a dead end, so you <b>backtrack</b>. Check D and step back. The new last letter without a ✓ may still have a new neighbor, so DFS goes on until every letter has a ✓.' },
  { q: 'What is the DFS traversal order?', opts: ['The order the letters got their ✓', 'The order the letters were written, left to right', 'Alphabetical order', 'The reverse of the BFS order'], a: 1, why: 'The answer is the row itself, which is the order the letters were <b>written</b>. The check order is different, and writing it is a common mistake.' },
  { q: `DFS Example 1, starting at A (alphabetical order). What is the DFS order?`, opts: ['A, B, D, C, E, F, G', 'A, B, C, F, E, D, G', 'A, D, E, G, F, C, B', 'A, B, C, D, E, F, G'], a: 1, why: `A → B → C → F → E → D. D is a dead end, so step back to E, which still has G. The order is <b>${dfsCity.order.join(', ')}</b>. The first choice is the BFS answer.` },
  { q: 'DFS from C visits only C, A, B, D, and E. F and G are joined to each other but to nothing else. What are F and G?', opts: ['Vertices with a mistake in the graph', 'A separate component of the same graph', 'A different graph', 'Leaves'], a: 1, why: 'One graph can have separate pieces, called <b>components</b>. DFS and BFS only visit the component where they start.' },
  { q: 'You need the route with the <b>fewest hops</b> between two computers in a network. Which is the better choice?', opts: ['DFS', 'BFS', 'Either one always gives the same path', 'Neither can find routes'], a: 1, why: 'BFS explores level by level, so the first time it reaches a vertex is through the fewest edges. DFS may go far away before it finds it.' },
];

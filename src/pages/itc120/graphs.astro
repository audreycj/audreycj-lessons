      <div class="paper flow ex-q" id={store4.id} data-toc={store4.title.split(':')[0]}>
        <p class="ex-title"><span class="ex-tag">{store4.title.split(': ')[0]}</span>{store4.title.includes(': ') && <span class="ex-sub">{store4.title.split(': ')[1].replace(/^./, (c) => c.toUpperCase())}</span>}</p>
        <p class="ex-task">Here is the matrix of a directed graph. Draw the graph and write its list. Which vertex has no outgoing edges?</p>
        <Fragment set:html={mxNoCap(matrixHtml(store4.g, cellsOf(store4.g)))} />
        <details class="reveal">
          <summary>Show the solution, step by step</summary>
          <div class="flow">
            <StepShow id="store-ex4-steps" cap={store4.title} hint="Orange = the row being read and the arrows it gives." steps={store4.steps} />

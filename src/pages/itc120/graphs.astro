      <h2>Practice problems</h2>
    </div>
    <div class="flow">
      <p>Answer on paper first, then check it step by step.</p>
      {store.map((x) => (
        <div class="paper flow ex-q" id={x.id} data-toc={x.title.split(':')[0]}>

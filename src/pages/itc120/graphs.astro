const countMx = (g, rowSums) => {
  const I = g.nodes.map((n) => n.id).sort(), M = {};
  for (const e of g.edges) { M[`${e.a}-${e.b}`] = 1; if (!g.directed) M[`${e.b}-${e.a}`] = 1; }
  const col = (c) => I.filter((r) => M[`${r}-${c}`]).length, row = (r) => I.filter((c) => M[`${r}-${c}`]).length;
  const best = Math.max(...I.map(col)), win = I.filter((c) => col(c) === best);
  const rbest = Math.max(...I.map(row)), rwin = rowSums ? I.filter((r) => row(r) === rbest) : [];
  let h = `<div class="scroll-x"><table class="adj cnt-adj"><thead><tr><th></th>${I.map((c) => `<th scope="col"${win.includes(c) ? ' class="cnt-win"' : ''}>${c}</th>`).join('')}${rowSums ? '<td class="cnt-gap" aria-hidden="true"></td><th scope="col" class="cnt-h">out</th>' : ''}</tr></thead><tbody>`;

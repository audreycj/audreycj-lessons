const code1 = String.raw`public class MatrixGraph {
  static char[] names = {'A', 'B', 'C', 'D'};
  static int n = names.length;
  static int[][] adj = new int[n][n];   // all 0 at first

  // undirected edge: set both cells
  static void addEdge(int from, int to) {
    adj[from][to] = 1;
    adj[to][from] = 1;   // remove this line for directed
  }

  public static void main(String[] args) {
    addEdge(0, 1);   // A - B
    addEdge(0, 3);   // A - D
    addEdge(1, 2);   // B - C
    addEdge(1, 3);   // B - D

    // neighbors of B (index 1): scan row 1
    for (int j = 0; j < n; j++) {
      if (adj[1][j] == 1) {
        System.out.print(names[j] + " ");
      }
    }
    // prints: A C D
  }
}`;

const codeRoute = String.raw`public class FastestRoute {
  static char[] names = {'A', 'B', 'C', 'D'};
  static int n = names.length;
  static int[][] mins = new int[n][n];   // travel minutes; 0 = no road
  static final int INF = Integer.MAX_VALUE;   // "not reached yet"

  // two-way road: set both cells
  static void addRoad(int a, int b, int minutes) {
    mins[a][b] = minutes;
    mins[b][a] = minutes;
  }

  public static void main(String[] args) {
    addRoad(0, 1, 7);    // A - B: 7 min
    addRoad(0, 3, 4);    // A - D: 4 min
    addRoad(1, 2, 12);   // B - C: 12 min
    addRoad(1, 3, 5);    // B - D: 5 min

    int start = 0, goal = 2;           // from A to C
    int[] best = new int[n];           // fastest time found so far
    int[] cameFrom = new int[n];       // the place just before it
    boolean[] done = new boolean[n];   // time is final
    for (int i = 0; i < n; i++) {
      best[i] = INF;
      cameFrom[i] = -1;
    }
    best[start] = 0;

    for (int round = 0; round < n; round++) {
      // 1. pick the unfinished place with the smallest time
      int u = -1;
      for (int i = 0; i < n; i++) {
        if (done[i]) continue;
        if (u == -1 || best[i] < best[u]) u = i;
      }
      if (best[u] == INF) break;   // the rest cannot be reached
      done[u] = true;

      // 2. try every road out of u: is going through u faster?
      for (int v = 0; v < n; v++) {
        if (mins[u][v] > 0 && !done[v]) {
          int t = best[u] + mins[u][v];
          if (t < best[v]) {
            best[v] = t;
            cameFrom[v] = u;
          }
        }
      }
    }

    // 3. walk back from the goal to build the route
    String route = "" + names[goal];
    for (int v = cameFrom[goal]; v != -1; v = cameFrom[v]) {
      route = names[v] + " -> " + route;
    }
    System.out.println("Fastest route: " + route);
    System.out.println("Time: " + best[goal] + " minutes");
    // prints: Fastest route: A -> B -> C
    //         Time: 19 minutes
  }
}`;

---
import Base from '../../layouts/Base.astro';
import KindChips from '../../components/KindChips.astro';
import GuessGame from '../../components/GuessGame.astro';
import TreeFig from '../../components/TreeFig.astro';
import GraphFig from '../../components/GraphFig.astro';
import Quiz from '../../components/Quiz.astro';
import Peek from '../../components/Peek.astro';
import TryIt from '../../components/TryIt.astro';
import { taxoPic, expertFour, dataSlips, spiceRack, familiesPic, recipeCard, traitsPic, algoVsProg, progCycle, dsAlgoPic } from '../../lib/illus.js';
import { course, kindInfo, kindLessons } from '../../data/itc120.js';
import { small } from '../../data/graphs.js';
import { hi, hiN } from '../../lib/code.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const addProg = String.raw`import java.util.Scanner;

public class Main {
  public static void main(String[] args) {
    Scanner in = new Scanner(System.in);
    System.out.print("Enter first number: ");   // step 1
    int a = in.nextInt();
    System.out.print("Enter second number: ");
    int b = in.nextInt();
    int sum = a + b;                             // step 2
    System.out.println(sum);                     // step 3
  }
}`;

const defBox = (t, b) => `<div class="def"><p class="note-label">${t}</p><p>${b}</p></div>`;
const arrDef = defBox('Array and index', 'An <b>array</b> is a fixed number of slots, side by side, that all hold the same type of value. Each slot\'s numbered position is its <b>index</b>, counting from 0.');
const methodDef = defBox('Method', 'A named block of code that does one task. Its <b>parameters</b> are the inputs it receives; its <b>return value</b> is the output it gives back.');
const dsPeek = defBox('Data structure', 'A specific way of storing and arranging data in a computer\'s memory so it can be <b>accessed, searched, and updated</b> efficiently.') + `<div class="illus">${dataSlips()}</div>`;
const algoPeek = defBox('Algorithm', 'A finite, well-defined sequence of steps for accomplishing a specific task or solving a problem.') + `<div class="illus">${recipeCard()}</div>`;
const fromRef = '<p class="small muted">From the Programming refresher</p>';

const classify = [
  { q: 'A stack of exam papers waiting to be checked, checked from the top down.', opts: ['Linear: stack', 'Linear: queue', 'Non-linear: tree', 'Non-linear: graph'], a: 0, why: 'The paper on top (the last one added) is checked first: last in, first out. A <b>stack</b>, which is linear.' },
  { q: 'The comment thread on a Facebook post, where replies branch under other replies.', opts: ['Linear: array', 'Linear: linked list', 'Non-linear: tree', 'Non-linear: graph'], a: 2, why: 'Each reply belongs to one comment above it, and replies branch out: a <b>tree</b>, which is non-linear.' },
  { q: 'Students lining up to enter the gym for a school event.', opts: ['Linear: stack', 'Linear: queue', 'Non-linear: tree', 'Non-linear: graph'], a: 1, why: 'The first student in line enters first: first in, first out. A <b>queue</b>.' },
  { q: 'The folder structure on your computer\'s desktop.', opts: ['Linear: array', 'Linear: queue', 'Non-linear: tree', 'Non-linear: graph'], a: 2, why: 'Folders inside folders inside folders: a <b>tree</b>.' },
  { q: 'Your Facebook friends, where anyone can be friends with anyone.', opts: ['Linear: linked list', 'Non-linear: tree', 'Non-linear: graph', 'Linear: array'], a: 2, why: 'There is no single top, and connections can go in any direction: a <b>graph</b>.' },
];
const taskCode = String.raw`public class Main {
  // The algorithm, step by step:
  // 1. If the score is below 0 or above 100, the answer is "Invalid".
  // 2. Otherwise, if the score is 75 or higher, the answer is "Passed".
  // 3. Otherwise, the answer is "Failed".
  static String result(int score) {
    // YOUR CODE: turn steps 1 to 3 into Java.

    return "";
  }

  public static void main(String[] args) {
    System.out.println(result(88));    // expected: Passed
    System.out.println(result(75));    // expected: Passed
    System.out.println(result(74));    // expected: Failed
    System.out.println(result(-5));    // expected: Invalid
    System.out.println(result(101));   // expected: Invalid
  }
}`;
const taskAns = String.raw`static String result(int score) {
  if (score < 0 || score > 100) {
    return "Invalid";
  } else if (score >= 75) {
    return "Passed";
  } else {
    return "Failed";
  }
}`;

const quiz = [
  { q: 'What is a data structure?', opts: ['Raw facts like names and numbers', 'A specific way of storing and arranging data so it can be accessed, searched, and updated efficiently', 'A programming language', 'A list of steps to solve a problem'], a: 1, why: 'Data is the raw facts; a <b>data structure</b> is how we organize them. The last option describes an algorithm.' },
  { q: 'Which of these are all <b>linear</b> data structures?', opts: ['Array, stack, queue, linked list', 'Tree, graph, array', 'Stack, tree, queue', 'Graph, linked list, tree'], a: 0, why: 'Linear structures arrange items one after another. Trees and graphs branch out, so they are non-linear.' },
  { q: 'What is an algorithm?', opts: ['A finite, well-defined sequence of steps for solving a problem', 'Any Java program', 'A kind of data structure', 'A computer\'s memory'], a: 0, why: 'An algorithm is the <b>steps</b>; a program is code that carries them out.' },
  { q: 'An algorithm must stop after a limited number of steps. Which trait is this?', opts: ['Definiteness', 'Finiteness', 'Effectiveness', 'Input'], a: 1, why: '<b>Finiteness</b> = it ends. Definiteness = each step is clear; effectiveness = each step can actually be done.' },
  { q: 'Which one is a <b>program</b>, not just an algorithm?', opts: ['"1. Ask for two numbers. 2. Add them. 3. Show the result."', 'Java code that reads two numbers and prints their sum', 'A recipe card for sinangag', '"Guess the middle, then throw away half."'], a: 1, why: 'The other three are <b>steps</b> (algorithms). Java code that a computer can run is a <b>program</b>.' },
  { q: 'Binary search guesses the middle and throws away half. When does this work?', opts: ['Only when the values are in order (sorted)', 'Always, on any list', 'Only on lists of exactly 100 values', 'Only on linked lists'], a: 0, why: '"Too low" can rule out the whole lower half only because the values are <b>in order</b>. On an unsorted list, the secret could be anywhere.' },
];
---
<Base title="Introduction to DSA · ITC 120" description="Introduction to data structures and algorithms: data vs. data structures, linear vs. non-linear structures, and what makes an algorithm." course={{ code: course.code, href: base + course.href }} toc>
  <header class="wrap lesson-hero flow">
    <p class="crumbs"><a href={base + course.href}>ITC 120</a> › Prelim › Introduction</p>
    <p class="kicker">Introduction · Lesson 2 of 2</p>
    <h1>Introduction to Data Structures and Algorithms</h1>
    <p class="lede">How we store data, and how we tell the computer what to do with it.</p>
    <div class="goals">
      <p class="note-label">By the end, you can:</p>
      <ol>
        <li>define <b>data</b> and <b>data structure</b>, and sort the six main structures of this course into <b>linear</b> and <b>non-linear</b>;</li>
        <li>define an <b>algorithm</b>, name its five traits, and tell an algorithm apart from a program;</li>
        <li>explain, using the guessing game, why the choice of algorithm matters.</li>
      </ol>
    </div>
    <p class="muted small"><b>Java rusty?</b> Do the <a href={base + '/itc120/programming-refresher/'}>Programming refresher</a> first. <b>You need:</b> scratch paper.</p>
  </header>

  <section class="chapter wrap" id="ds">
    <div class="chapter-head">
      <p class="chapter-num">Part 1 · Data structures</p>
      <h2>From raw data to organized data</h2>
    </div>
    <div class="flow">
      <div class="sticky">
        <p class="note-label">You are already a data structures expert</p>
        <p>Your phone's recent apps (the last one opened is the easiest to get back to). The canteen line (first in line, first served). Folders inside folders in your file manager. Your Facebook friends, linked in a web (your friends have friends, and some of them know each other). Each of these is a data structure in disguise: a <b>stack</b>, a <b>queue</b>, a <b>tree</b>, and a <b>graph</b>.</p>
      </div>
      <figure class="fig illus-fig illus"><Fragment set:html={expertFour()} /><figcaption>Four things you use every day, and the data structure each one is.</figcaption></figure>
      <div class="two-col">
        <div class="def"><p class="note-label">Data</p><p>Raw facts and figures, such as numbers, names, and dates. They have no structure yet.</p></div>
        <div class="def"><p class="note-label">Data structure</p><p>A specific way of storing and arranging data in a computer's memory so it can be <b>accessed, searched, and updated</b> efficiently.</p></div>
      </div>
      <figure class="fig illus-fig illus"><Fragment set:html={dataSlips()} /><figcaption>Same facts, two ways. Loose slips are data. The class list is a data structure: it arranges the facts so you can find them.</figcaption></figure>
      <p>Inside a computer, it works the same way. Here are six scores before and after we put them in an <Peek label="array" title="From the Programming refresher" html={arrDef} />:</p>
      <div class="raw-org" role="img" aria-label="Six scores in a messy pile, then the same scores in an array with indexes 0 to 5">
        <div class="ro-side"><p class="ro-t">Data (a pile)</p>
          <div class="ro-pile">{[92, 75, 88, 60, 95, 81].map((v) => <b>{v}</b>)}</div></div>
        <p class="ro-arrow">→</p>
        <div class="ro-side"><p class="ro-t">Data structure (an array)</p>
          <div class="mini-arr sm">{[92, 75, 88, 60, 95, 81].map((v, i) => <span><b>{v}</b><i>{i}</i></span>)}</div></div>
      </div>
      <p class="fig-cap">Same six scores, but now each one has a known position. The structure decides how we can reach and work with the data.</p>
      <div class="remember">
        <p class="note-label">Why it matters: think of your kitchen</p>
        <p>Dump every spice into one big box, and you dig through everything just to find salt. Put them on a labeled spice rack, and you grab what you need in seconds. In programming, the "container" is the data structure. The right one makes your program faster and saves memory.</p>
      </div>
      <figure class="fig illus-fig illus"><Fragment set:html={spiceRack()} /><figcaption>Same spices, two containers. The labeled rack is the better "data structure" for finding salt.</figcaption></figure>

      <div class="sub">
        <h3>Primitive and non-primitive; linear and non-linear</h3>
        <p>Books sort data structures in two steps. First, into two families: <b>primitive</b> (one value each, like an <code>int</code>) and <b>non-primitive</b> (many values). Then the non-primitive family splits into two kinds: <b>linear</b> and <b>non-linear</b>. Here is the whole family tree:</p>
        <figure class="fig illus-fig illus"><Fragment set:html={taxoPic()} /><figcaption>Two families first; then the non-primitive family has two kinds. This course is about the non-primitive side.</figcaption></figure>
        <p class="small muted">Good to know: Java has exactly eight primitive types (all shown above; <code>char</code> holds one character, like <code>'A'</code>), and Java itself calls them <b>primitive types</b>, not data structures. Some books list them as "primitive data structures" because they are the simplest building blocks. Either way, they hold one value each.</p>
        <p>Here is how the two kinds of non-primitive structures compare:</p>
        <table class="tbl">
          <thead><tr><th></th><th>Linear</th><th>Non-linear</th></tr></thead>
          <tbody>
            <tr><td><b>Arrangement</b></td><td>one after another, in a sequence</td><td>branching (hierarchy) or a network</td></tr>
            <tr><td><b>Visiting all items</b></td><td>one natural order (first to last), so one pass visits everything</td><td>no single natural order: you must choose a route, and later lessons teach several (pre-order, BFS, DFS)</td></tr>
            <tr><td><b>Connections</b></td><td>each item links to at most one "next"</td><td>an item can connect to many others</td></tr>
            <tr><td><b>Examples</b></td><td>array, stack, queue, linked list</td><td>tree, graph</td></tr>
          </tbody>
        </table>
        <figure class="fig illus-fig illus"><Fragment set:html={familiesPic()} /><figcaption>Linear: one row, first to last. Non-linear: branches (a tree) or a web (a graph).</figcaption></figure>
      </div>

      <div class="sub">
        <h3>The six main structures of this course</h3>
        <p>Here are the six structures you will learn, each with a real-life picture. Tap a name to open its lesson:</p>
        <div class="ds-grid">
          <div class="ds-card"><p class="ds-k">Linear</p><h4><a href={base + '/itc120/arrays/'}>Array</a></h4>
            <div class="mini-arr sm">{[19, 3, 42, 7].map((v, i) => <span><b>{v}</b><i>{i}</i></span>)}</div>
            <p>Numbered slots, side by side. <b>Like a piso-net shop</b>: a fixed row of numbered units, one user per PC. All slots hold the same type. <b>Strength:</b> instant access by <Peek label="index" title="From the Programming refresher" html={arrDef} />. <b>Trade-off:</b> fixed size, and inserting in the middle means shifting everything after it.</p></div>
          <div class="ds-card"><p class="ds-k">Linear</p><h4><a href={base + '/itc120/stacks/'}>Stack</a></h4>
            <div class="mini-stack"><span>C ← top</span><span>B</span><span>A</span></div>
            <p>Add (<code>push</code>) and remove (<code>pop</code>) at the top only: <b>last in, first out (LIFO)</b>. <b>Like a pile of lunch trays.</b> Used in Undo and the Back button.</p></div>
          <div class="ds-card"><p class="ds-k">Linear</p><h4><a href={base + '/itc120/queues/'}>Queue</a></h4>
            <div class="mini-q"><span>front</span><b>1</b><b>2</b><b>3</b><span>rear</span></div>
            <p>Join at the rear (<code>enqueue</code>), leave from the front (<code>dequeue</code>): <b>first in, first out (FIFO)</b>. <b>Like the canteen line.</b> Used for print jobs.</p></div>
          <div class="ds-card"><p class="ds-k">Linear</p><h4><a href={base + '/itc120/linked-lists/'}>Linked list</a></h4>
            <div class="mini-ll"><b>A</b>→<b>B</b>→<b>C</b>→<i>null</i></div>
            <p>A chain of <b>nodes</b>. A node is one box that stores a value plus a link to the next node; <i>null</i> means "no next." <b>Like a train</b>: each car is connected to the car behind it. <b>Strength:</b> adding or removing only changes the links around that spot. <b>Trade-off:</b> to reach the 50th node, you follow the links through the 49 before it.</p></div>
          <div class="ds-card"><p class="ds-k">Non-linear</p><h4><a href={base + '/itc120/trees/'}>Tree</a></h4>
            <TreeFig spec="A(B(D,E),C)" label="A small tree" />
            <p>One top node (the <b>root</b>), branching into children, then grandchildren. <b>Like folders</b> inside folders, a family tree, or a school org chart.</p></div>
          <div class="ds-card"><p class="ds-k">Non-linear</p><h4><a href={base + '/itc120/graphs/'}>Graph</a></h4>
            <GraphFig g={small} label="A small graph" />
            <p>Nodes (called <b>vertices</b>) joined by lines (called <b>edges</b>). Any node can connect to any other, and there is no single root. <b>Like your friends network</b>, a map app's roads, or web pages linking to each other.</p></div>
        </div>
      </div>

      <div class="sub">
        <h3>Quick check: classify each one</h3>
        <Quiz id="quiz-classify" questions={classify} />
      </div>
    </div>
  </section>

  <section class="chapter wrap" id="algo">
    <div class="chapter-head">
      <p class="chapter-num">Part 2 · Algorithms</p>
      <h2>What is an algorithm?</h2>
    </div>
    <div class="flow">
      <p>A data structure only <i>stores</i> things. We still need instructions to search, sort, add, and remove. That is where algorithms come in.</p>
      <div class="def"><p class="note-label">Algorithm</p><p>An <b>algorithm</b> is a finite, well-defined sequence of steps for accomplishing a specific task or solving a problem.</p></div>
      <div class="sticky">
        <p class="note-label">Think of a recipe</p>
        <p>You gather ingredients (input), follow the steps in order, and each step is exact ("2 tablespoons of oil", not "some oil"). Cooking eventually ends, and you get a finished dish (output).</p>
      </div>
      <figure class="fig illus-fig illus"><Fragment set:html={recipeCard()} /><figcaption>A recipe for sinangag is an algorithm: input, exact steps in order, an end, and an output.</figcaption></figure>
      <p>In programming, "find the largest number in this list" and "sort these student records by grade" are both problems solved by algorithms. Every app on your phone is built from algorithms working on data structures.</p>
      <div class="sub">
        <h3>Five traits every algorithm has</h3>
        <p>An algorithm must have all five of these traits. Miss one, and it is just a vague idea:</p>
        <ol class="traits">
          <li><b>Input:</b> takes zero or more values to work with.</li>
          <li><b>Output:</b> produces at least one result related to the goal.</li>
          <li><b>Definiteness:</b> each step is clear and unambiguous, with no guesswork.</li>
          <li><b>Finiteness:</b> it stops after a limited number of steps.</li>
          <li><b>Effectiveness:</b> each step is simple enough to actually be carried out.</li>
        </ol>
        <p>Picture an algorithm as a machine. This one finds the highest score: it looks at each score, keeps the highest one seen so far, and shows it at the end. Each part of the machine shows one trait:</p>
        <figure class="fig illus-fig illus"><Fragment set:html={traitsPic()} /><figcaption>The find-the-highest-score algorithm as a machine. Every part matches one of the five traits.</figcaption></figure>
        <p>To see the traits at work, here are three sets of "steps" that each break one trait:</p>
        <table class="tbl">
          <thead><tr><th>Steps</th><th>Breaks this trait</th><th>Why</th></tr></thead>
          <tbody>
            <tr><td>"If the score is high, print Passed."</td><td>Definiteness</td><td>How high is "high"? A computer needs an exact rule, like <code>score &gt;= 75</code>.</td></tr>
            <tr><td>"Print every even number: 2, 4, 6, …"</td><td>Finiteness</td><td>There is no last even number, so it never stops.</td></tr>
            <tr><td>"The class list is empty, but find the average anyway: total ÷ 0 students."</td><td>Effectiveness</td><td>Dividing by zero has no answer, so the computer cannot carry out this step (with whole numbers, Java stops with an error).</td></tr>
          </tbody>
        </table>
      </div>
      <div class="sub">
        <h3>Not all algorithms are equal</h3>
        <p>Many algorithms can solve the same problem, and some are much faster. Try it: both players below hunt for the same secret number.</p>
        <GuessGame id="guess" />
        <p><b>Why only 7?</b> Each "too low" or "too high" throws away about half of what is left. In the worst case, the numbers still possible go 100 → 50 → 25 → 12 → 6 → 3 → 1, so by the 7th guess only one number is left. Simple search may need all 100.</p>
        <p class="small muted">Good to know: binary search only works because the numbers 1 to 100 are <b>in order</b>. "Too low" can rule out the whole lower half only when the values are sorted. You will write it in Java in the <a href={base + '/itc120/searching/'}>Searching</a> lesson, and the same halving idea powers <a href={base + '/itc120/bst/'}>BST search</a>.</p>
        <p>Both algorithms solve the same problem, but one is far faster. That is the whole point of this course: <b>data structures + algorithms = programs that run fast and use memory wisely.</b></p>
      </div>
      <div class="sub">
        <h3>Algorithm vs. program, coding vs. programming</h3>
        <p>These four words are easy to mix up. Here is what each one means:</p>
        <table class="tbl">
          <tbody>
            <tr><th>Algorithm</th><td>The <b>steps</b> for solving a problem: 1. ask for two numbers; 2. add them; 3. show the result.</td></tr>
            <tr><th>Program</th><td><b>Code</b> in a programming language that a computer can run to carry out those steps.</td></tr>
            <tr><th>Coding</th><td>Writing the instructions in a programming language.</td></tr>
            <tr><th>Programming</th><td>The whole process: define the problem → plan → write code → test → debug → improve.</td></tr>
          </tbody>
        </table>
        <figure class="fig illus-fig illus"><Fragment set:html={progCycle()} /><figcaption>Programming is the whole loop. Coding is one step of it.</figcaption></figure>
        <p>Here is the algorithm from the table (ask for two numbers, add them, show the result) next to its Java program:</p>
        <figure class="fig illus-fig illus"><Fragment set:html={algoVsProg()} /><figcaption>The numbers on the right show which step each line carries out.</figcaption></figure>
        <p>One algorithm can become many programs. Written in Python or C, the code would look different (a different program), but the three steps would be the same (the same algorithm).</p>
        <details class="reveal"><summary>Optional: see it as a complete Java program</summary><div class="flow">
          <p class="small muted">For the curious only; you do not need to memorize this. <code>Scanner</code> reads what the user types. The first line, <code>import java.util.Scanner;</code>, tells Java where to find <code>Scanner</code>. The class and <code>main</code> around the steps are explained in <a href={base + '/itc120/programming-refresher/#program'}>block 8 of the Programming refresher</a>.</p>
          <pre class="code"><code set:html={hi(addProg)} /></pre>
          <TryIt />
          <p class="small muted">In the online compiler, type the two numbers in the input area when the program asks. With 4 and 5, it prints 9.</p>
        </div></details>
        <div class="paper flow" id="task">
          <p class="note-label">Your coding task: from steps to Java</p>
          <p>Now turn an algorithm into a program yourself. The comments at the top list three steps that decide a student's result. Each step is exact (definiteness): "75 or higher" leaves no doubt. Finish <code>result</code> by writing one Java check for each step, about 7 lines, where it says YOUR CODE. Then run it: the five printed words must match the comments. You need <code>if</code>, <code>else if</code>, <code>||</code>, and <code>return</code>, from blocks 3 and 5 of the <a href={base + '/itc120/programming-refresher/'}>Programming refresher</a>.</p>
          <pre class="code"><code set:html={hiN(taskCode)} /></pre>
          <TryIt />
          <details class="reveal"><summary>Show one possible answer</summary><div class="flow">
            <pre class="code"><code set:html={hiN(taskAns)} /></pre>
            <p>Output: <code>Passed</code>, <code>Passed</code>, <code>Failed</code>, <code>Invalid</code>, <code>Invalid</code>. Step 1 must be checked first: if <code>score &gt;= 75</code> came first, 101 would print Passed. The test with 75 checks the exact edge of the rule: <code>score &gt; 75</code> would wrongly print Failed for it. Trying the edges like this is the "test" step of programming.</p>
          </div></details>
        </div>
      </div>
      <div class="sub" id="ds-or-algo">
        <h3>Data structure, algorithm, or both?</h3>
        <p>This course is called Data Structures <i>and</i> Algorithms, and its lessons teach both. A <b>data structure</b> is a way to store and organize data (<Peek label="see Part 1" title="From Part 1" html={dsPeek} />). An <b>algorithm</b> is a list of steps for doing a task (<Peek label="see above" title="From Part 2" html={algoPeek} />). Many lessons teach both at once, so they show two labels under the title: a data structure, plus the algorithms that work on it (search it, add to it, remove from it). Arrays is one of them.</p>
        <figure class="fig illus-fig illus"><Fragment set:html={dsAlgoPic()} /><figcaption>The four labels you will see under each lesson title, and how one lesson can get two.</figcaption></figure>
        <p>Two more words appear in later lessons:</p>
        <ul>
          <li>An <b>abstract data type (ADT)</b> says <i>what</i> a collection can do (its operations), not <i>how</i> it is stored. Sets and maps are ADTs; a hash table is one data structure that can store them (you will meet sets, maps, and hash tables near the end of the course).</li>
          <li>A <b>technique</b> is a way of building many algorithms, like recursion (a <Peek label="method" title="From the Programming refresher" html={methodDef} /> that calls itself) or hashing (also near the end of the course).</li>
        </ul>
        <p>Every lesson shows these labels under its title. Here is the whole course at a glance:</p>
        <details class="reveal"><summary>Show every lesson and its labels</summary><div class="flow">
        <table class="tbl small">
          <thead><tr><th>Lesson</th><th>Teaches</th></tr></thead>
          <tbody>
            {kindLessons().map((l) => <tr><td><a href={base + l.href}>{l.title}</a></td><td><KindChips href={l.href} small /></td></tr>)}
          </tbody>
        </table>
        </div></details>
      </div>
    </div>
  </section>

  <section class="chapter wrap" id="check">
    <div class="chapter-head">
      <p class="chapter-num">Part 3 · Check yourself</p>
      <h2>Self-check</h2>
    </div>
    <div class="flow">
      <p>Not graded. Tap an answer to see if you got it, and read why.</p>
      <Quiz id="quiz-intro" questions={quiz} />
      <div class="remember">
        <p class="note-label">Key takeaways</p>
        <ol>
          <li>A data structure stores and arranges data so it can be accessed, searched, and updated efficiently.</li>
          <li>Linear: array, stack, queue, linked list. Non-linear: tree, graph.</li>
          <li>An algorithm is a finite, well-defined sequence of steps for solving a problem.</li>
          <li>Every algorithm needs input, output, definiteness, finiteness, and effectiveness.</li>
          <li>The choice of structure and algorithm affects how fast and efficient a program is (binary search: at most 7 guesses for 1 to 100; simple search: up to 100).</li>
        </ol>
      </div>

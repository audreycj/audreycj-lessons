import Base from '../../layouts/Base.astro';
import KindChips from '../../components/KindChips.astro';
import SQLab from '../../components/SQLab.astro';
import Quiz from '../../components/Quiz.astro';
import CodeWalk from '../../components/CodeWalk.astro';
import TryIt from '../../components/TryIt.astro';
import Peek from '../../components/Peek.astro';
import { platesPic, stackWalkCode, stackWalkSteps, stkDefPic, stkRulePic, stkFlowPic, stkLifoPic } from '../../lib/illus.js';
import { course } from '../../data/itc120.js';
import { hi, hiN } from '../../lib/code.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const defSvg = stkDefPic();

const stackFields = String.raw`class ArrayStack {
  int[] data;    // cells that hold the stack items
  int top;       // index of the top item; -1 means empty

  ArrayStack(int capacity) {
    data = new int[capacity];
    top = -1;
  }
  boolean isEmpty() {
    return top == -1;
  }
  boolean isFull() {
    return top == data.length - 1;
  }
  int size() {
    return top + 1;
  }
  // ... push, pop, and peek below
}`;
const fullProgram = String.raw`public class Main {
  public static void main(String[] args) {
    ArrayStack s = new ArrayStack(3);
    s.push(4);
    s.push(9);
    System.out.println(s.pop());     // 9
    System.out.println(s.peek());    // 4
    s.push(2);
    s.push(7);
    System.out.println(s.size());    // 3
    System.out.println(s.isFull());  // true
  }
}

class ArrayStack {
  int[] data;    // cells that hold the stack items
  int top;       // index of the top item; -1 means empty

  ArrayStack(int capacity) {
    data = new int[capacity];
    top = -1;
  }
  boolean isEmpty() {
    return top == -1;
  }
  boolean isFull() {
    return top == data.length - 1;
  }
  int size() {
    return top + 1;
  }
  void push(int value) {
    if (isFull()) {
      throw new IllegalStateException("Stack overflow: full.");
    }
    top++;
    data[top] = value;
  }
  int pop() {
    if (isEmpty()) {
      throw new IllegalStateException("Stack underflow: empty.");
    }
    int value = data[top];
    top--;
    return value;
  }
  int peek() {
    if (isEmpty()) {
      throw new IllegalStateException("Stack underflow: empty.");
    }
    return data[top];
  }
}`;
const linkedStack = String.raw`class LinkedStack {
  Node top;   // the first node is the top; null means empty

  void push(int value) {
    Node newNode = new Node(value);
    newNode.next = top;   // step 1: the new node points to the old top
    top = newNode;        // step 2: top moves to the new node
  }
  int pop() {
    if (top == null) {
      throw new IllegalStateException("Stack underflow: empty.");
    }
    int value = top.data;
    top = top.next;       // delete the first node
    return value;
  }
}`;
const wrongPush = String.raw`data[top] = value;   // stores first...
top++;               // ...then moves`;
const s1 = String.raw`ArrayStack s = new ArrayStack(3);
s.push(4);
s.push(9);
System.out.println(s.pop());
s.push(2);
System.out.println(s.peek());
System.out.println(s.size());
System.out.println(s.isFull());`;
const n1 = String.raw`ArrayStack s = new ArrayStack(4);
s.push(5);
s.push(8);
s.pop();
s.push(3);
s.push(6);
s.peek();
s.pop();
s.pop();`;
const n2 = String.raw`ArrayStack s = new ArrayStack(3);
s.push(11);
s.push(22);
s.push(33);
s.pop();
s.pop();
s.push(44);`;
const n4 = String.raw`ArrayStack s = new ArrayStack(2);
s.push(1);
System.out.println(s.pop());
System.out.println(s.pop());`;

const quiz = [
  { q: 'A stack follows which rule?', opts: ['First in, first out', 'Last in, first out', 'Smallest first', 'Random order'], a: 1, why: 'A <b>stack</b> is LIFO: the item added most recently is removed first, like the top plate of a pile.' },
  { q: 'Push 1, push 2, push 3, then pop. What is returned?', opts: ['1', '2', '3', 'nothing'], a: 2, why: '3 was pushed last, so it is on top. <code>pop()</code> removes and returns <b>3</b>.' },
  { q: 'What is the difference between <code>pop()</code> and <code>peek()</code>?', opts: ['pop removes the top item; peek only looks at it', 'peek removes it; pop only looks', 'They are the same', 'peek returns the bottom item'], a: 0, why: 'Both return the top item, but only <code>pop()</code> moves <code>top</code> down (<code>top--;</code>). <code>peek()</code> leaves the stack unchanged.' },
  { q: 'In <code>ArrayStack</code>, a new stack has <code>top = -1</code>. What does <code>size()</code> return?', opts: ['-1', '0', '1', 'the capacity'], a: 1, why: '<code>size()</code> returns <code>top + 1</code>, which is <b>0</b>. The -1 is only an index meaning "no top item yet."' },
  { q: 'An <code>ArrayStack</code> holds 4, 9 (so <code>top</code> is 1). After <code>pop()</code>, what is in <code>data[1]</code>?', opts: ['0', '9', '4', 'null'], a: 1, why: '<code>pop()</code> only moves <code>top</code> down to 0. The 9 <b>stays in cell 1</b>, but it is above <code>top</code>, so it is not part of the stack. The next <code>push</code> writes over it.' },
  { q: 'A program runs <code>s.pop();</code> on its own line, without printing it. What happens?', opts: ['Nothing, because the value is not used', 'The top item is still removed; its value is just not used', 'Java shows an error', 'The bottom item is removed'], a: 1, why: '<code>pop()</code> always removes the top item. Printing or storing the returned value is up to the program.' },
  { q: 'Why does <code>push</code> run <code>top++;</code> <b>before</b> <code>data[top] = value;</code>?', opts: ['top points at the current top item, so it must move up to a free cell first', 'Java requires ++ to come first', 'To check if the stack is full', 'It does not matter'], a: 0, why: '<code>top</code> is the index of the current top item. Storing first would write over that item (or use index -1 on an empty stack). Moving up first gives the new value its own cell.' },
];

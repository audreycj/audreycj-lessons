<Base title="Breadth-First Search · ITC 120" description="Breadth-first search (BFS): visiting a graph level by level with a queue written as one row, levels, shortest paths, and directed graphs." course={{ code: course.code, href: base + course.href }} theme="tocall subgap" toc>
  <header class="wrap lesson-hero flow">
    <p class="crumbs"><a href={base + course.href}>ITC 120</a> › Final › Graphs</p>

  // level[v] == -1 means "not seen yet" (it works like seen[v] == false).
  static int[] bfsLevels(int start) {
    int[] level = new int[n];
    for (int i = 0; i < n; i++) {
      level[i] = -1;
    }
    Queue<Integer> queue = new LinkedList<>();

    level[start] = 0;                     // the start is level 0
    queue.offer(start);

    while (!queue.isEmpty()) {
      int u = queue.poll();               // dequeue (front)
      // YOUR CODE:
      // Check every v from 0 to n - 1 (A to Z order).
      // If v is a neighbor of u and v is not seen yet (level -1):
      //   v is one level below u, so set its level,
      //   then enqueue v.

    }
    return level;
  }

  // Given: prints the levels, like "A=0 B=1 ...".
  static void printLevels(int[] level) {
    for (int i = 0; i < n; i++) {

const full = String.raw`import java.util.Arrays;

public class Main {
  static void mergeSort(int[] arr, int low, int high) {
    if (low >= high) {
      return;
    }
    int mid = (low + high) / 2;
    mergeSort(arr, low, mid);
    mergeSort(arr, mid + 1, high);
    merge(arr, low, mid, high);
  }

  static void merge(int[] arr, int low, int mid, int high) {
    int[] temp = new int[high - low + 1];
    int i = low;
    int j = mid + 1;
    int k = 0;
    while (i <= mid && j <= high) {
      if (arr[i] <= arr[j]) {
        temp[k] = arr[i];
        i++;
      } else {
        temp[k] = arr[j];
        j++;
      }
      k++;
    }
    while (i <= mid) {
      temp[k] = arr[i];
      i++;
      k++;
    }
    while (j <= high) {
      temp[k] = arr[j];
      j++;
      k++;
    }
    for (k = 0; k < temp.length; k++) {
      arr[low + k] = temp[k];
    }
  }

  static void quickSort(int[] arr, int low, int high) {
    if (low >= high) {
      return;
    }
    int p = partition(arr, low, high);
    quickSort(arr, low, p - 1);
    quickSort(arr, p + 1, high);
  }

  static int partition(int[] arr, int low, int high) {
    int pivot = arr[high];
    int i = low;
    for (int j = low; j < high; j++) {
      if (arr[j] < pivot) {
        int temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
        i++;
      }
    }
    int temp = arr[i];
    arr[i] = arr[high];
    arr[high] = temp;
    return i;
  }

  static void heapSort(int[] arr) {
    int n = arr.length;
    for (int i = n / 2 - 1; i >= 0; i--) {
      siftDown(arr, i, n);
    }
    for (int end = n - 1; end > 0; end--) {
      int temp = arr[0];
      arr[0] = arr[end];
      arr[end] = temp;
      siftDown(arr, 0, end);
    }
  }

  static void siftDown(int[] arr, int i, int size) {
    while (2 * i + 1 < size) {
      int child = 2 * i + 1;
      if (child + 1 < size && arr[child + 1] > arr[child]) {
        child++;
      }
      if (arr[i] >= arr[child]) {
        return;
      }
      int temp = arr[i];
      arr[i] = arr[child];
      arr[child] = temp;
      i = child;
    }
  }

  public static void main(String[] args) {
    int[] a = {29, 10, 14, 37, 13};
    mergeSort(a, 0, a.length - 1);
    System.out.println(Arrays.toString(a));   // [10, 13, 14, 29, 37]

    int[] b = {29, 10, 14, 37, 13};
    quickSort(b, 0, b.length - 1);
    System.out.println(Arrays.toString(b));   // [10, 13, 14, 29, 37]

    int[] c = {29, 10, 14, 37, 13};
    heapSort(c);
    System.out.println(Arrays.toString(c));   // [10, 13, 14, 29, 37]
  }
}`;

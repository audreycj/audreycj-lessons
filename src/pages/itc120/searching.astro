const quiz = [
  { q: 'In this lesson, what do <code>linearSearch</code> and <code>binarySearch</code> give back when the target is <b>not</b> in the array?', opts: ['0', '-1', 'The last index', 'null'], a: 1, why: 'No array has an index of -1, so <b>-1</b> can never be mistaken for a real position. 0 would be wrong: it is the first slot.' },
  { q: 'Linear search on an array of 50 values. The target is not there. How many checks?', opts: ['1', '25', '50', '6'], a: 2, why: 'Linear search has to look at <b>every</b> value before it can say "not found": 50 checks.' },
  { q: 'Which search only works when the values are sorted?', opts: ['Linear search', 'Binary search', 'Both', 'Neither'], a: 1, why: '<b>Binary search</b> throws away half because it knows all smaller values are on the left. On unsorted data, that guess is wrong. Linear search works on any order.' },
  { q: 'In <code>{4, 9, 15, 21, 27, 34, 42, 56, 63, 71, 80, 88}</code>, which index does binary search check first?', opts: ['0', '5', '6', '11'], a: 1, why: '<code>mid = (0 + 11) / 2</code>. With ints, 11 / 2 is 5 (the decimal part is dropped). <code>arr[5]</code> is 34.' },
  { q: 'low is 3 and high is 4. What is mid?', opts: ['3', '3.5', '4', '7'], a: 0, why: '(3 + 4) / 2 = 7 / 2 = <b>3</b> with ints: the .5 is dropped, so mid rounds down.' },
  { q: 'About how many checks does binary search need, at most, for 1,000,000 sorted values?', opts: ['About 20', 'About 1,000', 'About 500,000', '1,000,000'], a: 0, why: 'Each check halves what is left. Halving 1,000,000 about 20 times gets you down to 1, so at most <b>20 checks</b>.' },
  { q: '<code>arr[mid]</code> is <b>smaller</b> than the target. What does binary search do next?', opts: ['high = mid - 1', 'low = mid + 1', 'return -1', 'Check mid again'], a: 1, why: 'The target is bigger, so it can only be to the <b>right</b> of mid: <code>low = mid + 1</code>. Index mid itself is done, so the +1 skips it.' },
  { q: 'Why is binary search a poor fit for a linked list?', opts: ['Linked lists cannot be sorted', 'Reaching the middle node means walking from head, which takes many steps', 'Linked lists have no values', 'Java does not allow it'], a: 1, why: 'Binary search needs to <b>jump</b> to the middle in one step. An array can; a linked list must walk link by link, so the speed advantage is gone.' },
];
// Peeks back to earlier parts/lessons (chat 23)
const unsortedPeek = `${unsortedPic()}<p class="small">The values are not in order, so "20 &lt; 50" does not mean 20 is on the left. The search throws away the half that holds 20.</p>`;

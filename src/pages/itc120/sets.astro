const ops = (A, B) => {
  const s = (xs) => [...new Set(xs)].sort((x, y) => x - y);
  const inter = s(A.filter((x) => B.includes(x)));
  return {
    union: s([...A, ...B]), inter,
    amb: s(A.filter((x) => !B.includes(x))), bma: s(B.filter((x) => !A.includes(x))),
    sym: s([...A, ...B].filter((x) => !inter.includes(x))),
  };
};
const fmt = (xs) => (xs.length ? `{ ${xs.join(', ')} }` : '{ }');
const practice = [
  { A: [2, 4, 6, 8, 10], B: [3, 6, 9, 12], note: '' },
  { A: [15, 25, 35, 45], B: [45, 35, 25, 15], note: 'A and B have the same values (the order does not matter in a set), so they are equal sets. Nothing is left over in either difference, and nothing is in one but not both.' },
  { A: [1, 2, 3], B: [], note: 'B is the empty set. Union with an empty set changes nothing, and intersection with it is always empty.' },
].map((p) => ({ ...p, r: ops(p.A, p.B) }));

const basics = String.raw`import java.util.HashSet;
import java.util.Set;

public class Attendance {
  public static void main(String[] args) {
    Set<String> present = new HashSet<>();

    present.add("Ana");
    present.add("Ben");
    present.add("Carla");
    boolean added = present.add("Ana");   // already there

    System.out.println(added);                   // false
    System.out.println(present.size());          // 3
    System.out.println(present.contains("Ben")); // true
    System.out.println(present.contains("Dan")); // false

    present.remove("Ben");
    System.out.println(present.size());          // 2

    for (String name : present) {    // order not guaranteed
      System.out.println(name);
    }
  }
}`;

const opsCode = String.raw`import java.util.Arrays;
import java.util.HashSet;
import java.util.Set;

public class SetOperations {
  public static void main(String[] args) {
    Set<Integer> a = new HashSet<>(Arrays.asList(1, 2, 3, 4, 5));
    Set<Integer> b = new HashSet<>(Arrays.asList(4, 5, 6, 7));

    Set<Integer> union = new HashSet<>(a);   // copy of A
    union.addAll(b);                         // add all of B
    System.out.println("A u B = " + union);  // [1, 2, 3, 4, 5, 6, 7]

    Set<Integer> inter = new HashSet<>(a);
    inter.retainAll(b);                      // keep only what B has
    System.out.println("A n B = " + inter);  // [4, 5]

    Set<Integer> aMinusB = new HashSet<>(a);
    aMinusB.removeAll(b);                    // take out B's values
    System.out.println("A - B = " + aMinusB); // [1, 2, 3]

    Set<Integer> bMinusA = new HashSet<>(b);
    bMinusA.removeAll(a);
    System.out.println("B - A = " + bMinusA); // [6, 7]

    Set<Integer> sym = new HashSet<>(union); // A u B ...
    sym.removeAll(inter);                    // ... minus A n B
    System.out.println("A sym B = " + sym);  // [1, 2, 3, 6, 7]

    System.out.println("A is still " + a);   // [1, 2, 3, 4, 5]
  }
}`;

const subsetsCode = String.raw`import java.util.Arrays;
import java.util.HashSet;
import java.util.Set;
import java.util.TreeSet;

public class Subsets {
  public static void main(String[] args) {
    Set<String> b = new HashSet<>(Arrays.asList("Ana", "Ben", "Carla", "Dan"));
    Set<String> a = new HashSet<>(Arrays.asList("Ana", "Ben"));
    Set<String> c = new HashSet<>(Arrays.asList("Ana", "Eve"));
    Set<String> empty = new HashSet<>();

    System.out.println(b.containsAll(a));     // true:  A is a subset of B
    System.out.println(b.containsAll(c));     // false: Eve is not in B
    System.out.println(b.containsAll(empty)); // true:  { } is a subset of every set
    System.out.println(a.containsAll(a));     // true:  every set is a subset of itself

    boolean proper = b.containsAll(a) && !a.equals(b);
    System.out.println(proper);               // true:  A is a proper subset of B

    Set<String> d = new TreeSet<>(Arrays.asList("Dan", "Carla", "Ben", "Ana"));
    System.out.println(b.equals(d));          // true:  same values (order and class don't matter)

    System.out.println(b.contains("Ana"));    // true:  one value, so contains
    System.out.println(a.size() + " " + b.size()); // 2 4: containsAll changed nothing
  }
}`;

import java.util.HashSet;
import java.util.Set;

public class Main {
  // Returns A sym B = (A - B) u (B - A).
  // It must NOT change a or b.
  static Set<Integer> symDiff(Set<Integer> a, Set<Integer> b) {
    // YOUR CODE:
    // 1. Copy a, then remove all of b from the copy (A - B).
    // 2. Copy b, then remove all of a from the copy (B - A).
    // 3. Add all of B - A into A - B, and return it.

    return new HashSet<>();
  }

  public static void main(String[] args) {
    // Problem 1 from the paper practice
    Set<Integer> a = new HashSet<>(Arrays.asList(2, 4, 6, 8, 10));
    Set<Integer> b = new HashSet<>(Arrays.asList(3, 6, 9, 12));
    System.out.println(symDiff(a, b)); // expected: [2, 3, 4, 8, 9, 10, 12]
    System.out.println(symDiff(b, a)); // expected: [2, 3, 4, 8, 9, 10, 12]
    System.out.println(a);             // expected: [2, 4, 6, 8, 10] (unchanged)
    System.out.println(b);             // expected: [3, 6, 9, 12] (unchanged)

    // Problem 2: same values, so nothing is left
    Set<Integer> c = new HashSet<>(Arrays.asList(15, 25, 35, 45));
    Set<Integer> d = new HashSet<>(Arrays.asList(45, 35, 25, 15));
    System.out.println(symDiff(c, d)); // expected: []

    // Problem 3: B is the empty set
    Set<Integer> e = new HashSet<>(Arrays.asList(1, 2, 3));
    Set<Integer> empty = new HashSet<>();
    System.out.println(symDiff(e, empty)); // expected: [1, 2, 3]
  }
}`;

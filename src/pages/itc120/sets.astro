  { A: [1, 2, 3], B: [], note: 'B is the empty set. Union with an empty set changes nothing, and intersection with it is always empty.' },
].map((p) => ({ ...p, r: ops(p.A, p.B) }));

const basics = String.raw`import java.util.HashSet;
import java.util.Set;

public class Attendance {
  public static void main(String[] args) {
    Set<String> present = new HashSet<>();

    present.add("Ana");
    present.add("Ben");
    present.add("Carla");
    boolean added = present.add("Ana");   // already there

    System.out.println(added);                   // false
    System.out.println(present.size());          // 3
    System.out.println(present.contains("Ben")); // true

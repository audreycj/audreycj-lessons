const libCode = String.raw`import java.util.Arrays;
import java.util.HashSet;
import java.util.Set;

public class Library {
  public static void main(String[] args) {
    Set<Integer> monday = new HashSet<>(Arrays.asList(1021, 1045, 1021, 1102, 1045, 1021, 1230));
    Set<Integer> tuesday = new HashSet<>(Arrays.asList(1045, 1230, 1301));
    System.out.println(monday.size());   // 4: each ID is kept once

    Set<Integer> both = new HashSet<>(monday);
    both.retainAll(tuesday);             // came both days
    System.out.println(both);            // [1045, 1230]

    Set<Integer> mondayOnly = new HashSet<>(monday);
    mondayOnly.removeAll(tuesday);       // Monday but not Tuesday
    System.out.println(mondayOnly);      // [1021, 1102]
  }
}`;

const quiz = [
  { q: 'Which two properties describe a set?', opts: ['Sorted and indexed', 'No duplicates and no fixed order', 'Key-value pairs', 'First in, first out'], a: 1, why: 'A set holds each value <b>at most once</b> (unique), and its items have <b>no position or index</b> (unordered).' },
  { q: 'You call <code>add(5)</code> on a set that already contains 5. What happens?', opts: ['It throws an error', 'A second 5 is added', 'Nothing changes, and add returns false', 'All values are replaced by 5'], a: 2, why: 'The set ignores the duplicate. <code>add</code> returns <code>false</code> to tell you nothing was added.' },
  { q: 'A = {1, 2, 3}, B = {3, 4}. What is A ∩ B?', opts: ['{ 1, 2, 3, 4 }', '{ 3 }', '{ 1, 2 }', '{ 1, 2, 4 }'], a: 1, why: 'Intersection keeps only what is in <b>both</b>: 3.' },
  { q: 'A = {1, 2, 3}, B = {3, 4}. What is A △ B (symmetric difference)?', opts: ['{ 3 }', '{ 1, 2 }', '{ 1, 2, 4 }', '{ 1, 2, 3, 4 }'], a: 2, why: 'Everything in A or B, except what they share: remove 3 from {1, 2, 3, 4}.' },
  { q: 'If A and B are equal sets, what is A − B?', opts: ['A', 'B', 'The empty set { }', 'A ∪ B'], a: 2, why: 'Every value in A is also in B, so removing B\'s values from A leaves nothing.' },
  { q: 'Which Java method keeps <b>only</b> the elements that are also in another set?', opts: ['addAll', 'retainAll', 'removeAll', 'containsAll'], a: 1, why: '<code>retainAll</code> = "keep only these" = intersection. <code>addAll</code> = union, <code>removeAll</code> = difference. <code>containsAll</code> changes nothing: it only checks whether every value of the other set is already in this one (a subset test).' },
  { q: 'Why do we write <code>new HashSet&lt;&gt;(a)</code> before calling <code>union.addAll(b)</code>?', opts: ['Java requires every set to be copied', 'addAll changes the set it is called on, so we copy A first to keep A unchanged', 'It sorts the set', 'It removes duplicates from B'], a: 1, why: '<code>addAll</code>, <code>retainAll</code>, and <code>removeAll</code> all <b>change</b> the set they are called on. Copy first, or you destroy A and get wrong answers in later operations.' },
  { q: 'Which Java set keeps its elements in <b>sorted</b> order?', opts: ['HashSet', 'LinkedHashSet', 'TreeSet', 'None of them'], a: 2, why: '<code>TreeSet</code> keeps its elements in a red-black tree (through a <code>TreeMap</code> inside), so they come out sorted. <code>HashSet</code> has no guaranteed order; <code>LinkedHashSet</code> keeps the order you added them.' },
  { q: 'A = {1, 2} and B = {1, 2, 3}. Which is true?', opts: ['B ⊆ A', 'A ⊂ B (A is a proper subset of B)', 'A = B', 'The empty set { } is not a subset of A'], a: 1, why: 'Every value of A (1 and 2) is in B, and B also has 3, which A does not. So A ⊆ B and A ≠ B: a <b>proper</b> subset. B ⊆ A is false (3 is missing from A), and { } is a subset of every set.' },
  { q: 'Which Java line checks whether A ⊆ B?', opts: ['a.containsAll(b)', 'b.containsAll(a)', 'a.retainAll(b)', 'a.equals(b)'], a: 1, why: 'A ⊆ B means "B contains all of A", so you ask B: <code>b.containsAll(a)</code>. <code>a.containsAll(b)</code> checks the other direction (B ⊆ A), <code>retainAll</code> changes <code>a</code>, and <code>equals</code> checks A = B.' },
];

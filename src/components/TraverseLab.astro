---
// Step-through BFS or DFS on a small graph, showing the queue/stack and the visit order.
interface Preset { label: string; g: any; start: string; }
interface Props { id: string; mode: 'bfs' | 'dfs'; cap: string; hint: string; presets: Preset[]; pickStart?: boolean; }
const { id, mode, cap, hint, presets, pickStart = true } = Astro.props;
const config = JSON.stringify({ mode, presets });
const dsName = mode === 'bfs' ? 'Queue' : 'Stack';
---
<figure class={`fig trlab trlab-${mode}`} id={id} data-config={config}>
  <p class="fig-cap">{cap}</p>
  <p class="fig-hint">{hint}</p>
  {presets.length > 1 && (
    <div class="btn-row tr-presets" role="group" aria-label="Graphs">
      {presets.map((p, i) => <button type="button" class="btn" data-preset={i} aria-pressed={i === 0 ? 'true' : 'false'}>{p.label}</button>)}
    </div>
  )}
  {pickStart && <div class="tr-start small"><span>Start at:</span> <span class="tr-start-btns"></span></div>}
  <div class="tr-grid">
    <div class="tr-svg"></div>
    <div class="tr-side">
      <div class="tr-ds">
        <p class="tr-label">{dsName} {mode === 'bfs' ? <span class="muted">(first in, first out)</span> : <span class="muted">(last in, first out)</span>}</p>
        <div class="tr-box" aria-live="polite"></div>
      </div>
      <div>
        <p class="tr-label">Visited order</p>
        <ol class="tr-order"></ol>
      </div>
    </div>
  </div>
  <p class="tr-cap" aria-live="polite"></p>
  <div class="btn-row tr-nav">
    <button type="button" class="btn" data-go="back">← Back</button>
    <button type="button" class="btn primary" data-go="next">Next step →</button>
    <button type="button" class="btn" data-go="reset">Start over</button>
  </div>
  <div class="legend">
    <span><i class="l-cur"></i> current</span>
    <span><i class="l-wait"></i> {mode === 'bfs' ? 'seen, waiting in queue' : 'on the stack'}</span>
    <span><i class="l-done"></i> visited</span>
    {mode === 'bfs' && <span><i style="border-color:var(--amber);border-style:dashed"></i> edges being checked</span>}
    <span><i style="border-color:var(--teal);border-width:4px"></i> edges used</span>
    {mode === 'bfs' && <span class="mono">L1, L2… = level (steps from start)</span>}
  </div>
</figure>

<style is:global>
  .trlab .tr-presets { margin-bottom: 0.7rem; }
  .trlab .tr-start { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin-bottom: 0.7rem; font-weight: 700; }
  .trlab .tr-start-btns { display: inline-flex; flex-wrap: wrap; gap: 0.3rem; }
  .trlab .tr-start-btns button { width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 1.5px solid var(--ink); background: var(--paper); font: inherit; font-weight: 800; cursor: pointer; }
  .trlab .tr-start-btns button[aria-pressed="true"] { background: var(--orange); color: #fff; border-color: var(--orange-ink); }
  .trlab .tr-grid { display: grid; gap: 0.8rem; }
  @media (min-width: 44rem) { .trlab .tr-grid { grid-template-columns: 1.4fr 1fr; align-items: center; } }
  .trlab .tr-svg { background: var(--paper); border-radius: 8px; padding: 0.4rem;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); background-size: 20px 20px; }
  .trlab .tr-side { display: grid; gap: 0.8rem; }
  .trlab .tr-label { font-weight: 800; font-size: var(--step--1); margin-bottom: 0.3rem; }
  .trlab .tr-box { min-height: 3rem; display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; padding: 0.4rem; border: 2px solid var(--ink); border-radius: 6px; background: var(--card); }
  .trlab-dfs .tr-box { flex-direction: column-reverse; align-items: stretch; flex-wrap: nowrap; min-height: 4rem; border-top-style: dashed; max-width: 9rem; }
  .trlab .tr-item { display: inline-grid; place-items: center; min-width: 2.4rem; height: 2.2rem; padding: 0 0.4rem; background: var(--teal-wash); border: 1.5px solid var(--teal); border-radius: 4px; font-family: var(--font-mono); font-weight: 700; position: relative; }
  .trlab .tr-item small { font-family: var(--font-body); font-size: 0.65rem; font-weight: 800; color: var(--ink-soft); position: absolute; top: -1.05rem; white-space: nowrap; }
  .trlab-bfs .tr-box { padding-top: 1.3rem; }
  .trlab-dfs .tr-item small { position: static; margin-left: 0.4rem; }
  .trlab-dfs .tr-item { display: flex; justify-content: center; gap: 0.2rem; }
  .trlab .tr-empty { color: var(--ink-soft); font-style: italic; font-size: var(--step--1); padding: 0 0.3rem; }
  .trlab .tr-order { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem; min-height: 2.2rem; }
  .trlab .tr-order li { margin: 0; display: inline-grid; place-items: center; width: 2.2rem; height: 2.2rem; background: var(--teal); color: #fff; border-radius: 50%; font-weight: 800; }
  .trlab .tr-cap { min-height: 5.2em; margin-top: 0.8rem; }
  .trlab .tr-nav .primary { flex: 1 1 auto; }
</style>

<script>
  import { bfsSteps, dfsSteps, svgGraph, stepMarks, ids } from '../lib/graph.js';
  document.querySelectorAll<HTMLElement>('.trlab').forEach((fig) => {
    const cfg = JSON.parse(fig.dataset.config || '{}');
    const mode = cfg.mode;
    const svgBox = fig.querySelector<HTMLElement>('.tr-svg')!;
    const box = fig.querySelector<HTMLElement>('.tr-box')!;
    const ord = fig.querySelector<HTMLElement>('.tr-order')!;
    const cap = fig.querySelector<HTMLElement>('.tr-cap')!;
    const back = fig.querySelector<HTMLButtonElement>('[data-go="back"]')!;
    const next = fig.querySelector<HTMLButtonElement>('[data-go="next"]')!;
    const startBtns = fig.querySelector<HTMLElement>('.tr-start-btns');
    let g: any, steps: any[] = [], at = 0;

    function load(graph: any, start: string) {
      g = graph;
      steps = (mode === 'bfs' ? bfsSteps(g, start) : dfsSteps(g, start)).steps;
      at = 0;
      if (startBtns) {
        startBtns.innerHTML = ids(g).map((n: string) => `<button type="button" data-s="${n}" aria-pressed="${n === start}">${n}</button>`).join('');
      }
      paint();
    }
    function paint() {
      const st = steps[at];
      const o = stepMarks(g, st, mode);
      svgBox.innerHTML = svgGraph(g, { ...o, label: (mode === 'bfs' ? 'BFS' : 'DFS') + ' step ' + (at + 1), w: g.w, h: g.h });
      if (!st.ds.length) box.innerHTML = `<span class="tr-empty">empty</span>`;
      else if (mode === 'bfs') box.innerHTML = st.ds.map((x: string, i: number) => `<span class="tr-item">${x}${i === 0 ? '<small>front</small>' : i === st.ds.length - 1 ? '<small>rear</small>' : ''}</span>`).join('');
      else box.innerHTML = st.ds.map((x: string, i: number) => `<span class="tr-item">${x}${i === st.ds.length - 1 ? '<small>← top</small>' : ''}</span>`).join('');
      ord.innerHTML = st.order.map((x: string) => `<li>${x}</li>`).join('');
      cap.innerHTML = st.caption;
      back.disabled = at === 0;
      next.disabled = at === steps.length - 1;
      next.textContent = at === steps.length - 1 ? 'Finished' : 'Next step →';
    }
    next.addEventListener('click', () => { if (at < steps.length - 1) { at++; paint(); } });
    back.addEventListener('click', () => { if (at > 0) { at--; paint(); } });
    fig.querySelector('[data-go="reset"]')!.addEventListener('click', () => { at = 0; paint(); });
    startBtns?.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest('button'); if (!b) return;
      load(g, b.dataset.s!);
    });
    const pb = fig.querySelectorAll<HTMLButtonElement>('[data-preset]');
    pb.forEach((b) => b.addEventListener('click', () => {
      pb.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const p = cfg.presets[Number(b.dataset.preset)];
      load(p.g, p.start);
    }));
    load(cfg.presets[0].g, cfg.presets[0].start);
  });
</script>

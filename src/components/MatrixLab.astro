---
// Tap matrix cells to add/remove edges; the drawing and the adjacency list update together.
interface Props { id: string; }
const { id } = Astro.props;
---
<figure class="fig mxlab" id={id}>
  <p class="fig-cap">Build a graph: three views, one graph</p>
  <p class="fig-hint">Tap a cell in the matrix to add or remove an edge. Watch the drawing and the adjacency list change too. Try the diagonal (A to A).</p>
  <div class="btn-row mx-mode" role="group" aria-label="Graph type">
    <button type="button" class="btn" data-dir="0" aria-pressed="true">Undirected</button>
    <button type="button" class="btn" data-dir="1" aria-pressed="false">Directed</button>
    <button type="button" class="btn" data-clear>Clear all</button>
  </div>
  <div class="mx-grid">
    <div class="mx-svg"></div>
    <div class="mx-side">
      <div class="scroll-x"><table class="adj mx-table"></table></div>
      <div class="adjlist mx-list" aria-live="polite"></div>
    </div>
  </div>
  <p class="mx-note small" aria-live="polite"></p>
</figure>

<style is:global>
  .mxlab .mx-mode { margin-bottom: 0.8rem; }
  .mxlab .mx-grid { display: grid; gap: 1rem; align-items: start; }
  @media (min-width: 44rem) { .mxlab .mx-grid { grid-template-columns: 1fr 1fr; } }
  .mxlab .mx-side { display: grid; gap: 1rem; }
  .mxlab table.adj td button { all: unset; display: grid; place-items: center; width: 100%; height: 100%; min-height: 2.4rem; cursor: pointer; font-family: var(--font-mono); font-weight: 700; }
  .mxlab table.adj td button:focus-visible { outline: 3px solid var(--amber); outline-offset: -3px; }
  .mxlab table.adj td.flash { animation: mxflash 0.6s; }
  @keyframes mxflash { from { background: var(--orange); } }
  .mxlab .mx-note { min-height: 2.6em; margin-top: 0.6rem; background: var(--paper); border-radius: 6px; padding: 0.5rem 0.7rem; }
</style>

<script>
  import { svgGraph, neighbors, matrix } from '../lib/graph.js';
  document.querySelectorAll<HTMLElement>('.mxlab').forEach((fig) => {
    const N = ['A', 'B', 'C', 'D', 'E'];
    const pos: Record<string, [number, number]> = { A: [170, 40], B: [290, 120], C: [245, 225], D: [95, 225], E: [50, 120] };
    let directed = false;
    let edges: { a: string; b: string }[] = [{ a: 'A', b: 'B' }, { a: 'A', b: 'E' }, { a: 'B', b: 'C' }, { a: 'C', b: 'D' }];
    const g = () => ({ directed, weighted: false, nodes: N.map((id) => ({ id, x: pos[id][0], y: pos[id][1] })), edges });
    const svgBox = fig.querySelector<HTMLElement>('.mx-svg')!;
    const table = fig.querySelector<HTMLTableElement>('.mx-table')!;
    const list = fig.querySelector<HTMLElement>('.mx-list')!;
    const note = fig.querySelector<HTMLElement>('.mx-note')!;

    function find(a: string, b: string) {
      return edges.findIndex((e) => (e.a === a && e.b === b) || (!directed && e.a === b && e.b === a));
    }
    function paint(flash?: [number, number]) {
      const G = g();
      svgBox.innerHTML = svgGraph(G, { label: 'The graph you built', w: 340, h: 270 });
      const M = matrix(G);
      table.innerHTML = `<caption>Adjacency matrix (row = from, column = to)</caption><thead><tr><th></th>${N.map((c) => `<th scope="col">${c}</th>`).join('')}</tr></thead><tbody>` +
        N.map((r, i) => `<tr><th scope="row">${r}</th>${M[i].map((v, j) => `<td class="${v ? 'one' : ''} ${i === j ? 'diag' : ''} ${flash && ((flash[0] === i && flash[1] === j) || (!directed && flash[0] === j && flash[1] === i)) ? 'flash' : ''}"><button type="button" data-i="${i}" data-j="${j}" aria-label="Edge from ${r} to ${N[j]}: ${v}">${v}</button></td>`).join('')}</tr>`).join('') + '</tbody>';
      list.innerHTML = N.map((r) => `<div class="row"><span class="head">${r}</span>${neighbors(G, r).map((n) => `<span class="arr">→</span><span class="cell"><b>${n}</b><i></i></span>`).join('')}<span class="arr">→</span><span class="null">null</span></div>`).join('');
    }
    table.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest('button'); if (!b) return;
      const i = Number(b.dataset.i), j = Number(b.dataset.j), a = N[i], c = N[j];
      const k = find(a, c);
      if (k >= 0) {
        edges.splice(k, 1);
        note.innerHTML = a === c ? `Removed the loop on <b>${a}</b>.` : directed ? `Removed the edge <b>${a} → ${c}</b>. Only row ${a}, column ${c} changed.` : `Removed the edge <b>${a} – ${c}</b>. In an undirected graph, both [${a}][${c}] and [${c}][${a}] change.`;
      } else {
        edges.push({ a, b: c });
        note.innerHTML = a === c ? `Added a <b>loop</b>: an edge from ${a} back to itself. It shows up on the diagonal.` : directed ? `Added the edge <b>${a} → ${c}</b> (from ${a} to ${c}). Only row ${a}, column ${c} became 1, and ${c} appears in ${a}'s list (not the other way around).` : `Added the edge <b>${a} – ${c}</b>. Undirected, so both [${a}][${c}] and [${c}][${a}] became 1, and each one appears in the other's list.`;
      }
      paint([i, j]);
      const nb = table.querySelector<HTMLButtonElement>(`button[data-i="${i}"][data-j="${j}"]`); nb?.focus();
    });
    fig.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => b.addEventListener('click', () => {
      const want = b.dataset.dir === '1';
      if (want === directed) return;
      fig.querySelectorAll('[data-dir]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      if (want) {
        directed = true;
        // an undirected edge = two arrows, one each way
        edges = edges.flatMap((e) => (e.a === e.b ? [e] : [e, { a: e.b, b: e.a }]));
        note.innerHTML = 'Now <b>directed</b>. Each undirected edge became <b>two arrows</b>, one each way, so the matrix did not change. Now tap a cell to add or remove a <b>one-way</b> edge, and the mirror image breaks.';
      } else {
        // make every edge two-way, dropping duplicates
        const seen = new Set<string>();
        edges = edges.filter((e) => { const k = [e.a, e.b].sort().join(); if (seen.has(k)) return false; seen.add(k); return true; });
        directed = false;
        note.innerHTML = 'Now <b>undirected</b>. Every edge goes both ways, so the matrix is a <b>mirror image</b> across the diagonal.';
      }
      paint();
    }));
    fig.querySelector('[data-clear]')!.addEventListener('click', () => { edges = []; note.textContent = 'All edges removed. Five vertices, no edges: every row is all 0s and every list is just null.'; paint(); });
    paint();
  });
</script>
